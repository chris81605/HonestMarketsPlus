:: HonestMarkets Encounter Widgets[widget]
/* 原版 Street Panties 的簡化市場版本：沿用暴露癖門檻與出售衣物巨集。 */
/* 收藏家事件自行決定階段畫面；中央三個 Passage 不得加入事件特例。 */
<<widget "HonestMarketsEncounterUnderwearCollector">>
    <<set _hmCollector to setup.HonestMarkets.getMarketEncounter()>>
    /* 僅根據 resolve() 寫入的事件內部狀態決定呈現內容，不建立額外 Dispatch Widget。 */
    <<if _hmCollector and ["overstep_choice", "overstep_result", "alternative_offer", "alternative_accepted", "one_piece_quote"].includes(_hmCollector.stage)>>
        <<HonestMarketsEncounterUnderwearCollectorOverstep>>
    <<elseif _hmCollector and (_hmCollector.presentationResult or ["extension_offer", "touch_offer", "touch_followup", "intimate_offer"].includes(_hmCollector.stage))>>
        <<HonestMarketsEncounterUnderwearCollectorStage>>
    <<else>>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<honestMarketsEncounterDebug>>
    <<if _hmEncounter and _hmEncounter.id is "underwear_collector">>
        <<set _hmPricePennies to _hmEncounter.price * 100>>
        你穿過市集的人群時，<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>忽然攔住你，壓低聲音詢問能不能收購你身上的貼身衣物。<br><br>
        <<if _hmEncounter.target is "upper">>
            「你的<<print _hmEncounter.upperName>>，我願意出<<printmoney _hmPricePennies>>。」<br><br>
        <<elseif _hmEncounter.target is "lower">>
            「你的<<print _hmEncounter.lowerName>>，我願意出<<printmoney _hmPricePennies>>。」<br><br>
        <<else>>
            「你的<<print _hmEncounter.upperName>>和<<print _hmEncounter.lowerName>>，我願意一共出<<printmoney _hmPricePennies>>。」<br><br>
        <</if>>
        <<if hasSexStat("exhibitionism", 3) and !_hmEncounter.missingTarget and !_hmEncounter.onePieceOffer>>
            <<link "答應把他看中的貼身衣物賣給他" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
            <</link>> <<exhibitionist3>> <span class="gold">金錢+</span><br>
        <</if>>
        <<if _hmEncounter.onePieceOffer>>
            你身上穿著的<<print _hmEncounter.onePiece.upperName>>與<<print _hmEncounter.onePiece.lowerName>>連在一起，無法依照對方原先要求拆開出售。<br><br>
            <<link "告訴他這是連身衣物，問他願不願意整件買下" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("request_one_piece")>>
            <</link>><br>
        <</if>>
        <<if _hmEncounter.missingTarget>>
            <<if _hmEncounter.target is "set">>
                <<if _hmEncounter.alternative is "upper">>
                    他想收購整套內衣褲，但你目前只有<<print _hmEncounter.upperName>>，沒有可出售的內褲。<br><br>
                <<elseif _hmEncounter.alternative is "lower">>
                    他想收購整套內衣褲，但你目前只有<<print _hmEncounter.lowerName>>，沒有可出售的胸罩。<br><br>
                <<else>>
                    他想收購整套內衣褲，但你目前沒有可出售的內衣褲。<br><br>
                <</if>>
            <<elseif _hmEncounter.target is "upper">>
                <<if _hmEncounter.alternative is "lower">>
                    他想買你的胸罩，但你目前只穿著<<print _hmEncounter.lowerName>>。<br><br>
                <<else>>
                    他想買你的胸罩，但你目前沒有可出售的胸罩。<br><br>
                <</if>>
            <<else>>
                <<if _hmEncounter.alternative is "upper">>
                    他想買你的內褲，但你目前只穿著<<print _hmEncounter.upperName>>。<br><br>
                <<else>>
                    他想買你的內褲，但你目前沒有可出售的內褲。<br><br>
                <</if>>
            <</if>>
            <<if _hmEncounter.alternative>>
                <<link "問他願不願意改買你身上現有的衣物" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("propose_alternative")>>
                <</link>><br>
            <</if>>
        <</if>>
        <<if hasSexStat("exhibitionism", 4)>>
            <<link "讓他看個清楚，但不答應出售" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("showcase")>>
            <</link>> <<exhibitionist4>><br>
        <</if>>
        <<if hasSexStat("exhibitionism", 4)>>
            <<link "帶他到僻靜處，讓他先把錢交出來" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("prank")>>
            <</link>> <<exhibitionist4>> <span class="gold">金錢+</span><br>
        <</if>>
        <<link "搖頭拒絕，轉身離開" "HonestMarkets Encounter Result">>
            <<run setup.HonestMarkets.resolveMarketEncounter("decline")>>
        <</link>> <<gstress>><br>
    <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterUnderwearCollectorOverstep">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter and _hmEncounter.id is "underwear_collector">>
        <<if _hmEncounter.stage is "one_piece_quote">>
            你向他解釋，<<print _hmEncounter.onePiece.upperName>>與<<print _hmEncounter.onePiece.lowerName>>是一整件連身內衣，不能拆開來賣。對方重新端詳衣物後，提出整件收購的價格：
            <<set _hmWholePennies to _hmEncounter.onePiecePrice * 100>><<printmoney _hmWholePennies>>。<br><br>
            <<if hasSexStat("exhibitionism", 3)>>
                <<link "接受整件收購" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
                <</link>> <span class="gold">金錢+</span><br>
            <</if>>
            <<link "搖頭拒絕，轉身離開" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("cancel")>>
            <</link>><br>
        <<elseif _hmEncounter.stage is "alternative_offer">>
            <<if _hmEncounter.target is "set">>
                「整套沒辦法賣給你，」你指了指身上的<<if _hmEncounter.alternative is "upper">><<print _hmEncounter.upperName>><<else>><<print _hmEncounter.lowerName>><</if>>，「不過這件可以單獨賣，你願意改收嗎？」<br><br>
            <<elseif _hmEncounter.target is "upper">>
                「胸罩沒有，不過我有<<print _hmEncounter.lowerName>>。你願意改收這件嗎？」<br><br>
            <<else>>
                「內褲沒有，不過我有<<print _hmEncounter.upperName>>。你願意改收這件嗎？」<br><br>
            <</if>>
            <<link "請他重新報價" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("negotiate")>>
            <</link>><br>
            <<link "算了，離開" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("cancel")>>
            <</link>><br>
        <<elseif _hmEncounter.stage is "alternative_accepted">>
            對方接受了替代提議，重新開價<<set _hmAltPennies to _hmEncounter.price * 100>><<printmoney _hmAltPennies>>。<br><br>
            <<link "答應把替代的衣物賣給他" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
            <</link>><br>
            <<link "搖頭拒絕，轉身離開" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("cancel")>>
            <</link>><br>
        <<elseif _hmEncounter.stage is "overstep_choice">>
            <<HonestMarketsEncounterCollectorDeliverySetup>>
            <<HonestMarketsEncounterCollectorPasserby>>
            <span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的目光緊緊跟著你準備整理衣物的動作。你才剛調整好<<if _hmEncounter.offerTarget is "lower">><<bottomsimple>>附近<<else>><<chestsimple>>前方<</if>>的外層衣料，對方就忍不住往前湊了半步。<br><br>
            你抬頭時，正好看見他伸手越過你們之間的距離；周圍傳來此起彼落的叫賣聲，你得立刻決定如何回應。<br><br>
            <<link "側身閃避（舞蹈判定）" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("dodge")>>
            <</link>><br>
            <<link "盯著他，要求立刻退後" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("stop")>>
            <</link>><br>
            <<if hasSexStat("exhibitionism", 5)>>
                <<link "順勢要求加價，作勢讓附近的人聽見" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("extra")>>
                <</link>> <span class="gold">金錢+</span><br>
            <</if>>
            <<link "取消交易" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("cancel")>>
            <</link>><br>
        <<elseif _hmEncounter.stage is "overstep_result">>
            <<if _hmEncounter.overstepOutcome is "dodge_success">>
                你腳下一轉，順勢側身巧妙地讓開。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手停在原地，這才發現自己撲了空。他悻悻然地收回手，神情有些懊惱；你則重新站穩，提醒他還沒到交貨的時候。<br><br>
            <<elseif _hmEncounter.overstepOutcome is "dodge_fail">>
                你急忙往旁邊閃，卻被腳邊的雜物絆住腳步。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>順勢靠近，伸手碰到了你的<<if _hmEncounter.offerTarget is "lower">><<bottom>><<else>><<chest>><</if>>。你立即退開，制止對方；他連忙笑著退後半步，但一副意猶未盡的表情。<br><br>
            <<elseif _hmEncounter.overstepOutcome is "stopped">>
                你沒有後退，只是直直看著<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>，清楚地說：「手收回去。等我交給你。」他愣了一下，迅速把手縮回胸前，連連點頭。<br><br>
            <<elseif _hmEncounter.overstepOutcome is "extra">>
                你沒有急著繼續交易，也沒有立刻制止對方伸向你<<if _hmEncounter.offerTarget is "lower">><<bottom>><<else>><<chest>><</if>>的手，而是看著他越過界線的動作，慢條斯理地說：「這可不包含在原本的價錢裡。」你稍稍提高音量，作勢要吸引更多人注意。<br><br>
                他立刻環顧四周，發現似乎有人注意到這裡，急忙請你小聲一點。他掏出更多鈔票，反覆確認你願意就此打住。你等他把額外報酬說清楚，才示意他站回原位。<br><br>
                <<set _hmExtraPennies to _hmEncounter.extraPay * 100>>
                <span class="gold">額外補償：<<printmoney _hmExtraPennies>></span><br><br>
            <</if>>
            他終於願意保持距離，等待你親手完成交付。<br><br>
            <<link "讓他退開，繼續完成交易" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("finish")>>
            <</link>><br>
            <<link "改變主意，取消交易" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("cancel")>>
            <</link>><br>
        <</if>>
    <</if>>
<</widget>>

/* 展示與欺騙共用衣著判定，但敘事依情境分流；原版部位 Widget 保持不變。 */
<<widget "HonestMarketsEncounterCollectorClothingText">>
    <<set _hmC to _args[0]>>
    <<set _hmTarget to _args[1] || "set">>
    <<set _hmV to Number(_args[3] || 0)>>
    <<set _hmPrank to _args[4] is "prank">>
    <<if _hmC.onePiece>>
        <<if _hmC.upperOuter or _hmC.lowerOuter>>
            你將遮住貼身衣物的外層衣料挪開，露出「<<print _hmC.upperName>>」連成一體的樣式。<br><br>
        <<else>>
            你轉過身，輕輕拉平「<<print _hmC.upperName>>」的衣緣，讓他看清這是一件連身衣物。<br><br>
        <</if>>
        <<if _hmPrank>>
            「這件要整件取下。」你故意停下動作，讓他以為你正在準備交貨。<br><br>
        <<else>>
            「這是一整件，不能拆開。」你放開衣緣，沒有脫下它。<br><br>
        <</if>>
    <<else>>
        <<if _hmTarget is "upper" or _hmTarget is "set">>
            <<if _hmC.upperUnder>>
                <<if _hmC.upperOuter>>
                    你將上身外衣稍稍撥開，露出裡面的「<<print _hmC.upperName>>」，隨後把衣料放回原位。<br><br>
                <<else>>
                    你稍稍轉身，拉平「<<print _hmC.upperName>>」的衣緣，讓他看清衣物。<br><br>
                <</if>>
            <<elseif _hmC.upperOuter>>
                你撥開上身外衣，讓他看見衣料底下的<<chest>>，隨後重新遮好。<br><br>
            <<else>>
                你側過身，讓他看清你裸露的<<chest>>。<br><br>
            <</if>>
        <</if>>
        <<if _hmTarget is "lower" or _hmTarget is "set">>
            <<if _hmC.lowerUnder>>
                <<if _hmC.lowerOuter>>
                    你將下身外衣稍稍撥開，讓他看見裡面的「<<print _hmC.lowerName>>」，隨即整理好衣料。<br><br>
                <<else>>
                    你轉過身，輕輕調整「<<print _hmC.lowerName>>」的衣緣，讓他看清衣物。<br><br>
                <</if>>
            <<elseif _hmC.lowerOuter>>
                你挪開下身外層衣料，讓他看見你的<<if _hmV is 1>><<bottom>><<else>><<genitals>><</if>>，隨即重新遮好。<br><br>
            <<else>>
                你稍稍轉身，讓他看清你的<<if _hmV is 1>><<bottom>><<else>><<genitals>><</if>>。<br><br>
            <</if>>
        <</if>>
        <<if _hmPrank>>
            你故意慢慢收回手，沒有取下任何衣物，等著他自己開口。<br><br>
        <<else>>
            你收回展示的動作，沒有將任何衣物交給他。<br><br>
        <</if>>
    <</if>>
<</widget>>

/* 收藏家看到展示或裸露時的反應；不修改衣物與 NPC 狀態。 */
<<widget "HonestMarketsEncounterCollectorDisplayReaction">>
    <<set _hmRClothes to _args[0]>>
    <<set _hmRTarget to _args[1] || "set">>
    <<set _hmRVariant to Number(_args[2] || 0)>>
    <<set _hmRPrank to _args[3] is "prank">>
    <<set _hmRUpperEmpty to (_hmRTarget is "upper" or _hmRTarget is "set") and !_hmRClothes.upperUnder and !_hmRClothes.onePiece>>
    <<set _hmRLowerEmpty to (_hmRTarget is "lower" or _hmRTarget is "set") and !_hmRClothes.lowerUnder and !_hmRClothes.onePiece>>
    <<if _hmRPrank>>
        他仍在等你把答應的衣物交給他，一時沒有察覺你根本沒打算照做。<br><br>
    <<elseif _hmRUpperEmpty and _hmRLowerEmpty>>
        <<if _hmRVariant is 0>>
            他整個人僵在原地，嘴巴張了又合，半天說不出話。<br><br>
        <<elseif _hmRVariant is 1>>
            他猛地睜大眼睛，原本準備好的話全忘了。「等、等等……」他結結巴巴，顯然完全沒料到你會直接讓他看個明白。<br><br>
        <<else>>
            他愣得忘了眨眼，甚至沒發現旁邊有人經過。直到你清了清喉嚨，他才慌亂地移開目光，臉上的驚訝卻藏也藏不住。<br><br>
        <</if>>
    <<elseif _hmRUpperEmpty or _hmRLowerEmpty>>
        <<if _hmRVariant is 0>>
            他本來正專心看著衣料，卻在發現你根本沒穿他指定的那件時猛地瞪大眼睛。伸出的手停在半空，連準備好的話都忘了說。<br><br>
        <<elseif _hmRVariant is 1>>
            他下意識往前探了探頭，隨即像被嚇到似的縮回去。「你、你真的沒穿？」他一時不知道該說什麼，只好慌忙移開目光。<br><br>
        <<else>>
            他怔怔地看了好幾秒，直到你提醒才猛然回神。那副目瞪口呆的模樣，和剛才一本正經談價錢的態度判若兩人。<br><br>
        <</if>>
    <<else>>
        <<if _hmRVariant is 0>>
            他睜大眼睛盯著你身上的衣物，原本流利的討價還價忽然變得結結巴巴。<br><br>
        <<elseif _hmRVariant is 1>>
            他一時看得出神，直到你放下衣緣才慌忙收回視線，尷尬地清了清喉嚨。<br><br>
        <<else>>
            他看了又看，像是忘記自己原本打算說什麼。你輕咳一聲，他才紅著臉重新提起價錢。<br><br>
        <</if>>
    <</if>>
<</widget>>

/* 路人插曲只發生在交貨現場，無論是否越界都只出現一次。 */
<<widget "HonestMarketsEncounterCollectorPasserby">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
        /* 路人差分只描述交貨前的短暫干擾，不描述交貨、收款或交易完成。 */
        <<if _hmEncounter.passerbyNotice>>
            <<if _hmEncounter.buyerOnsite>>
                <<if hasSexStat("exhibitionism", 5)>>
                    有路人從你們身旁經過，朝你們投來好奇的一瞥。你若無其事地等他走遠，他倒是緊張得連忙移開目光。<br><br>
                <<elseif hasSexStat("exhibitionism", 4)>>
                    有人在你們附近停下腳步。你暫時停住動作，直到那人離開，才重新準備交貨。<br><br>
                <<else>>
                    附近有人停下交談，你趕緊收住動作，等那人走遠後才鬆了一口氣。<br><br>
                <</if>>
            <<else>>
                <<if hasSexStat("exhibitionism", 5)>>
                    角落外忽然傳來腳步聲，對方急忙轉身假裝在看周圍的商品。你從容地等聲音遠去，才繼續準備。<br><br>
                <<elseif hasSexStat("exhibitionism", 4)>>
                    角落外傳來腳步聲，你暫時停住動作，直到聲音漸遠才繼續。<br><br>
                <<else>>
                    有人朝角落走近，你趕緊往不顯眼的地方退開，等對方離開後才回到原位。<br><br>
                <</if>>
            <</if>>
        <</if>>
<</widget>>

/* 交貨場景只建立一次；越界事件發生在抵達交貨位置之後。 */
<<widget "HonestMarketsEncounterCollectorDeliverySetup">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
        <<if _hmEncounter.buyerOnsite>>
            <span class="blue"><<print $NPCList[0].fullDescription_CN>></span>聽見你的答覆，立刻從口袋取出鈔票，低聲補上一句：「可以現在就在這裡交給我嗎？」對方的目光在你與往來的人群之間游移，似乎擔心你改變主意。<br><br>
            <<if _hmEncounter.sceneVariant is 0>>
                市集裡的叫賣聲一刻也沒停。你站在原地，察覺對方不時朝周圍張望，卻仍堅持在這裡完成交易。<br><br>
            <<elseif _hmEncounter.sceneVariant is 1>>
                你確認附近有足夠的空間，準備在原地完成交付。<br><br>
            <<else>>
                附近的攤販正在招呼客人，他卻壓低聲音催促：「就現在，好嗎？」你看了看周圍，決定照約定在原地交付。<br><br>
            <</if>>
        <<else>>
            <span class="blue"><<print $NPCList[0].fullDescription_CN>></span>只顧著數鈔票，似乎完全沒考慮到該在哪裡交貨。你掃了一眼擁擠的人群，主動示意對方跟你走。<br><br>
            <<if _hmEncounter.sceneVariant is 0>>
                你們繞過來往的人群，在不容易被人注意的角落停下。他這才恍然大悟，連忙把鈔票握在手裡。<br><br>
            <<elseif _hmEncounter.sceneVariant is 1>>
                你指了指市集邊緣較安靜的位置。對方愣了一下，隨即跟上。<br><br>
            <<else>>
                你沒有急著動手，直到兩人走到較少人經過的轉角才停下。遠處的討價還價聲仍清晰可聞，對方小聲向你道謝。<br><br>
            <</if>>
        <</if>>
        <<if hasSexStat("exhibitionism", 6)>>
            <<if _hmEncounter.buyerOnsite>>
                你若無其事地站在人來人往的地方，反而笑著提醒對方把錢準備好。他本來還在催促，這下卻緊張得把鈔票數錯了一次。<br><br>
            <<else>>
                你熟門熟路地選好位置，還回頭問他這裡是否可以。對方沒料到你如此主動，反而有些手足無措。<br><br>
            <</if>>
        <<elseif hasSexStat("exhibitionism", 5)>>
            <<if _hmEncounter.buyerOnsite>>
                你接受對方當場交付的要求，從容地確認衣物該如何取下。<br><br>
            <<else>>
                你把這件事當成普通的買賣，選好位置後便開始整理衣著。<br><br>
            <</if>>
        <<elseif hasSexStat("exhibitionism", 4)>>
            <<if _hmEncounter.buyerOnsite>>
                你沒想到對方竟要求在人群附近交貨。短暫猶豫後，你側過身，決定盡量不引人注意地完成交易。<br><br>
            <<else>>
                你鬆了口氣，至少不用在來往的人群面前整理衣物。確認附近沒有人留意，你才準備開始。<br><br>
            <</if>>
        <<else>>
            <<if _hmEncounter.buyerOnsite>>
                對方的要求讓你僵了一瞬。你反覆確認旁人的視線，才小心翼翼地準備交出約定的衣物。<br><br>
            <<else>>
                你不願在大庭廣眾之下完成這筆交易，因此特地找了個不顯眼的位置。即使如此，你仍忍不住再次張望。<br><br>
            <</if>>
        <</if>>
        /* 收藏家的注視與驚訝只由正式脫衣動作差分描述，避免準備階段重複反應。 */
<</widget>>

/* 收藏家延伸交易：尚有選項的內容全部由 Stage 輸出，Result 只負責終局。 */
<<widget "HonestMarketsEncounterUnderwearCollectorStage">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<set _hmCollectorViewResult to _hmEncounter.presentationResult || _hmEncounter.result>>
    <<if false>>
    <<elseif _hmEncounter and _hmCollectorViewResult is "sold">>
        <<set _hmPricePennies to (_hmEncounter.price + (_hmEncounter.extraPay || 0)) * 100>>
        <<if !_hmEncounter.overstep>>
            <<HonestMarketsEncounterCollectorDeliverySetup>>
            <<HonestMarketsEncounterCollectorPasserby>>
        <</if>>
        /* 正式出售：收藏家只在玩家脫衣動作中簡短反應；不另設獨立反應階段。 */
        <<set _hmDeliveryTarget to _hmEncounter.offerTarget || _hmEncounter.target>>
        <<set _hmUpperOuter to _hmEncounter.clothing.upperOuter>>
        <<set _hmLowerOuter to _hmEncounter.clothing.lowerOuter>>
        <<set _hmRemoveV to Number(_hmEncounter.removalVariant || 0)>>
        <<if _hmDeliveryTarget is "upper" or _hmDeliveryTarget is "set">>
            <<if _hmUpperOuter>>
                <<if _hmRemoveV is 0>>
                    你先拉開上身外衣，將手伸到衣料底下，摸索著「<<print _hmEncounter.upperName>>」的扣子。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你稍稍轉過身，挪開擋住胸罩的外衣，讓雙手有足夠的空間動作。<br><br>
                <<else>>
                    你看了他一眼，慢慢拉開上身外衣，手指沿著「<<print _hmEncounter.upperName>>」摸向背後。<br><br>
                <</if>>
            <<else>>
                <<if _hmRemoveV is 0>>
                    你伸手摸向「<<print _hmEncounter.upperName>>」的背扣。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你略微側身，抬起手臂，開始解開身上的「<<print _hmEncounter.upperName>>」。<br><br>
                <<else>>
                    你沒有再拖延，將手伸向「<<print _hmEncounter.upperName>>」的扣子。<br><br>
                <</if>>
            <</if>>
            <<if _hmRemoveV is 0>>
                扣子終於鬆開，你先將一側肩帶從肩頭褪下，抽出手臂，再換另一側。他目不轉睛地看著肩帶滑落。胸罩逐漸離開身體，你將整件衣物攏在手心。<br><br>
            <<elseif _hmRemoveV is 1>>
                你摸索片刻，解開胸罩的扣子。你讓肩帶沿著雙臂往下滑，先褪去一邊，再慢慢抽出另一邊，他望著你逐一抽出手臂，微微睜大眼睛。你最後將胸罩完整取下。<br><br>
            <<else>>
                你解開背後的扣子，感覺胸罩跟著鬆了下來。你抬起一隻手臂，將肩帶褪過手肘，又換另一隻手，他看著你換手褪下肩帶，一時沒有說話，直到它終於落入你手中。<br><br>
            <</if>>
            <<if _hmUpperOuter>>
                你將外衣重新整理妥當，少了一層貼身衣料的感覺格外明顯。<br><br>
            <<else>>
                沒有外衣遮擋，你的<<chest>>完全暴露出來了。你握緊剛脫下的胸罩。<br><br>
            <</if>>
        <</if>>
        <<if _hmDeliveryTarget is "lower" or _hmDeliveryTarget is "set">>
            <<if _hmLowerOuter>>
                <<if _hmRemoveV is 0>>
                    你先挪開下身的外層衣物，伸手抓住「<<print _hmEncounter.lowerName>>」兩側的褲腰。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你調整好外層下裝，讓手能伸到裡面，隨後勾住「<<print _hmEncounter.lowerName>>」的褲腰。<br><br>
                <<else>>
                    你稍微拉開下身外衣，摸到「<<print _hmEncounter.lowerName>>」的邊緣，停頓片刻才開始往下褪。<br><br>
                <</if>>
            <<else>>
                <<if _hmRemoveV is 0>>
                    你直接抓住「<<print _hmEncounter.lowerName>>」的兩側，開始將它往下拉。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你低頭看了眼身上的「<<print _hmEncounter.lowerName>>」，用手指勾住褲腰，緩緩往下褪。<br><br>
                <<else>>
                    你稍微站穩，雙手抓住「<<print _hmEncounter.lowerName>>」的褲腰，將衣料慢慢往下移。<br><br>
                <</if>>
            <</if>>
            <<if _hmRemoveV is 0>>
                內褲順著雙腿滑過膝蓋，最後停在腳踝。你扶穩身體，先抬起一條腿抽出腳，再換另一條腿，他盯著你依序抽出雙腳的動作，略顯驚訝。你彎腰將脫下的內褲拾起。<br><br>
            <<elseif _hmRemoveV is 1>>
                你一點點將內褲褪到膝下，再讓它滑到腳邊。你將重心移到一條腿上，抽出另一隻腳，接著交換姿勢，他看著你小心交換重心，目光沒有移開。你終於把整件內褲取了下來。<br><br>
            <<else>>
                衣料慢慢沿著大腿往下，經過膝蓋，堆在雙腳旁。你先跨出一隻腳，稍微站穩後再跨出另一隻，他看著你跨出衣物，短暫愣住。你最後俯身撿起內褲。<br><br>
            <</if>>
            <<if _hmLowerOuter>>
                你將下身外衣重新整理好，知道裡面已經少了最後那層貼身衣物。<br><br>
            <<else>>
                失去最後一層遮擋，你的<<genitals>>完全暴露出來了。你將脫下的內褲握在手裡。<br><br>
            <</if>>
        <</if>>
        <<if _hmDeliveryTarget is "one_piece">>
            <<if _hmUpperOuter or _hmLowerOuter>>
                你先將擋住「<<print _hmEncounter.clothing.upperName>>」的外層衣物挪開，留出脫下連身衣物的空間。<br><br>
            <</if>>
            <<if _hmRemoveV is 0>>
                你將泳裝的肩帶逐一褪下，讓上半身的衣料慢慢鬆開，再沿著腰際將整件衣物往下拉。衣料經過膝蓋，停在腳踝；你先抽出一隻腳，再抽出另一隻，他看著連身衣物一路褪至腳邊，微微睜大眼睛。你將完整的泳裝拾起。<br><br>
            <<elseif _hmRemoveV is 1>>
                你抬起手臂，將連身衣物的一側肩帶滑過肩頭，再處理另一側。你小心把上半身的衣料往下褪，經過腰部與雙腿，最後依序跨出雙腳，他目不轉睛地看著你抽出雙腳。你把整件「<<print _hmEncounter.clothing.upperName>>」拿在手中。<br><br>
            <<else>>
                你先讓肩帶離開雙肩，稍稍扭動身體，將連在一起的衣料從上半身慢慢褪至腰下。你繼續將它拉過膝蓋，扶穩身體，依次抽出雙腳，他看著衣料離開你的雙腳，一時有些出神。你終於完整脫下「<<print _hmEncounter.clothing.upperName>>」。<br><br>
            <</if>>
            <<if _hmUpperOuter or _hmLowerOuter>>
                你把挪開的外衣重新整理好，手裡只拿著一件完整的連身衣物。<br><br>
            <</if>>
            <<if !_hmUpperOuter>>
                你的<<chest>>失去了貼身衣物的遮擋，完全暴露出來了。<br><br>
            <</if>>
            <<if !_hmLowerOuter>>
                你的<<genitals>>也完全暴露出來了。<br><br>
            <</if>>
        <</if>>
        <<if _hmEncounter.stainReaction is "semen" or _hmEncounter.stainReaction is "arousal">>
            你將取下的衣物遞到他面前。<br><br>
        <<else>>
            你將取下的衣物交給他，他接過後開始檢查。<br><br>
        <</if>>
        /* 參照原版 Street Panties：實際交付下身內衣後，收藏家檢查衣物的特殊反應。 */
        <<if _hmDeliveryTarget is "lower" or _hmDeliveryTarget is "set" or _hmDeliveryTarget is "one_piece">>
            <<if _hmEncounter.stainReaction is "semen">>
                <<if _hmEncounter.removalVariant is 0>>
                    他正要收好衣物，忽然察覺布料上殘留的濕痕，動作一下停住。「這上面……」他湊近看了看，隨即露出難以掩飾的笑容，連剛才要說的話都忘了。<br><br>
                <<elseif _hmEncounter.removalVariant is 1>>
                    他接過衣物，指尖碰到尚未乾透的痕跡，眼睛立刻亮了起來。他將衣物往自己身邊攏了攏，低聲嘀咕了幾句，像是得到了意料之外的收穫。<br><br>
                <<else>>
                    他翻看衣物時注意到布料上的體液痕跡，先是一怔，接著滿意得連聲道謝。你還沒催促，他便急忙把衣物妥善收起。<br><br>
                <</if>>
            <<elseif _hmEncounter.stainReaction is "arousal">>
                <<if _hmEncounter.removalVariant is 0>>
                    他看見衣物上明顯的濕痕，原本準備收好衣物的手頓了一下。他低聲問了句什麼，卻又自己搖頭，紅著臉把衣物收好。<br><br>
                <<elseif _hmEncounter.removalVariant is 1>>
                    他將衣物翻過來檢查，目光停在一處尚未乾透的痕跡上，頓時忘了說話。等你提醒，他才匆匆點頭，將衣物仔細收好。<br><br>
                <<else>>
                    他發現衣物上的濕印，神情變得格外專注。他張了張嘴，最後只擠出一句「我會好好收著」，便小心將它放進袋裡。<br><br>
                <</if>>
            <</if>>
        <</if>>
        <<if _hmEncounter.stainReaction is "semen" or _hmEncounter.stainReaction is "arousal">>
            你等他看得差不多了，便提醒他還有約定的報酬尚未付清。<br><br>
        <<else>>
            他檢查完衣物，抬眼看向你，這才想起還有約定的報酬尚未付清。<br><br>
        <</if>>
        對方把約定的<<printmoney _hmPricePennies>>交到你手裡。你收好報酬，交易終於完成。<<if _hmEncounter.stainReaction is not "semen" and _hmEncounter.stainReaction is not "arousal">>他這才將買下的衣物收妥。<</if>><br><br>
        <<if _hmEncounter.extensionPending>>
            他剛把這筆交易的衣物收好，卻又望向你身上還穿著的服裝，遲疑片刻後再次開口。<br><br>
            <<set _hmExtensionPennies to Math.round(Number(_hmEncounter.extensionPrice || 0) * 100)>>「等等……剩下那些衣服，你願意全部賣給我嗎？我可以再出<<printmoney _hmExtensionPennies>>。」<br><br>
            <<if hasSexStat("exhibitionism", 5)>>
                <<link "答應把身上剩下的衣物全賣給他" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("extension_accept")>>
                <</link>> <<exhibitionist5>> <span class="gold">金錢+</span><br>
            <</if>>
            <<link "搖頭拒絕，留下剩餘的衣物" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("extension_decline")>>
            <</link>><br><br>
        <<elseif _hmEncounter.buyerOnsite>>
            交易完成後，你重新混入市場的人潮；他則混入人群，繼續在市集裡閒逛。<br><br>
        <<else>>
            你們走回熱鬧的人群。對方朝你點頭致意，隨後各自離開。<br><br>
        <</if>>
    <<elseif _hmEncounter and _hmCollectorViewResult is "extension_sold">>
        <<if _hmEncounter.buyerOnsite>>
            <<print _hmEncounter.extensionClothing.removalText>><br><br>
            你的<<chest>>及<<genitals>>完全暴露在外，一絲不掛！<br><br>
            <<if _hmEncounter.extensionWitnessVariant is 0>>
                附近的路人看見你在市集裡當眾脫下所有衣物，驚訝得停下腳步，眼睛一時不知該往哪裡看。<br><br>
            <<elseif _hmEncounter.extensionWitnessVariant is 1>>
                「快看！那人的<<chest>>都露出來了！」一名路人忍不住叫出聲，周圍的人也紛紛轉頭看向你。<br><br>
            <<else>>
                「這裡可是市場啊！」有人驚呼，幾名路人停下來，目瞪口呆地看著你大膽的舉動。<br><br>
            <</if>>
        <<else>>
            這裡少有人經過。<<print _hmEncounter.extensionClothing.removalText>><br><br>
            你的<<chest>>及<<genitals>>完全暴露在外，一絲不掛！<br><br>
        <</if>>
        <<set _hmExtensionPennies to Math.round(Number(_hmEncounter.extensionPrice || 0) * 100)>>他看著你交出的衣物，略顯驚訝地睜大眼睛，隨後將追加的<<printmoney _hmExtensionPennies>>交給你。<br><br>
        <<if _hmEncounter.touchPending>>
            交易已經完成，他卻仍望著你赤裸的身體，忽然有了另一個念頭。他取出錢包，試探著問你是否願意讓他再靠近一些。<br><br>
            <<set _hmTouchPennies to Math.round(Number(_hmEncounter.extensionPrice || 0) * 200)>>「我可以再付<<printmoney _hmTouchPennies>>。這次……能讓我摸摸你的<<if _hmEncounter.touchFirst is "chest">>胸前<<elseif _hmEncounter.touchFirst is "bottom">>臀部<<else>>私密部位<</if>>嗎？」<br><br>
            <<if hasSexStat("exhibitionism", 5)>>
                <<link "同意他的提議" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_accept")>><</link>> <span class="gold">金錢+</span><br>
            <</if>>
            <<link "拒絕這筆額外交易" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_decline")>><</link>><br><br>
        <<else>>
            他帶著買下的衣物離開，留下赤裸的你站在原地。<br><br>
        <</if>>
    <<elseif _hmEncounter and _hmCollectorViewResult is "touch_offer">>
        他看著你，指了指你的<<if _hmEncounter.touchSecond is "chest">>胸前<<elseif _hmEncounter.touchSecond is "bottom">>臀部<<else>>私密部位<</if>>，再次提出相同價碼的邀約。<br><br>
        <<set _hmTouchPennies to Math.round(Number(_hmEncounter.extensionPrice || 0) * 200)>>「這次換個地方，可以嗎？我再付<<printmoney _hmTouchPennies>>。」<br><br>
        <<if hasSexStat("exhibitionism", 5)>>
            <<link "答應第二筆交易" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_accept")>><</link>> <span class="gold">金錢+</span><br>
        <</if>>
        <<link "到此為止，拒絕繼續" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_decline")>><</link>><br><br>
    <<elseif _hmEncounter and _hmEncounter.stage is "intimate_offer" and _hmCollectorViewResult is "intimate_offer">>
        他壓低聲音，提出另一筆更加私密的交易。這一次的報酬，是剛才摸摸交易的五倍。<br><br>
        <<set _hmIntimatePennies to Math.round(Number(_hmEncounter.intimatePrice || 0) * 100)>>
        「我願意出<<printmoney _hmIntimatePennies>>。你願意嗎？」<br><br>
        <<link "同意這筆自願交易" "HonestMarkets Collector Combat">><<run setup.HonestMarkets.resolveMarketEncounter("intimate_accept")>><<set $sexstart to 1>><</link>> <span class="gold">金錢+</span><br>
        <<link "拒絕邀約" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("intimate_decline")>><</link>><br>
    <<elseif _hmEncounter and _hmCollectorViewResult is "touch_completed">>
        <<if _hmEncounter.touchTarget is "chest">>
            他的目光落在你的<<chest>>上，眼神一下亮了起來。<br><br>
            <<print setup.HonestMarkets.marketCollectorTouchText("motion", "chest", _hmEncounter.touchMotionVariant)>><br><br>
        <<elseif _hmEncounter.touchTarget is "bottom">>
            你轉過身，讓他能看清你的臀側；他的目光隨之移了過去。<br><br>
            <<print setup.HonestMarkets.marketCollectorTouchText("motion", "bottom", _hmEncounter.touchMotionVariant)>><br><br>
        <<elseif _hmEncounter.touchTarget is "genitals">>
            他的視線落在你的<<genitals>>上，顯然對眼前的景象十分好奇。<br><br>
            <<print setup.HonestMarkets.marketCollectorTouchText("motion", "genitals", _hmEncounter.touchMotionVariant)>><br><br>
        <</if>>
        <<if _hmEncounter.touchState.aroused>>
            <<print setup.HonestMarkets.marketCollectorTouchText("reaction", "aroused", _hmEncounter.touchReactionVariant)>><br><br>
        <<else>>
            <<print setup.HonestMarkets.marketCollectorTouchText("reaction", "normal", _hmEncounter.touchReactionVariant)>><br><br>
        <</if>>
        <!-- 特殊液體：精液優先；每次只輸出同一組 A/B，原有精液暴露心理保留。 -->
        <<set _hmLiquidPair = setup.HonestMarkets.marketCollectorTouchLiquidPair(_hmEncounter)>>
        <<if _hmLiquidPair>>
            <<print _hmLiquidPair.a>><br><br>
            <<print _hmLiquidPair.b>><br><br>
            <<if _hmEncounter.touchState.semen>>
                <<if Number($exhibitionism) >= 95>>
                    你沒有急著解釋，只是平靜地看著他的表情。<br><br>
                <<elseif Number($exhibitionism) >= 85>>
                    你努力保持表情自然，假裝沒有注意到他的反應。<br><br>
                <<else>>
                    你頓時更加難為情，生怕他接著問出什麼尷尬的問題。<br><br>
                <</if>>
            <</if>>
        <</if>>
        <<if _hmEncounter.touchTarget is "chest">>
            <<print setup.HonestMarkets.marketCollectorTouchText("dialogue", "chest", _hmEncounter.touchMotionVariant)>><br><br>
        <<elseif _hmEncounter.touchTarget is "bottom">>
            <<print setup.HonestMarkets.marketCollectorTouchText("dialogue", "bottom", _hmEncounter.touchMotionVariant)>><br><br>
        <<elseif _hmEncounter.touchTarget is "genitals">>
            <<print setup.HonestMarkets.marketCollectorTouchText("dialogue", "genitals", _hmEncounter.touchMotionVariant)>><br><br>
        <</if>>
        他終於收回手，稍稍退開，仍忍不住朝你多看了一眼。<br><br>
        <<if Number($exhibitionism) >= 95>>
            <<print setup.HonestMarkets.marketCollectorTouchText("after", "high", _hmEncounter.touchReactionVariant)>><br><br>
        <<elseif Number($exhibitionism) >= 85>>
            <<print setup.HonestMarkets.marketCollectorTouchText("after", "mid", _hmEncounter.touchReactionVariant)>><br><br>
        <<else>>
            <<print setup.HonestMarkets.marketCollectorTouchText("after", "low", _hmEncounter.touchReactionVariant)>><br><br>
        <</if>>
        <<set _hmTouchPennies to Math.round(Number(_hmEncounter.extensionPrice || 0) * 200)>>你收下約定的<<printmoney _hmTouchPennies>>。<br><br>
        <<if _hmEncounter.touchNextPending>>
            他沒有立即離開，反而望向另一個部位，像是又想到一筆交易。<br><br>
            <<link "聽聽他還想提出什麼條件" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_next")>><</link>><br>
            <<link "不再繼續，讓他離開" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("touch_decline")>><</link>><br><br>
        <<elseif _hmEncounter.stage is "intimate_offer">>
            他收好衣物，卻遲遲沒有離開，似乎還想提出另一筆交易。<br><br>
            <<link "聽聽他的最後一筆報價" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("intimate_view")>><</link>><br><br>
        <<else>>
            他抱著衣物向你道別，滿意地離開這處角落。<br><br>
        <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterUnderwearCollectorResult">>
    <<set _hmCollector to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmCollector and ["sold", "extension_sold", "touch_completed"].includes(_hmCollector.result)>>
        <<HonestMarketsEncounterUnderwearCollectorStage>>
    <<else>>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter and _hmEncounter.result is "shy_leave">>
        你愣了片刻，終於聽懂對方的要求，臉頰一下子紅了起來。<br><br>
        <<if _hmEncounter.clothing.upperOuter or _hmEncounter.clothing.lowerOuter>>
            你下意識把身上還穿著的外衣拉整齊，往後退開一步。<br><br>
        <<elseif _hmEncounter.clothing.upperUnder or _hmEncounter.clothing.lowerUnder>>
            你看了看自己僅剩的貼身衣物，慌忙調整好衣緣，避開對方的視線。<br><br>
        <<else>>
            你本能地抱起雙臂，避開對方探詢的目光。<br><br>
        <</if>>
        「我、我才不要！」你匆忙穿過人群，留下對方站在人群邊緣，手裡還捏著沒來得及收起的鈔票。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "showcased">>
        你笑著搖了搖頭。「想看可以，但我可沒有答應要賣。」<br><br>
        <<HonestMarketsEncounterCollectorClothingText _hmEncounter.clothing _hmEncounter.target _hmEncounter.sceneVariant _hmEncounter.displayVariant>>
        <<HonestMarketsEncounterCollectorDisplayReaction _hmEncounter.clothing _hmEncounter.target _hmEncounter.emptyReaction>>
        <<if _hmEncounter.exitVariant is 0>>
            你沒有收錢，也沒有交出衣物，逕自回到熱鬧的市場。<br><br>
        <<elseif _hmEncounter.exitVariant is 1>>
            你向對方點頭示意，轉身離開對方，繼續逛市場。<br><br>
        <<else>>
            你確認衣著整齊，便留下仍在猶豫的他，走回市場的人群。<br><br>
        <</if>>
    <<elseif _hmEncounter and _hmEncounter.result is "pranked">>
        <<if _hmEncounter.inviteVariant is 0>>
            你朝他勾了勾手指，低聲說：「這裡人太多了，跟我來。」他連忙跟在你身後。<br><br>
        <<elseif _hmEncounter.inviteVariant is 1>>
            你故意環顧四周，露出為難的神情。「換個地方談吧。」他立刻答應，生怕你改變主意。<br><br>
        <<else>>
            你朝兩排攤位間的安靜角落偏了偏頭。他先是一愣，隨即快步跟上。<br><br>
        <</if>>
        到了角落，你轉身朝他伸出手。「先付錢。」<br><br>
        <<if _hmEncounter.payVariant is 0>>
            他幾乎沒有猶豫，就把約定的金額交給你，隨即滿懷期待地等著你交貨。<br><br>
        <<elseif _hmEncounter.payVariant is 1>>
            「可是……」他才開口，你就作勢離開。「等等！我付！」他急忙把錢遞過來。<br><br>
        <<else>>
            他翻找錢包時數錯了一次鈔票，連忙重新點清，才把錢放到你手中。<br><br>
        <</if>>
        /* 欺騙分支付款後才揭露缺貨；普通展示仍提前說明。 */
        <<set _hmPrankMissingUpper to (_hmEncounter.target is "upper" or _hmEncounter.target is "set") and !_hmEncounter.clothing.upperUnder>>
        <<set _hmPrankMissingLower to (_hmEncounter.target is "lower" or _hmEncounter.target is "set") and !_hmEncounter.clothing.lowerUnder>>
        <<set _hmPrankMissingAny to _hmPrankMissingUpper or _hmPrankMissingLower>>
        <<set _hmPrankPennies to _hmEncounter.price * 100>>
        你把<<printmoney _hmPrankPennies>>收進口袋，見他仍滿懷期待地等候，便故意把動作放得更慢。<br><br>
        <<HonestMarketsEncounterCollectorClothingText _hmEncounter.clothing _hmEncounter.target _hmEncounter.sceneVariant _hmEncounter.displayVariant "prank">>
        <<HonestMarketsEncounterCollectorDisplayReaction _hmEncounter.clothing _hmEncounter.target _hmEncounter.emptyReaction "prank">>
        <<if _hmPrankMissingAny>>
            <<if _hmPrankMissingUpper and _hmPrankMissingLower>>
                他終於忍不住叫道：「等等，你根本沒有我要買的那一套！」<br><br>
            <<elseif _hmPrankMissingUpper>>
                他忽然反應過來：「可是我要買的是內衣，你根本沒有啊！」<br><br>
            <<else>>
                他瞪大眼睛：「可是我要買的是內褲，你根本沒有啊！」<br><br>
            <</if>>
            <<if _hmEncounter.exitVariant is 0>>
                「我不是已經讓你看清楚了嗎？」你趁他還在整理思緒，迅速退回人群。<br><br>
            <<elseif _hmEncounter.exitVariant is 1>>
                他伸手想討回錢，你卻先一步閃開。「你自己剛才答應先付款的。」說完便轉身離開。<br><br>
            <<else>>
                「所以我才讓你親眼確認啊。」你故作無辜地攤手，趁他氣得說不出話時溜進人潮。<br><br>
            <</if>>
            你沒有交出任何衣物，卻帶著那筆錢離開了市場角落。<br><br>
        <<else>>
            「怎麼樣？看清楚了嗎？」他忙不迭地點頭，還滿心期待著你接下來的動作。<br><br>
            你若無其事地準備離開。他終於忍不住問：「那……衣服呢？」<br><br>
            「我可沒說現在就交給你。」你笑著回了一句，趁他還在發愣，轉身走向人潮。<br><br>
            <<if _hmEncounter.exitVariant is 0>>
                他伸出的手停在半空，直到你走遠才意識到自己什麼也沒拿到。<br><br>
            <<elseif _hmEncounter.exitVariant is 1>>
                「等等！你還沒把衣服交給我！」他追了兩步，卻很快失去你的蹤影。<br><br>
            <<else>>
                他摸摸變薄的錢包，又望向你離開的方向，半晌才喃喃道：「……我是不是被耍了？」<br><br>
            <</if>>
            你保留了全部衣物，也帶走了那筆錢，心情愉快地繼續逛市場。<br><br>
        <</if>>
    <<elseif _hmEncounter and _hmEncounter.result is "showed_empty">>
        你朝<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>笑了笑。
        你沒有急著回答他的收購要求，只是示意他親眼確認。<br><br>
        <<outfitChecks>>
        <<HonestMarketsEncounterCollectorClothingText _hmEncounter.clothing _hmEncounter.target _hmEncounter.sceneVariant _hmEncounter.displayVariant>>
        <<HonestMarketsEncounterCollectorDisplayReaction _hmEncounter.clothing _hmEncounter.target _hmEncounter.emptyReaction>>
        <<if hasSexStat("exhibitionism", 6)>>
            你還故意問了一句：「這樣還收嗎？」對方張了張嘴，卻完全答不上來。<br><br>
        <<else>>
            你欣賞著對方的窘態，忍不住露出得意的微笑。<br><br>
        <</if>>
        你收回展示的動作，留下還在消化眼前情況的他，轉身回到市場。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "alternative_rejected">>
        對方搖頭表示只想收購原先指定的衣物。你收回提議，轉身離開對方。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "sold">>
        <<set _hmPricePennies to (_hmEncounter.price + (_hmEncounter.extraPay || 0)) * 100>>
        <<if !_hmEncounter.overstep>>
            <<HonestMarketsEncounterCollectorDeliverySetup>>
            <<HonestMarketsEncounterCollectorPasserby>>
        <</if>>
        /* 正式出售：收藏家只在玩家脫衣動作中簡短反應；不另設獨立反應階段。 */
        <<set _hmDeliveryTarget to _hmEncounter.offerTarget || _hmEncounter.target>>
        <<set _hmUpperOuter to _hmEncounter.clothing.upperOuter>>
        <<set _hmLowerOuter to _hmEncounter.clothing.lowerOuter>>
        <<set _hmRemoveV to Number(_hmEncounter.removalVariant || 0)>>
        <<if _hmDeliveryTarget is "upper" or _hmDeliveryTarget is "set">>
            <<if _hmUpperOuter>>
                <<if _hmRemoveV is 0>>
                    你先拉開上身外衣，將手伸到衣料底下，摸索著「<<print _hmEncounter.upperName>>」的扣子。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你稍稍轉過身，挪開擋住胸罩的外衣，讓雙手有足夠的空間動作。<br><br>
                <<else>>
                    你看了他一眼，慢慢拉開上身外衣，手指沿著「<<print _hmEncounter.upperName>>」摸向背後。<br><br>
                <</if>>
            <<else>>
                <<if _hmRemoveV is 0>>
                    你伸手摸向「<<print _hmEncounter.upperName>>」的背扣。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你略微側身，抬起手臂，開始解開身上的「<<print _hmEncounter.upperName>>」。<br><br>
                <<else>>
                    你沒有再拖延，將手伸向「<<print _hmEncounter.upperName>>」的扣子。<br><br>
                <</if>>
            <</if>>
            <<if _hmRemoveV is 0>>
                扣子終於鬆開，你先將一側肩帶從肩頭褪下，抽出手臂，再換另一側。他目不轉睛地看著肩帶滑落。胸罩逐漸離開身體，你將整件衣物攏在手心。<br><br>
            <<elseif _hmRemoveV is 1>>
                你摸索片刻，解開胸罩的扣子。你讓肩帶沿著雙臂往下滑，先褪去一邊，再慢慢抽出另一邊，他望著你逐一抽出手臂，微微睜大眼睛。你最後將胸罩完整取下。<br><br>
            <<else>>
                你解開背後的扣子，感覺胸罩跟著鬆了下來。你抬起一隻手臂，將肩帶褪過手肘，又換另一隻手，他看著你換手褪下肩帶，一時沒有說話，直到它終於落入你手中。<br><br>
            <</if>>
            <<if _hmUpperOuter>>
                你將外衣重新整理妥當，少了一層貼身衣料的感覺格外明顯。<br><br>
            <<else>>
                沒有外衣遮擋，你的<<chest>>完全暴露出來了。你握緊剛脫下的胸罩。<br><br>
            <</if>>
        <</if>>
        <<if _hmDeliveryTarget is "lower" or _hmDeliveryTarget is "set">>
            <<if _hmLowerOuter>>
                <<if _hmRemoveV is 0>>
                    你先挪開下身的外層衣物，伸手抓住「<<print _hmEncounter.lowerName>>」兩側的褲腰。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你調整好外層下裝，讓手能伸到裡面，隨後勾住「<<print _hmEncounter.lowerName>>」的褲腰。<br><br>
                <<else>>
                    你稍微拉開下身外衣，摸到「<<print _hmEncounter.lowerName>>」的邊緣，停頓片刻才開始往下褪。<br><br>
                <</if>>
            <<else>>
                <<if _hmRemoveV is 0>>
                    你直接抓住「<<print _hmEncounter.lowerName>>」的兩側，開始將它往下拉。<br><br>
                <<elseif _hmRemoveV is 1>>
                    你低頭看了眼身上的「<<print _hmEncounter.lowerName>>」，用手指勾住褲腰，緩緩往下褪。<br><br>
                <<else>>
                    你稍微站穩，雙手抓住「<<print _hmEncounter.lowerName>>」的褲腰，將衣料慢慢往下移。<br><br>
                <</if>>
            <</if>>
            <<if _hmRemoveV is 0>>
                內褲順著雙腿滑過膝蓋，最後停在腳踝。你扶穩身體，先抬起一條腿抽出腳，再換另一條腿，他盯著你依序抽出雙腳的動作，略顯驚訝。你彎腰將脫下的內褲拾起。<br><br>
            <<elseif _hmRemoveV is 1>>
                你一點點將內褲褪到膝下，再讓它滑到腳邊。你將重心移到一條腿上，抽出另一隻腳，接著交換姿勢，他看著你小心交換重心，目光沒有移開。你終於把整件內褲取了下來。<br><br>
            <<else>>
                衣料慢慢沿著大腿往下，經過膝蓋，堆在雙腳旁。你先跨出一隻腳，稍微站穩後再跨出另一隻，他看著你跨出衣物，短暫愣住。你最後俯身撿起內褲。<br><br>
            <</if>>
            <<if _hmLowerOuter>>
                你將下身外衣重新整理好，知道裡面已經少了最後那層貼身衣物。<br><br>
            <<else>>
                失去最後一層遮擋，你的<<genitals>>完全暴露出來了。你將脫下的內褲握在手裡。<br><br>
            <</if>>
        <</if>>
        <<if _hmDeliveryTarget is "one_piece">>
            <<if _hmUpperOuter or _hmLowerOuter>>
                你先將擋住「<<print _hmEncounter.clothing.upperName>>」的外層衣物挪開，留出脫下連身衣物的空間。<br><br>
            <</if>>
            <<if _hmRemoveV is 0>>
                你將泳裝的肩帶逐一褪下，讓上半身的衣料慢慢鬆開，再沿著腰際將整件衣物往下拉。衣料經過膝蓋，停在腳踝；你先抽出一隻腳，再抽出另一隻，他看著連身衣物一路褪至腳邊，微微睜大眼睛。你將完整的泳裝拾起。<br><br>
            <<elseif _hmRemoveV is 1>>
                你抬起手臂，將連身衣物的一側肩帶滑過肩頭，再處理另一側。你小心把上半身的衣料往下褪，經過腰部與雙腿，最後依序跨出雙腳，他目不轉睛地看著你抽出雙腳。你把整件「<<print _hmEncounter.clothing.upperName>>」拿在手中。<br><br>
            <<else>>
                你先讓肩帶離開雙肩，稍稍扭動身體，將連在一起的衣料從上半身慢慢褪至腰下。你繼續將它拉過膝蓋，扶穩身體，依次抽出雙腳，他看著衣料離開你的雙腳，一時有些出神。你終於完整脫下「<<print _hmEncounter.clothing.upperName>>」。<br><br>
            <</if>>
            <<if _hmUpperOuter or _hmLowerOuter>>
                你把挪開的外衣重新整理好，手裡只拿著一件完整的連身衣物。<br><br>
            <</if>>
            <<if !_hmUpperOuter>>
                你的<<chest>>失去了貼身衣物的遮擋，完全暴露出來了。<br><br>
            <</if>>
            <<if !_hmLowerOuter>>
                你的<<genitals>>也完全暴露出來了。<br><br>
            <</if>>
        <</if>>
        <<if _hmEncounter.stainReaction is "semen" or _hmEncounter.stainReaction is "arousal">>
            你將取下的衣物遞到他面前。<br><br>
        <<else>>
            你將取下的衣物交給他，他接過後開始檢查。<br><br>
        <</if>>
        /* 參照原版 Street Panties：實際交付下身內衣後，收藏家檢查衣物的特殊反應。 */
        <<if _hmDeliveryTarget is "lower" or _hmDeliveryTarget is "set" or _hmDeliveryTarget is "one_piece">>
            <<if _hmEncounter.stainReaction is "semen">>
                <<if _hmEncounter.removalVariant is 0>>
                    他正要收好衣物，忽然察覺布料上殘留的濕痕，動作一下停住。「這上面……」他湊近看了看，隨即露出難以掩飾的笑容，連剛才要說的話都忘了。<br><br>
                <<elseif _hmEncounter.removalVariant is 1>>
                    他接過衣物，指尖碰到尚未乾透的痕跡，眼睛立刻亮了起來。他將衣物往自己身邊攏了攏，低聲嘀咕了幾句，像是得到了意料之外的收穫。<br><br>
                <<else>>
                    他翻看衣物時注意到布料上的體液痕跡，先是一怔，接著滿意得連聲道謝。你還沒催促，他便急忙把衣物妥善收起。<br><br>
                <</if>>
            <<elseif _hmEncounter.stainReaction is "arousal">>
                <<if _hmEncounter.removalVariant is 0>>
                    他看見衣物上明顯的濕痕，原本準備收好衣物的手頓了一下。他低聲問了句什麼，卻又自己搖頭，紅著臉把衣物收好。<br><br>
                <<elseif _hmEncounter.removalVariant is 1>>
                    他將衣物翻過來檢查，目光停在一處尚未乾透的痕跡上，頓時忘了說話。等你提醒，他才匆匆點頭，將衣物仔細收好。<br><br>
                <<else>>
                    他發現衣物上的濕印，神情變得格外專注。他張了張嘴，最後只擠出一句「我會好好收著」，便小心將它放進袋裡。<br><br>
                <</if>>
            <</if>>
        <</if>>
        <<if _hmEncounter.stainReaction is "semen" or _hmEncounter.stainReaction is "arousal">>
            你等他看得差不多了，便提醒他還有約定的報酬尚未付清。<br><br>
        <<else>>
            他檢查完衣物，抬眼看向你，這才想起還有約定的報酬尚未付清。<br><br>
        <</if>>
        對方把約定的<<printmoney _hmPricePennies>>交到你手裡。你收好報酬，交易終於完成。<<if _hmEncounter.stainReaction is not "semen" and _hmEncounter.stainReaction is not "arousal">>他這才將買下的衣物收妥。<</if>><br><br>
        <<if _hmEncounter.buyerOnsite>>
            交易完成後，你重新混入市場的人潮；他則混入人群，繼續在市集裡閒逛。<br><br>
        <<else>>
            你們走回熱鬧的人群。對方朝你點頭致意，隨後各自離開。<br><br>
        <</if>>
    <<elseif _hmEncounter and _hmEncounter.result is "intimate_completed">>
        <<set _hmIntimatePennies to Math.round(Number(_hmEncounter.intimatePrice || 0) * 100)>>收藏家把約定的<<printmoney _hmIntimatePennies>>交給你，滿意地帶著衣物離開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "intimate_interrupted">>
        收藏家收好衣物，這筆額外交易沒有完成，雙方就此分開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "intimate_declined">>
        你婉拒了最後的邀約。收藏家雖然失望，仍然尊重你的決定，帶著衣物離開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "touch_declined">>
        你搖頭表示交易到此為止。他沒有勉強，收好衣物與錢包，向你道別後離開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "touch_unavailable">>
        你們準備繼續時，發現情況已不符合原先談好的條件，只得取消這筆額外交易。他帶著衣物離開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "extension_declined">>
        「剩下的我還要留著。」你搖了搖頭。他雖然有些失望，卻沒有再勸，抱好剛才買下的衣物，向你道別後混入人群。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "extension_unavailable">>
        你正要照約定交出剩下的衣物，卻發現衣著已與剛才談好的不同，只得告訴他這筆追加交易無法繼續。他雖有些失望，仍帶著先前買下的衣物離開。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "overstep_cancel">>
        你決定不再交易，將衣物重新整理好，並告訴他這筆買賣到此為止。對方望著空空的收貨袋，最後只能讓開路。你回到市場的人潮中。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "unavailable">>
        你準備答應時，才發現剛才要出售的衣物已經不在身上。這筆交易只好作罷。<br><br>
    <<else>>
        <<if _hmEncounter.sceneVariant is 0>>
            你搖頭拒絕。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>失望地收起鈔票，還是禮貌地讓開道路，沒有再糾纏。<br><br>
        <<elseif _hmEncounter.sceneVariant is 1>>
            你表示不打算出售。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>張了張嘴，像是想提高價碼，最後卻只是點點頭，把錢放回口袋。<br><br>
        <<else>>
            你乾脆地回絕提議。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>有些尷尬地笑了笑，裝作剛才只是在詢問普通商品，隨即轉身混進人群。<br><br>
        <</if>>
    <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterFoundMoney">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你在人群與攤位之間慢慢穿梭，四周充斥著攤販的叫賣聲與討價還價聲。<br><br>
	<<if _hmEncounter.moneyTier is "jackpot">>走過一個攤位時，你發現地上躺著一只看起來頗為精緻的皮夾。皮夾鼓鼓的，附近人來人往，卻似乎沒有人注意到它。<br><br>
	<<elseif _hmEncounter.moneyTier is "large">>走過一個攤位時，你注意到地上掉了一個錢包。來往的人們似乎都沒有發現，也看不出是誰掉的。<br><br>
	<<else>>走過一個攤位時，幾枚散落在地上的硬幣引起了你的注意。來往的人們似乎都沒有發現它們，也看不出究竟是誰掉的。<br><br><</if>>
	<<link "撿起來" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("take")>>
	<</link>> <span class="gold">金錢+</span> <<lstress>>
<</widget>>

<<widget "HonestMarketsEncounterPickpocket">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	<<if _hmEncounter.stage is "noticed">>
        市場人潮擁擠，你突然察覺有人正從身上偷走錢包。你猛地回頭，扒手已抓著錢包鑽進巷道！<br><br>
        <<link "立刻追上去" "HonestMarkets Encounter Continue">>
            <<run setup.HonestMarkets.resolveMarketEncounter("chase_begin")>>
        <</link>><br>
    <<elseif _hmEncounter.stage is "pickpocket_chase">>
        <<hmChaseView>>
    <<elseif _hmEncounter.stage is "caught">>
		你終於追上逃跑的扒手，趁對方還沒來得及再次鑽進人群，一把抓住了對方的手腕，攔住去路。<br><br>
		<<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>猛地踉蹌了一下，隨即用力試圖掙脫你的控制。對方不安地環顧四周，似乎還在尋找逃跑的機會。<br><br><<else>>扒手猛地踉蹌了一下，隨即用力試圖掙脫你的控制，目光不斷掃向周圍，似乎還在尋找逃跑的機會。<br><br><</if>>
		<<link "拿回自己的東西" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("recover")>>
		<</link>> <<llstress>><br>
		<<link "放對方一馬" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("release")>>
		<</link>> <<lstress>><br>
		<<link "威脅對方把身上的錢也交出來" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("extort")>>
		<</link>> <span class="gold">金錢+</span> <<llstress>> <span class="red">犯罪+</span>
	<<else>>
		市場裡的人群比平常更加擁擠。你被來往的客人推著向前走，直到離開最擁擠的地方，才隱約感覺自己的口袋似乎有些不對勁。<br><br>
		你伸手一摸，心裡頓時一沉。原本放在身上的錢已經少了一些。<br><br>
		等你回頭望向身後密密麻麻的人群時，早已分辨不出究竟是誰動了手。<br><br>
		<<link "算了" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("lost")>>
		<</link>> <span class="red">金錢-</span> <<gggstress>>
	<</if>>
<</widget>>

<<widget "HonestMarketsEncounterCrowdGrope">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	<<if _hmEncounter.stage is "further">>
		你沒有立刻阻止對方。<br><br>
		身後的人似乎把你的沉默當成了默許。原本短暫的碰觸沒有消失，那隻手反而更加肆無忌憚地在你身上游移。周圍的人群依舊忙著挑選商品，沒有人注意到發生在你們之間的事情。<br><br>
		<<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>緊貼在你身後，藉著擁擠的人潮遮掩自己的動作。<br><br><</if>>
		<<link "繼續忍受" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("endure_more")>>
		<</link>> <<ggstress>>
		<<ggarousal>>
		<<gtrauma>><br>
		<<link "把對方推開" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("push")>>
		<</link>> <<lstress>><br>
		<<link "轉身賞對方一巴掌" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("slap")>>
		<</link>> <<llstress>>
		<<gpain>>
	<<else>>
		市場裡到處都是來往的人群。當你從兩個攤位之間穿過時，身後忽然又擠上來一群人，迫使你放慢腳步。<br><br>
		起初你只以為是普通的推擠。直到一隻手刻意貼上你的身體，在上面停留得遠比意外碰觸應有的時間，你才意識到有人正在趁亂佔你的便宜。<br><br>
		<<if $NPCList and $NPCList[0]>>你側過視線，看見<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>正若無其事地跟在你身旁。<br><br><</if>>
		<<link "忍受" "HonestMarkets Encounter Continue">>
			<<run setup.HonestMarkets.resolveMarketEncounter("endure")>>
		<</link>> <<ggstress>>
		<<garousal>><br>
		<<link "把對方推開" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("push")>>
		<</link>> <<lstress>><br>
		<<link "賞對方一巴掌" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("slap")>>
		<</link>> <<llstress>>
		<<gpain>>
	<</if>>
<</widget>>

<<widget "HonestMarketsEncounterClothierOffer">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<honestMarketsEncounterDebug>>
    <<if _hmEncounter and _hmEncounter.id is "suspicious_clothier">>
        <<if _hmEncounter.stage is "confrontation">>
            試衣間外傳來兩下敲門聲。你還沒來得及回答，門簾便被人一把掀開。<br><br>
            <<if _hmEncounter.trialReaction is "ask_price">>
                「價錢？你還真有心情問這個。」小販擠進狹窄的空間，目光在你身上停留得過久，隨手拉好身後的門簾。
            <<else>>
                「怎麼這麼快就想換回去？我可還沒看夠呢。」小販擠進狹窄的空間，擋住你走向門簾的路。
            <</if>><br><br>
            你伸手想掀開門簾，對方卻搶先一步擋在出口。矮凳被碰得歪向一旁，外頭的叫賣聲隔著布簾傳來，彷彿誰也沒有留意這裡的動靜。<br><br>
            「別急著走嘛，」小販壓低聲音，笑意卻令人不舒服，「難得有這麼合我眼緣的客人。」<br><br>
            你意識到這根本不是普通的試穿邀請。<br><br>
            <<link "推開小販，設法脫身" "HonestMarkets Clothier Combat">>
                <<run setup.HonestMarkets.resolveMarketEncounter("resist")>>
                <<set $sexstart to 1>>
            <</link>>
        <<elseif _hmEncounter.stage is "initial">>
            你正沿著服裝攤位慢慢挑選，忽然有人從旁邊探出身來，熱情地朝你招手。<br><br>
            「欸，等等！我這裡剛好有件衣服，感覺特別適合你。」小販從衣架後取出一件衣物，熟練地抖開，像是在展示什麼難得的好貨。<br><br>
            對方拿出的是「<<print setup.HonestMarkets.clothingDisplayName(setup.clothes[_hmEncounter.slot][_hmEncounter.index])>>」。<br><br>
            「先試試，不收錢。後頭有個小隔間，換好再出來照鏡子就行。」小販笑著指向攤位深處。<br><br>
            這份突如其來的殷勤讓你有些在意。隔間藏在一排掛滿衣服的架子後面，從外頭幾乎看不見裡頭。<br><br>
            <<link "接受免費試穿" "HonestMarkets Clothier Trial">>
                <<run setup.HonestMarkets.resolveMarketEncounter("try")>>
            <</link>><br>
            <<link "婉拒邀請，繼續逛街" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
            <</link>>
        <<else>>
            <<link "繼續" "HonestMarkets Encounter Continue">><</link>>
        <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterClothierResult">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter and _hmEncounter.result is "refused">>
        「真可惜，我還以為你會更有意思呢。」小販嘴上這麼說，臉上的笑容卻很快淡了下去。<br><br>
        你沒有停下腳步。走出幾個攤位後再回頭，那人已經轉而招呼別的客人，彷彿剛才什麼事也沒發生。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "trial_failed">>
        你試著換上那件衣服，卻發現怎麼也沒辦法順利穿好。小販在門外不耐煩地催促了幾句，最後只得把衣服收回去。<br><br>
        「算了算了，下次再說吧。」對方的語氣突然冷淡許多。你離開隔間，重新回到熱鬧的市場。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "confiscated">>
        你沒能擺脫小販的糾纏。對方趁你無力阻止時，將剛才借你試穿的衣服收了回去。<br><br>
        「免費試穿，可沒說免費送你。」小販把衣物抱在手裡，若無其事地整理起被撞歪的衣架。<br><br>
        你匆忙離開那個狹窄的隔間，身上只剩下未被拿走的衣物。市場依舊吵鬧，沒有人知道剛才發生了什麼。<br><br>
    <<elseif _hmEncounter and _hmEncounter.result is "escaped">>
        你終於抓住空隙衝出隔間。身後傳來小販惱怒的叫喊，卻很快淹沒在市場此起彼落的叫賣聲裡。<br><br>
        你低頭看了看身上的衣服——剛才試穿的那件還在。小販沒有追上來，而你也不打算回頭。<br><br>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterFlashSale">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你從一個攤位旁經過，身後忽然傳來一陣急促的招呼聲。<br><br>
	「等等、等等！先別走！」攤販一邊說，一邊拍了拍旁邊堆得滿滿的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」。「今天剩得有點多，我可不想收攤時還得把這些全搬回去。」<br><br>
	對方用手指敲了敲攤面，把聲音壓低了一些。<br><br>
	「你要的話，這批最多給你 <<print _hmEncounter.offerQty>> 份，一份算 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>。出了這個攤位，可別回頭跟我要同樣的價。」<br><br>
	原本的單件報價約是 <<print setup.HonestMarkets.moneyText(_hmEncounter.normalPrice)>>。這確實便宜了不少。<br><br>
	<<set _hmLabel to "能買多少就買多少（每份 " + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
	<<link _hmLabel "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
	<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
	<<link "不用了" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("decline")>>
	<</link>>
<</widget>>

<<widget "HonestMarketsEncounterMarketRumor">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你從兩個攤位之間穿過時，旁邊幾名提著購物袋的客人正聊得起勁。你本來沒有打算偷聽，直到<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」的名字飄進耳裡。<br><br>
	<<if _hmEncounter.trend is "low">>「今天這東西便宜得有點反常。」其中一人壓低聲音，「我剛才問了兩攤，價錢都比平常好看。要買的話，今天大概正是時候。」<br><br>
	<<elseif _hmEncounter.trend is "high">>「今天最好別急著買。」其中一人搖了搖頭，「不知道哪裡出了問題，幾個攤位都把價錢抬上去了。除非真的缺，不然我會再等等。」<br><br>
	<<else>>「這東西今天倒沒什麼好說的。」其中一人聳聳肩，「問了幾攤，價錢都差不多。既沒撿到便宜，也不算被坑。」<br><br><</if>>
	幾人的談話沒有刻意避著旁人，內容清楚地傳進你的耳裡。<br><br>
	<<link "記下這條情報" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("listen")>>
	<</link>> <<lstress>>
<</widget>>

<<widget "HonestMarketsEncounterShortMeasure">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	<<if _hmEncounter.stage is "corrected">>
		攤販盯著你看了兩秒，嘴角抽了一下。<br><br>
		「行、行，你眼睛真利。」對方把原本包好的貨重新拆開，當著你的面把缺掉的分量一份份補回去。「<<print _hmEncounter.claimedQty>> 份就是 <<print _hmEncounter.claimedQty>> 份，這次總行了吧？」<br><br>
		重新算過後，<<print _hmEncounter.claimedQty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」一共 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>。<br><br>
		<<set _hmLabel to "照正常分量買下（" + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
		<<link _hmLabel "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("buy_corrected")>>
		<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span> <<lstress>><br>
		<<link "算了，不跟這攤做生意" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
		<</link>>
	<<else>>
		「這一包算你 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>，便宜吧？」一名攤販見你經過，立刻提起一大包<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」朝你晃了晃，嘴上說裡頭足足有 <<print _hmEncounter.claimedQty>> 份。<br><br>
		價錢聽起來確實不壞，可那沉甸甸的一包怎麼看都不像真有 <<print _hmEncounter.claimedQty>> 份的分量。<br><br>
		對方笑著把整包商品推到你面前，等著你的回答。<br><br>
		<<set _hmLabel to "直接買下（" + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
		<<link _hmLabel "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
		<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span> <<gstress>><br>
		<<link "指出分量不對" "HonestMarkets Encounter Continue">>
			<<run setup.HonestMarkets.resolveMarketEncounter("question")>>
		<</link>><br>
		<<link "不買了" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
		<</link>>
	<</if>>
<</widget>>

<<widget "HonestMarketsEncounterHotItem">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	前方忽然傳來一陣比平常更吵的議論聲。你經過時，看見幾名客人正圍著同一個攤位，目光全落在<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」上。<br><br>
	「後面的別擠！一個一個來！」攤販一邊收錢，一邊朝周圍喊著還剩最後幾份。攤上的存貨正以肉眼可見的速度減少。<br><br>
	如果你也想要，就得現在跟著人群一起搶。單件價格是 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>；再過一會兒，恐怕就會被其他客人掃得所剩無幾。<br><br>
	<<link "加入搶購（00:05）" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
	<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
	<<link "不參與搶購" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("yield")>>
	<</link>> <span class="red">市場庫存-</span>
<</widget>>

<<widget "HonestMarketsEncounterLostProperty">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你在攤位旁避開迎面而來的人時，鞋尖碰到了什麼。低頭一看，一份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」正孤零零地躺在地上，包裝上還沾著一點灰。<br><br>
	附近沒有哪個攤販在招呼你，也沒有人立刻彎腰尋找。看樣子，它多半是某個客人剛買完後不小心掉下的。<br><br>
	你環顧四周。市場裡人來人往，要找到失主未必容易；但直接把它塞進自己的袋子裡，意思也很明白。<br><br>
	<<link "收進自己的袋子" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("keep")>>
	<</link>> <span class="green">物品+</span> <span class="red">犯罪+</span><br>
	<<link "交給附近的攤販代為保管" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("return")>>
	<</link>> <<lstress>>
<</widget>>

<<widget "HonestMarketsEncounterMistakenRegular">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你從一個攤位旁經過時，攤販忽然抬起頭，眼睛一亮。<br><br>
	「哎，你今天總算來了！」對方熟門熟路地抓起 <<print _hmEncounter.qty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」，連問都沒問便開始替你包起來。「還是老樣子，算你 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>。」<br><br>
	你愣了一下。你很確定自己從沒跟這個人買過東西。對方大概把你認成了某個熟客，而且給出的整批價錢還比正常報價 <<print setup.HonestMarkets.moneyText(_hmEncounter.normalPrice)>> 低了一截。<br><br>
	攤販已經把包好的東西遞到你面前，完全沒有察覺自己認錯了人。<br><br>
	<<set _hmLabel to "順勢買下（" + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
	<<link _hmLabel "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
	<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
	<<link "提醒對方認錯人了" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("correct")>>
	<</link>> <<lstress>>
<</widget>>

<<widget "HonestMarketsEncounterPushyVendor">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	<<if _hmEncounter.stage is "haggled">>
		你沒有接下那一大包商品，反而把整批價錢往下壓。攤販起初還連連搖頭，嘴裡念著「這價我連本都回不了」，可當你真的轉身要走時，對方立刻改了口風。<br><br>
		「好啦！算你會買。」攤販一把拉住你，把 <<print _hmEncounter.qty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」重新推過來。「整批 <<print setup.HonestMarkets.moneyText(_hmEncounter.price)>>，不能再低了。」<br><br>
		<<set _hmLabel to "成交（" + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
		<<link _hmLabel "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
		<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
		<<link "還是不要" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
		<</link>> <<gstress>>
	<<elseif _hmEncounter.stage is "haggled_fail">>
		你試著把價錢壓下來，攤販卻像早就料到你會這麼說似地抱起雙臂。<br><br>
		「少來，我今天已經給得夠便宜了。」對方把整包商品往自己這邊收了一點，又故意停住。「<<print _hmEncounter.qty>> 份，<<print setup.HonestMarkets.moneyText(_hmEncounter.askingPrice)>>。要就拿，不要就別耽誤我做生意。」<br><br>
		<<set _hmLabel to "照原價買（" + setup.HonestMarkets.moneyText(_hmEncounter.askingPrice) + "）(00:05)">>
		<<link _hmLabel "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
		<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
		<<link "轉身離開" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
		<</link>> <<gstress>>
	<<else>>
		「喂！看看這個！」<br><br>
		你甚至還沒真正停下腳步，一名攤販已經抱起一大包<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」堵到你面前。你往左挪一步，對方也跟著往左；你往右，那包貨又擋到了面前。<br><br>
		「一次拿 <<print _hmEncounter.qty>> 份，整批 <<print setup.HonestMarkets.moneyText(_hmEncounter.askingPrice)>> 給你。別去別家問了，他們哪有我這裡實在？」<br><br>
		你瞥了一眼。照這批商品原本的行情，<<print _hmEncounter.qty>> 份正常大約只值 <<print setup.HonestMarkets.moneyText(_hmEncounter.normalPrice)>>。這人顯然是看準你停下來了，打算一次多塞一批貨給你，順便多賺一筆。<br><br>
		<<set _hmLabel to "懶得爭，整批買下（" + setup.HonestMarkets.moneyText(_hmEncounter.askingPrice) + "）(00:05)">>
		<<link _hmLabel "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
		<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
		<<link "跟對方殺價" "HonestMarkets Encounter Continue">>
			<<run setup.HonestMarkets.resolveMarketEncounter("haggle")>>
		<</link>><br>
		<<link "叫對方別再纏著你" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
		<</link>> <<gstress>>
	<</if>>
<</widget>>

<<widget "HonestMarketsEncounterVendorGift">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你在一個攤位前多停留了一會兒。攤販注意到你的視線，順手從攤位上拿起一份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」，朝你遞了過來。<br><br>
	「這個送你吧，不收錢。」<br><br>
	看來對方只是想送你一份商品，或許也希望你下次還會再來逛逛。<br><br>
	<<link "收下" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
	<</link>> <span class="green">物品+</span> <<lstress>><br>
	<<link "婉拒" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("decline")>>
	<</link>> <span class="grey">無狀態變化</span>
<</widget>>

<<widget "HonestMarketsEncounterFoundMoneyResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.moneyTier is "jackpot">>你撿起皮夾，打開後發現裡面竟然塞著厚厚一疊鈔票，數了數才意識到這是一筆驚人的金額。你在原地等了一會兒，始終沒有人回頭尋找。<br><br>你把皮夾收好，帶著這筆意外之財繼續逛起市場。<br><br>
	<<elseif _hmEncounter.moneyTier is "large">>你彎腰撿起錢包，打開一看，裡面裝著不少鈔票，金額比預想中多得多。你等了一會兒，始終沒有人回頭尋找。<br><br>你把錢包收進口袋，帶著這份意外收穫繼續逛起市場。<br><br>
	<<else>>你彎腰把散落的零錢撿了起來，又等了一會兒。始終沒有人回頭尋找它們。<br><br>你把錢收進口袋，帶著這份意外的小收穫繼續逛起市場。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterPickpocketResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.action is "chase_escaped">>你追著扒手穿過曲折的巷道，最後仍失去了對方的蹤影。你摸了摸口袋，錢包裡的錢已經被帶走。<br><br>
    <<elseif _hmEncounter.action is "lost">>你重新數了一遍身上的錢，確認確實少了一些。<br><br>你不甘心地在人群裡搜尋了一陣，但每個從身旁經過的人看起來都同樣可疑。扒手早已不知道鑽到哪裡去了。<br><br>
	<<elseif _hmEncounter.action is "extort">>你沒有立刻鬆開對方的手腕，反而把人往自己面前拉近了一點。<br><br>「既然敢偷我的東西，就別以為把東西還回來便算了。」<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的表情頓時變得難看。對方瞥了一眼周圍的人群，顯然不希望事情鬧大，只得先歸還被偷走的錢，再不情願地掏出額外的補償塞給你。<br><br><<else>>對方的表情頓時變得難看，最後只得歸還被偷走的錢，並不情願地另外拿出一筆補償塞給你。<br><br><</if>>你這才鬆開手。對方立刻鑽進人群，很快便消失得無影無蹤。<br><br>
	<<elseif _hmEncounter.action is "recover">>你從對方手裡拿回錢包，重新清點被偷走的現金，確認已全數取回。<br><br><<if $NPCList and $NPCList[0]>>你鬆開<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手腕。對方沒有再多說一句話，立刻轉身鑽進人群。<br><br><<else>>你鬆開對方的手腕。扒手立刻轉身鑽進人群。<br><br><</if>>被偷走的錢已經全數拿回，你總算鬆了一口氣。<br><br>
	<<else>>你先從扒手手中取回錢包和被偷走的現金，確認全數取回後，決定不再追究，最終鬆開了手。<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>似乎有些意外，但沒有浪費這個機會，立刻轉身擠進人群。幾個呼吸之後，你便再也找不到對方的身影。<br><br><<else>>對方似乎有些意外，隨即轉身擠進人群，很快消失不見。<br><br><</if>>
	<</if>>
<</widget>>

<<widget "HonestMarketsEncounterCrowdGropeResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "escalate">>你的反應並沒有讓對方收斂。<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>反而藉著四周人群的遮掩逼得更近，幾乎不再掩飾自己的意圖。你試著拉開距離，對方卻緊跟著你不放。<br><br><<else>>對方反而藉著四周人群的遮掩逼得更近，幾乎不再掩飾自己的意圖。<br><br><</if>>事情顯然已經不是單純忍一忍就能結束的了。<br><br><<link "掙扎" "HonestMarkets Combat">>
			<<set $honestMarketsCombatSource to "crowd_grope">>
			<<set $honestMarketsCombatConsensual to 0>>
			<<set $sexstart to 1>>
			<<run setup.HonestMarkets.clearMarketEncounter()>>
		<</link>><br><br>
	<<elseif _hmEncounter.result is "angry">>清脆的巴掌聲甚至蓋過了附近攤販的叫賣聲。幾個路人下意識地朝你們看了過來。<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>捂著被打的地方，惱怒地瞪著你。對方嘴裡低聲咒罵了幾句，但在注意到周圍投來的目光後，終究沒有再靠近。<br><br><<else>>對方惱怒地瞪著你，嘴裡低聲咒罵了幾句，但在注意到周圍投來的目光後，終究沒有再靠近。<br><br><</if>>對方很快退進人群，只留下幾道好奇的視線。<br><br>
	<<elseif _hmEncounter.action is "push">>你猛地轉身把對方推開。突如其來的反抗讓對方踉蹌了一下。<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>看了你一眼，似乎在衡量是否值得繼續糾纏。最後，對方還是收回了手，若無其事地混進周圍的人群。<br><br><<else>>對方看了你一眼，最後還是收回了手，若無其事地混進周圍的人群。<br><br><</if>>
	<<elseif _hmEncounter.action is "slap">>你轉過身，毫不猶豫地一巴掌甩了過去。<br><br>清脆的聲響讓附近幾個人停下腳步。你的手掌也被震得有些發疼，但胸口積著的火氣總算消散了一些。<br><br><<if $NPCList and $NPCList[0]>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>愣了一瞬，隨後在周圍人的注視下退開，很快消失在人群裡。<br><br><<else>>對方愣了一瞬，隨後在周圍人的注視下退開，很快消失在人群裡。<br><br><</if>>
	<<elseif _hmEncounter.action is "endure_more">>你依舊沒有阻止對方，只能任由那隻手繼續在你身上游移。<br><br>過了一會兒，周圍的人群逐漸散開。失去了人潮的掩護，對方終於收回手，裝作什麼也沒有發生似地離開了。<br><br>
	<<else>>對方似乎失去了繼續糾纏的興趣。隨著人群再次向前移動，那隻手終於從你身上離開。<br><br>等你回頭時，對方已經混進了市場的人潮之中。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterFlashSaleResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "bought">>你把錢遞過去，攤販像怕你反悔似地飛快收下，接著一口氣替你整理出 <<print _hmEncounter.boughtQty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」。總共花了 <<print setup.HonestMarkets.moneyText(_hmEncounter.totalPrice)>>。<br><br>「成交！總算少一批要搬回去了。」對方滿意地看著明顯空下來一些的攤位，又轉頭繼續招呼客人。<br><br><<elseif _hmEncounter.result is "cannot_buy">>你伸手摸了摸身上的錢，最後還是把手收了回來。這筆臨時特價再便宜，現在也連一份都買不下來。攤販見狀聳聳肩，很快又開始物色下一個願意幫忙清貨的客人。<br><br><<else>>你搖頭拒絕。攤販「嘖」了一聲，也沒有糾纏，只拍了拍身旁剩下的那堆貨。「那就算啦，總會有人願意多拿幾份。」<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterMarketRumorResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>你沒有插話，只把剛才聽見的內容默默記了下來。<br><br><<if _hmEncounter.trend is "low">>至少今天看到<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」時，你知道目前的行情確實偏低。<br><br><<elseif _hmEncounter.trend is "high">>至少今天看到<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」時，你知道目前的行情確實偏高。<br><br><<else>>至少今天的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」沒有明顯偏離一般行情。<br><br><</if>>市場裡的閒談未必句句可靠，但多聽幾句總比什麼都不知道好。<br><br>
<</widget>>

<<widget "HonestMarketsEncounterShortMeasureResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "cheated">>你付了錢，把那一大包<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」拿到手裡。真正整理時，你才確定剛才的直覺沒有錯——說好的 <<print _hmEncounter.claimedQty>> 份，裡頭實際只有 <<print _hmEncounter.actualQty>> 份。少掉的可不是一點零頭。<br><br>等你回頭時，攤販已經忙著招呼別人，臉上的笑容跟剛才一模一樣。<br><br><<elseif _hmEncounter.result is "corrected_buy">>你當著攤販的面重新確認過分量，這次確實是完整的 <<print _hmEncounter.claimedQty>> 份。對方收錢時一直避開你的視線，動作倒比剛才老實多了。<br><br><<elseif _hmEncounter.result is "denied">>攤販臉色一沉，直接把貨收了回去。「不買就別亂說，我做生意從來都是這個分量。」<br><br>周圍已經有人朝這邊看過來。對方顯然不打算承認，你也沒必要為這包東西繼續耗下去。<br><br><<elseif _hmEncounter.result is "cannot_buy">>談到最後，你才發現身上的錢不足以完成這筆交易。攤販不耐煩地把整包商品收回去，嘴裡還嘀咕了幾句。<br><br><<else>>你看了看那包分量可疑的商品，最後還是轉身離開。攤販在身後喊了兩句，見你沒有回頭，很快又把同樣的笑容轉向下一名客人。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterHotItemResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "bought">>你跟著人群擠到攤位前，趁著還有貨時一口氣搶到了 <<print _hmEncounter.playerTake>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」，總共花了 <<print setup.HonestMarkets.moneyText(_hmEncounter.totalPrice)>>。<br><br>等你抱著東西從人群裡退出來時，其他客人仍在不停伸手拿貨，轉眼又掃走了 <<print _hmEncounter.crowdTake>> 份。<<if _hmEncounter.remainingQty gt 0>>最後攤上只剩 <<print _hmEncounter.remainingQty>> 份，方才堆著的存貨幾乎被搬空。<<else>>等人群稍微散開，攤位上已經一份都不剩了。<</if>><br><br>
	<<elseif _hmEncounter.result is "cannot_buy">>你本想趁還有貨時擠進去搶幾份，摸了摸身上的錢後卻只能停下腳步。就在你猶豫的這點時間裡，其他客人已經掃走了 <<print _hmEncounter.crowdTake>> 份。<<if _hmEncounter.remainingQty gt 0>>等人群稍微散開，攤上只剩 <<print _hmEncounter.remainingQty>> 份。<<else>>等人群稍微散開，攤位上已經一份都不剩了。<</if>><br><br>
	<<else>>你退到一旁，沒有加入搶購的人群。幾名客人立刻補上你讓出的空位，沒多久便有 <<print _hmEncounter.crowdTake>> 份商品從攤上消失。<<if _hmEncounter.remainingQty gt 0>>等這波人潮散開，原本的存貨只剩 <<print _hmEncounter.remainingQty>> 份。<<else>>等這波人潮散開，攤位已經被掃得乾乾淨淨。<</if>><br><br>市場從來不會特地替誰把貨留下來。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterLostPropertyResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "kept">>你等了一小會兒，確認沒有人正看著這邊，便彎腰撿起<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」，若無其事地收進自己的袋子。<br><br>失主或許很快就會發現東西不見了，但那時候你大概早已走到市場另一頭。<br><br><<else>>你把撿到的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」交給附近的攤販，說明是在地上發現的。<br><br>「行，放我這吧。有人回頭找，我就還他。」對方把東西擱到攤位後方，又朝你點了點頭。<br><br>至少接下來該怎麼處理，不再需要你操心了。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterMistakenRegularResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "bought">>你沒有糾正對方，只是把錢遞了過去。攤販笑著收下，還熟稔地說了句「下次再來」，彷彿你們真的已經做過很多次生意。<br><br>你提著便宜買到的 <<print _hmEncounter.qty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」離開攤位。至於真正的那位熟客下次來時會不會覺得價錢不對，那就是另一回事了。<br><br><<elseif _hmEncounter.result is "cannot_buy">>這個誤會帶來的價錢確實誘人，可你現在還是付不起。你只得把商品推回去，攤販露出有些困惑的表情。<br><br><<else>>「你大概認錯人了，我以前沒來過。」<br><br>攤販愣了好一會兒，湊近又看了你兩眼，接著猛地拍了一下額頭。「哎呀！還真不是！」<br><br>對方尷尬地把商品收回去，你則帶著一點哭笑不得的心情離開攤位。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterPushyVendorResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "bought">>攤販接過錢，剛才還寸步不讓的表情立刻變成了笑臉。「這就對了嘛，我一看就知道你識貨。」<br><br>你只好把整整 <<print _hmEncounter.qty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」收好。無論最後這價錢算不算漂亮，至少對方總算不再抱著那一大包貨堵你的路。<br><br><<elseif _hmEncounter.result is "cannot_buy">>話都說到這裡了，你卻拿不出足夠買下整批貨的錢。攤販的熱情瞬間消失大半，把那一大包商品往回一收，轉身便開始招呼下一個看起來更有購買力的客人。<br><br><<else>>你明確拒絕後，攤販還抱著那包貨追著念了幾句，直到發現你真的沒有回頭的意思，才終於停下腳步。<br><br>身後很快又傳來同一句精神十足的叫賣聲——顯然下一個路人已經成了新的目標。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterVendorGiftResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.action is "accept">>你接過攤販送來的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」，把這份意外得到的商品收好。<br><br>攤販朝你揮了揮手，很快又繼續忙起自己的生意。<br><br><<else>>你笑著擺了擺手，謝過攤販的好意。<br><br>對方也沒有強求，把商品放回攤位後便繼續招呼其他客人。<br><br><</if>>
<</widget>>

<<widget "HonestMarketsEncounterDroppedGoods">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>
	你從攤位旁經過時，肩膀不慎擦到突出來的貨架。<<print _hmEncounter.damaged>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」頓時滾落在地，攤販立刻轉過頭盯著你。<br><br>
	「喂！這可是要賣的！」對方按目前行情算了算，要求你賠 <<print setup.HonestMarkets.moneyText(_hmEncounter.compensation)>>。<br><br>
	<<link "賠償" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("pay")>>
	<</link>> <span class="gold">金錢-</span> <<lstress>><br>
	<<link "否認是自己碰倒的" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("deny")>>
	<</link>> <<ggstress>><br>
	<<crimeicon "mark">>
	<<link "掀翻旁邊的攤位，趁亂開溜" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("smash")>>
	<</link>> <<lllstress>> <span class="red">犯罪+</span>
<</widget>>
<<widget "HonestMarketsEncounterQueueJumper">>
	<<honestMarketsEncounterDebug>>一個攤位前擠滿了等著看商品的客人。你從旁邊經過時，一名顧客突然從後方擠上來，硬是把你撞到一旁，搶到了人群前面。對方甚至沒有回頭看你一眼。<br><br>
	<<link "算了" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("ignore")>>
	<</link>> <<gstress>><br>
	<<link "指責對方硬擠" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("argue")>>
	<</link>><br>
	<<link "把對方擠回去" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("push")>>
	<</link>> <<llstress>>
	<<gpain>>
<</widget>>
<<widget "HonestMarketsEncounterMarketArgument">>
	<<honestMarketsEncounterDebug>>前方一個攤位忽然傳來激烈的爭吵聲。顧客堅稱攤販開價前後不一，攤販則反過來指責對方胡攪蠻纏，周圍很快圍了一圈看熱鬧的人。<br><br>
	<<link "留下來看熱鬧 (00:05)" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("watch")>>
	<</link>><br>
	<<link "試著勸開雙方 (00:05)" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("mediate")>>
	<</link>><br>
	<<link "繞開人群" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
	<</link>>
<</widget>>
<<widget "HonestMarketsEncounterBeggar">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>一名衣著寒酸的陌生人在人群邊緣攔住你，小聲問你能不能分一點零錢。<br><br>
	<<link "給 £10" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("give10")>>
	<</link>> <span class="gold">金錢-£10</span> <<lstress>><br>
	<<link "給 £50" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("give50")>>
	<</link>> <span class="gold">金錢-£50</span> <span class="green">壓力--</span><br>
	<<link "給 £100" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("give100")>>
	<</link>> <span class="gold">金錢-£100</span> <span class="green">壓力---</span><br>
	<<link "拒絕" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
	<</link>>
<</widget>>
/* 街頭藝人：僅顯示選項，所有狀態與金錢結算都由事件 resolve() 執行。 */
<<widget "HonestMarketsEncounterStreetPerformer">>
    <<honestMarketsEncounterDebug>>市場的一角傳來悠揚的樂聲。一名街頭藝人正在路邊演奏，面前擺著一頂盛著零錢的帽子。幾名路人停下腳步，靜靜欣賞表演。<br><br>
    <<link "駐足觀看 (00:05)" "HonestMarkets Encounter Result">>
        <<run setup.HonestMarkets.resolveMarketEncounter("watch")>>
    <</link>> <<lstress>><br>
    <<link "打賞 £10 (00:05)" "HonestMarkets Encounter Result">>
        <<run setup.HonestMarkets.resolveMarketEncounter("tip10")>>
    <</link>> <span class="gold">金錢-£10</span> <span class="green">壓力--</span><br>
    <<link "打賞 £50 (00:05)" "HonestMarkets Encounter Result">>
        <<run setup.HonestMarkets.resolveMarketEncounter("tip50")>>
    <</link>> <span class="gold">金錢-£50</span> <span class="green">壓力---</span><br>
    <<link "打賞 £100 (00:05)" "HonestMarkets Encounter Result">>
        <<run setup.HonestMarkets.resolveMarketEncounter("tip100")>>
    <</link>> <span class="gold">金錢-£100</span> <span class="green">壓力----</span><br>
    <<link "直接離開" "HonestMarkets Encounter Result">>
        <<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
    <</link>>
<</widget>>
/* 街頭按摩師（v0.5.16.1）：劇情與差分集中於此。
 * introVariant／touchVariant／responseVariant／stageVariant 為各自的既有隨機差分。
 * 主動路線 encourageScene 則為「三幕開場＋正文」共用指針，請勿在 Twee 重新抽選。
 * 若新增完整三幕 case，須同步更新 JS 的 STREET_MASSEUR_ENCOURAGE_SCENE_COUNT。
 * 濕潤判定只反映當下 $vaginaWetness；不要假設隨劇情逐幕增加。
 */
<<widget "HonestMarketsEncounterStreetMasseur">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<honestMarketsEncounterDebug>>
    <<if _hmEncounter.stage is "initial">>
        <<switch _hmEncounter.introVariant>>
            <<case 0>>市場角落放著一張可調整椅背的按摩椅。按摩師把毛巾搭在椅背上，見你經過便招手：「走累了吧？坐下來試試。」
            <<case 1>>一排攤位之間擺著按摩椅和小桌，桌上整齊排著毛巾。按摩師剛送走一位客人，轉身看見你，便拍了拍椅面，介紹十五分鐘的服務。
            <<case 2>>「肩膀僵硬嗎？」按摩師從椅旁起身，將扶手調到合適的高度，示意你坐下。周圍的叫賣聲此起彼落，小攤位卻顯得格外悠閒。
        <</switch>><br><br>
        <<switch _hmEncounter.exposureReaction>>
            <<case 1>>他的目光在你的衣著上停留了一瞬，才重新露出招攬客人的笑容。<br><br>
            <<case 2>>他注意到你身上較為暴露的地方，視線稍稍停頓，接著比剛才更熱切地邀請你坐下。<br><br>
            <<case 3>>看見你一絲不掛地走近，他明顯愣了一下，隨即掩不住興致，連招呼你的語氣都變得格外積極。<br><br>
        <</switch>>
        一次 £50，約十五分鐘。<br><br>
        <<link "接受按摩（£50，00:15）" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("start")>><</link>> <span class="gold">金錢-£50</span><br>
        <<link "婉拒離開" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("leave")>><</link>>
    <<elseif _hmEncounter.stage is "touch_choice">>
        你依照指示坐好，按摩師將一條毛巾墊在椅背上，先用掌根按住僵硬的肩膀，再沿著背部緩緩推揉。起初力道恰到好處，附近的叫賣聲也漸漸成了背景。你正要放鬆，他的手卻偏離了原先的按摩範圍。<br><br>
        <<if _hmEncounter.targetBody is "chest">>
            <<switch _hmEncounter.touchVariant>>
                <<case 0>>他扶住你的肩膀讓你坐直，另一隻手卻從肩前滑下，擦過你的<<chestsimple>>。你猛地一僵，他已經收回手，彷彿只是調整坐姿。
                <<case 1>>他站到椅子側邊，示意你稍微轉身。手指在肩前來回按揉時，接連掠過你的<<chestsimple>>；你抬眼看他，他卻只問力道是否合適。
                <<case 2>>「前面也有肌肉連著肩膀。」他一邊解釋，一邊把手放到你的<<chestsimple>>附近，停得比正常按摩更久。你發現他正留意你的表情。
            <</switch>>
        <<else>>
            <<switch _hmEncounter.touchVariant>>
                <<case 0>>按摩師扶住椅背，沿腰側往下推揉，手指卻越過腰際碰到你的<<bottomsimple>>。你回過頭，他立即把手移回背部。
                <<case 1>>他要你稍微前傾，手掌從腰側往下按壓，卻一次次偏向你的<<bottomsimple>>。每次你想轉頭，他又恢復正常的按揉節奏。
                <<case 2>>「站久了這附近也會痠。」按摩師在你身後蹲低一些，手掌停在你的<<bottomsimple>>旁，像是在等你開口反對。
            <</switch>>
        <</if>><br><br>
        你知道這不是原先說好的按摩。你心裡一緊：究竟是立刻制止，還是先看看他會不會自己收手？<br><br>
        <<link "拍開他的手，直接站起來" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("stop")>><</link>> <<gstress>><br>
        <<link "盯著他，要求只做正常按摩" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("warn")>><</link>><br>
        <<link "裝作沒發現，看看他還想做什麼" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("ignore")>><</link>> <<garousal>><br>
        <<if hasSexStat("exhibitionism", 4)>>
            <<link "回頭說清楚你願意接受的範圍" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("encourage")>><</link>> <<ggarousal>><br>
        <</if>>
    <<elseif _hmEncounter.stage is "ignore_stage">>
        /* 完整場景隨機差分：每次進入階段由 JS 固定抽選一次 */
        <<if _hmEncounter.ignoreStage is 1>>
            <<switch _hmEncounter.stageVariant>>
                <<case 0>>
                    按摩師的手重新回到肩頭。你剛以為先前只是誤會，他便俯身替你調整坐姿，手掌又擦過不該碰到的位置。你抓緊扶手，回頭看他；他卻先一步問：「這個角度會不會比較舒服？」你張了張嘴，最後只擠出一句「還好」。明明想質問，卻連自己都說不清為什麼沒開口。
                <<case 1>>
                    旁邊攤位的叫賣聲蓋過了椅腳移動的聲響。按摩師站到你的側後方，手掌沿著背部慢慢移動，偏偏在靠近腰際時失了準頭。你往前挪了一寸，他立即停下：「弄痛你了？」那副關切的模樣讓你一時不知道怎麼回答。是你太敏感，還是他根本在等你抗議？
                <<case 2>>
                    「肩膀放鬆。」他輕聲提醒。你照做，卻又感到那隻手短暫越過原本的按摩範圍。你猛地挺直背，椅背發出細微的聲響。按摩師若無其事地將毛巾拉平，還替你把歪掉的扶手扶正。你盯著他熟練的動作，懷疑自己是不是被刻意當成什麼都不懂的客人。
            <</switch>>
        <<elseif _hmEncounter.ignoreStage is 2>>
            <<switch _hmEncounter.stageVariant>>
                <<case 0>>
                    他再次從你的腰側往下按揉。你已經認得那條令人不安的路徑，手指在扶手上越收越緊。這次你轉頭得夠快，恰好看見他迅速把手移開。「力道太重？」他問。你本想說的不是這個，卻因為先前的沉默，突然覺得開口更加困難。
                <<case 1>>
                    一名顧客停在攤位前詢問價錢，按摩師一面回答，一面繼續替你按摩。你趁機坐直身體，想拉開距離。他等顧客走遠，才把椅背調回原來的角度。「這樣比較好施力。」他說。你望著重新熱鬧起來的走道，開始後悔第一次沒有直接站起來。
                <<case 2>>
                    你試著用肩膀的動作提醒他不要再靠近。他的手果然停住，還很客氣地詢問你是否需要休息。正當你以為他明白了，他卻又以幾乎相同的方式越過界線。你胸口一沉：這不是沒有察覺，而是明知故犯。
            <</switch>>
        <<else>>
            <<switch _hmEncounter.stageVariant>>
                <<case 0>>
                    按摩師連解釋都省了。你聽見自己的呼吸變得急促，卻不是因為放鬆。攤位外的人們提著購物袋來來去去，沒有人注意到你僵硬的坐姿。你終於明白，沉默並沒有讓事情停止；下一次他再伸手，你必須為自己做出決定。
                <<case 1>>
                    「快結束了。」按摩師看了一眼桌上的時鐘。你原本打算忍到時間結束，卻發現自己一直在計算還剩多少分鐘。當他的手再次靠近，你猛然把身體移向椅子另一側。他停下來看你。這次你沒有避開他的目光。
                <<case 2>>
                    毛巾從你的肩頭滑落，按摩師伸手想替你拉好。你卻下意識地縮了一下。這個反應比任何質問都更明白。對方的笑容短暫僵住，你看著那條掉在膝上的毛巾，心想：我為什麼要一直替他的行為找藉口？
            <</switch>>
        <</if>><br><br>
        <<link "猛地起身，拍開他的手" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("stop")>><</link>> <<gstress>><br>
        <<link "回頭盯著他，警告別再亂碰" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("warn")>><</link>><br>
        <<if _hmEncounter.ignoreStage lt 3>>
            <<link "把質問吞回去，看看他還會做什麼" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("ignore")>><</link>> <<garousal>><br>
        <<else>>
            <<link "忍到時間結束，立刻離開" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("ignore")>><</link>><br>
        <</if>>
        <<if hasSexStat("exhibitionism", 4)>>
            <<link "改變主意，明確說出自己的要求" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("encourage")>><</link>> <<ggarousal>><br>
        <</if>>
    <<elseif _hmEncounter.stage is "encourage_stage">>
        /* 三段使用者提供的正式場景文案。部位使用原版 Widget；濕潤程度使用原版 vaginaWetness。 */
        <<set _hmMassageWet to Number($vaginaWetness || 0)>>
        <<set _hmMassageLower to $worn.lower and !$worn.lower.type.includes("naked")>>
        <<set _hmMassageOverLower to $worn.over_lower and !$worn.over_lower.type.includes("naked")>>
        <<set _hmMassageUnderLower to $worn.under_lower and !$worn.under_lower.type.includes("naked")>>
        /* 三幕共用 encourageScene 指針：每一個 case 同時擁有開場和正文，確保跨幕連貫。
         * 未來新增 case 時，先寫該幕專屬開場，再寫該幕正文。
         * case 0 是目前完整的三幕文案組。
         * 未來每新增一組，必須同時在三幕加入相同編號的 case，
         * 然後才增加 JS 的 STREET_MASSEUR_ENCOURAGE_SCENE_COUNT。
         * 不要在這裡 rand()，也不要使用會隨階段重抽的 stageVariant。
         */
        <<if _hmEncounter.encourageStage is 1>>
            <<switch _hmEncounter.encourageScene>>
                <<case 0>>
            「剛才那些動作……你是故意的吧？」<br><br>
            按摩師正想辯解，卻聽見你接著說：「我還想要更多。」<br><br>
            他愣了一下，隨即笑得合不攏嘴。「早說嘛。」他朝街上張望一眼，壓低聲音：「這裡人來人往，跟我到裡面吧。」<br><br>
            他領你繞過攤位旁的架子。後方還有一處不大的隔間，擺著按摩床與乾淨的毛巾。布簾一拉，街上的喧鬧頓時隔遠了些。<br><br>
            「躺下吧。」他拍了拍床面，笑意仍藏不住。你照著躺好，聽見他在旁邊準備，心裡不禁想：自己原本只是來逛市場，怎麼會走到這一步？<br><br>
            按摩師正專注對你的<<chestsimple>>按摩，這遠比你自己揉捏更加舒適，或許考慮要他加大力道？想到這裡，你不由得想自己何時有這種大膽的想法了？隨著對方持續揉捏按壓，你漸漸沉浸在這份舒適裡。<br><br>
            <<if _hmMassageWet gte 45>>
                直到稍微挪動身體，你才察覺到另一處變化：
            <</if>>
            <<if _hmMassageWet gte 75>>
                <<if _hmMassageLower or _hmMassageOverLower>>下裝已經出現明顯的濕痕<<elseif _hmMassageUnderLower>>內褲已經潮濕<<else>>有液體正沿著大腿根部滴落<</if>>。
            <<elseif _hmMassageWet gte 45>>
                <<if _hmMassageUnderLower>>內褲已經潮濕<<elseif _hmMassageLower or _hmMassageOverLower>>下裝內側已經有些潮濕<<else>>下身已經有些潮濕<</if>>。
            <</if>>
            <<if _hmMassageWet gte 45>><br><br><</if>>
            不知不覺間，這一輪按摩已經過去。<br><br>
            <</switch>>
        <<elseif _hmEncounter.encourageStage is 2>>
            <<switch _hmEncounter.encourageScene>>
                <<case 0>>
            「換個姿勢，翻過身來吧。」按摩師笑著示意你趴下。<br><br>
            你依言翻身，將臉頰靠上按摩床的枕墊。身後傳來他走近的腳步聲，你的<<bottomsimple>>正好朝向他；想到對方剛才那副興致勃勃的模樣，你不禁有些在意他的目光。<br><br>
            他從床尾開始，先沿著小腿慢慢按揉，再將按摩的重心逐漸移向大腿。<br><br>
            按摩師似乎對你的<<bottomsimple>>感興趣，大部分時間都集中按摩這個位置，對於這個位置的你不置可否，甚至有點想讓對方更深入些，對方像是察覺你的想法一樣，猛地按壓了一下<<genitals>>,對於這突然的刺激，你差点叫出聲，趕忙摀住嘴避免叫聲被其他人聽到，對此按摩師對你笑了笑，手上的動作也沒停下，手指幾乎緊貼縫隙，你敏感處被他發現了！
            <<if _hmMassageWet gte 90>>隨著按摩繼續，液體隨著他的按壓不斷滲出。
            <<elseif _hmMassageWet gte 75>>隨著按摩繼續，液體在手離開時甚至拉絲了。
            <<elseif _hmMassageWet gte 60>>下身的潮濕感愈發明顯。
            <<elseif _hmMassageWet gte 45>>按摩持續著，下身也漸漸有了些許潮濕感。
            <</if>>
            <</switch>>
        <<else>>
            <<switch _hmEncounter.encourageScene>>
                <<case 0>>
            「再翻過來吧。」按摩師示意你仰躺，並請你將雙腿分開，好讓他繼續接下來的按摩。你依言翻身，稍微遲疑了一下，才慢慢調整雙腿的位置。<br><br>
            <<if !_hmMassageLower and !_hmMassageOverLower and !_hmMassageUnderLower>>
                你這才意識到，下半身沒有任何衣物遮掩，對方能清楚看見你的<<genitals>>。<br><br>
            <</if>>
            想起剛才的按摩，你有些難為情，卻還是照著他的指示調整好姿勢。<br><br>
            按摩師按壓你的<<genitals>>，你不得不承認，這非常舒服，可能比自己弄更好？想到這裡你耳根不由得發紅了，對方的動作時而溫柔輕撫時而用力按壓，且不針對外部，偶爾試探性的碰到縫隙敏感處，讓你不由得夾緊雙腿。
            <<if _hmMassageWet gte 90>>
                <<if _hmMassageLower or _hmMassageOverLower>>你的下裝如今已經完全濕了，緊貼著身體<<elseif _hmMassageUnderLower>>你的內褲如今已經完全濕了，緊貼著身體<<else>>下身的潮濕感如今已十分明顯<</if>>，身體對這樣色情按摩起了反應。
            <<elseif _hmMassageWet gte 60>>
                <<if _hmMassageLower or _hmMassageOverLower>>你的衣服帶著些許濕意<<elseif _hmMassageUnderLower>>你的內褲帶著些許濕意<<else>>你的下身帶著些許濕意<</if>>，身體對這樣色情按摩起了反應。
            <</if>>
            <</switch>>
        <</if>><br><br>
        <<if _hmEncounter.encourageStage lt 3>>
            <<link "繼續按摩" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("more")>><</link>> <<ggarousal>><br>
        <<else>>
            <<link "聽見計時器響起，結束服務" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("end")>><</link>><br>
        <</if>>
    <</if>>
<</widget>>
<<widget "HonestMarketsEncounterStreetMasseurResult">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<switch _hmEncounter.result>>
        <<case "declined">>你向按摩師搖搖頭，繼續穿過市場。
        <<case "cannot_pay">>你摸了摸口袋，發現現金不足 £50，只好婉拒。
        <<case "normal">>
            <<switch _hmEncounter.responseVariant>>
                <<case 0>>
                    你把注意力重新放回肩頸。按摩師沿著緊繃的肌肉慢慢推開，偶爾停下來確認力道，之後便不再碰觸其他位置。你感覺原本繃緊的背部漸漸鬆開，直到計時器響起才發現十五分鐘已經過去。<br><br>
                    「今天就到這裡。」他將毛巾收好。你站起身活動肩膀，對這場終於恢復正常的按摩感到滿意，也慶幸自己及時把話說清楚。
                <<case 1>>
                    「好，肩背就好。」按摩師應了一聲，重新站回椅子後方。他先試了幾下較輕的力道，等你點頭才逐漸加重。你原本仍留意著他的雙手，過了一會兒才發現自己不再那麼緊張。<br><br>
                    時間結束時，他替你把歪掉的毛巾拉好。你起身整理衣角，重新聽見周圍熱鬧的叫賣聲，心情比剛才平靜不少。
                <<case 2>>
                    按摩師將雙手放回肩頭，接下來的動作規矩得幾乎有些刻意。他沿著肩胛骨外側按揉，遇到特別痠痛的地方便放慢速度。你試著活動脖子，發現原先的僵硬確實減輕了。<br><br>
                    「這邊平常容易痠吧？」他問。你簡單應了一聲。等服務結束，你向他點頭道別，決定不再多想，繼續逛市場。
            <</switch>>
        <<case "stop">>
            <<switch _hmEncounter.responseVariant>>
                <<case 0>>
                    你猛地拍開他的手，椅腳在地上擦出刺耳的聲響。按摩師嚇了一跳，急忙說只是想替你調整姿勢，眼神卻不斷往旁邊的顧客飄。<br><br>
                    「不用了。」你站起身，連讓他解釋的興趣都沒有。走回人群時，你仍覺得不快，至少已經不必繼續坐在那張椅子上。
                <<case 1>>
                    你握住扶手站起來，當面要求他別再碰你。按摩師的笑容一下子僵住，先看了看左右，才壓低聲音說自己沒有惡意。<br><br>
                    你沒有接受這種說法，逕自離開攤位。走出一段距離後，背後的招呼聲逐漸被市場的喧鬧蓋過。
                <<case 2>>
                    你把身體往後一撤，椅子跟著晃了一下。「到此為止。」你說得很清楚。按摩師伸手想扶住椅背，見你瞪著他，又訕訕把手收了回去。<br><br>
                    他還想開口，你已經轉身走向走道。比起繼續爭辯，你現在更想離那個攤位遠一點。
            <</switch>>
        <<case "warn">>
            <<switch _hmEncounter.responseVariant>>
                <<case 0>>
                    「手放回肩膀。」你直接指出剛才越界的動作。按摩師先是一愣，隨即陪笑說自己一時沒注意。你沒有跟著笑，只是盯著他，直到他把雙手重新放回正確的位置。<br><br>
                    接下來他明顯收斂許多，按揉肩背時甚至刻意留出距離。計時器響起，你才慢慢起身；這次服務雖然完成了，最讓你在意的卻不是按摩效果。
                <<case 1>>
                    按摩師試圖解釋那是放鬆肩背的技巧，還抬起手比劃了幾下。你打斷他的話，清楚表示自己只接受原先說好的部位。他的表情有些掛不住，終究還是點頭。<br><br>
                    剩下的時間裡，他安靜地完成肩頸按摩，你也沒有再閉上眼睛。結束後，他客套地說了聲謝謝，你沒有多作回應便離開。
                <<case 2>>
                    你回頭警告他別再亂碰。按摩師立即縮回手，剛才那副從容的模樣消失了，連說話都變得小心。「那我只按肩膀，可以吧？」<br><br>
                    你點頭，他才繼續動作。之後每次需要調整椅背或位置，他都先開口詢問。你不確定他是真心反省，還是怕引起旁人注意，但至少直到結束都沒有再越界。
            <</switch>>
        <<case "ignore">>按摩終於結束。你站起身離開，卻仍反覆想著自己明明察覺了異樣，為什麼始終沒有說出口。
        <<case "encourage">>計時器忽然響起，清脆的鈴聲打破了隔間裡的安靜。<br><br>「今天的服務就到這裡，希望你喜歡。」按摩師笑著說完，收拾好手邊的東西，掀開布簾走了出去，將你一個人留在裡面。<br><br>你仍躺在按摩床上，身體因為尚未平復的興奮而微微顫抖。過了片刻，你才慢慢坐起身。<<if ($worn.over_lower and !$worn.over_lower.type.includes("naked")) or ($worn.lower and !$worn.lower.type.includes("naked")) or ($worn.under_lower and !$worn.under_lower.type.includes("naked")) or ($worn.upper and !$worn.upper.type.includes("naked")) or ($worn.under_upper and !$worn.under_upper.type.includes("naked"))>>你稍微整理了一下身上的衣物，<<else>>你確認自己已經準備好離開，<</if>>這才掀開布簾，回到熱鬧的市場。
    <</switch>><br><br>
<</widget>>
<<widget "HonestMarketsEncounterDirections">>
	<<honestMarketsEncounterDebug>>一名看起來不太熟悉這一帶的陌生人叫住你，問起附近某條街該往哪個方向走。<br><br>
	<<link "替對方指路" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("point")>>
	<</link>> <<lstress>><br>
	<<link "乾脆帶對方走一段 (00:10)" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("guide")>>
	<</link>> <<llstress>><br>
	<<link "表示不知道" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("ignore")>>
	<</link>>
<</widget>>
<<widget "HonestMarketsEncounterSleepingVendor">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>一個攤位後方的商販靠著椅背打起了瞌睡。攤上的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」就在伸手可及的位置，附近暫時也沒有人注意這邊。<br><br>
	<<link "敲敲攤面叫醒對方" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("wake")>>
	<</link>> <<lstress>><br>
	<<link "直接離開" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
	<</link>><br>
	<<crimeicon "mark">>
	<<link "順手拿走一份" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("steal")>>
	<</link>> <span class="green">物品+</span> <span class="red">犯罪+</span>
<</widget>>
<<widget "HonestMarketsEncounterSuspiciousGoods">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>一名攤販把你招到較不起眼的位置，從攤位底下拿出一包共 <<print _hmEncounter.qty>> 份的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」。<br><br>「別問哪來的，<<print setup.HonestMarkets.moneyText(_hmEncounter.price)>> 就給你。」這價錢明顯低於正常報價，但對方的態度也讓商品來源顯得相當可疑。<br><br>
	<<set _hmLabel to "買下（" + setup.HonestMarkets.moneyText(_hmEncounter.price) + "）(00:05)">>
	<<link _hmLabel "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("buy")>>
	<</link>> <span class="gold">金錢-</span> <span class="green">物品+</span><br>
	<<link "追問商品來源" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("question")>>
	<</link>> <<gstress>><br>
	<<link "不碰這種東西" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("leave")>>
	<</link>>
<</widget>>
<<widget "HonestMarketsEncounterCarryGoods">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<honestMarketsEncounterDebug>>一名正在搬貨的商販抱著幾個沉重的箱子從你旁邊經過，差點失去平衡。對方放下箱子喘了口氣，問你能不能幫忙把剩下的貨搬到攤位後面。<br><br>「不會耽誤太久，給你 <<print setup.HonestMarkets.moneyText(_hmEncounter.pay)>> 當謝禮。」<br><br>
	<<link "幫忙搬貨 (00:10)" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("help")>>
	<</link>> <span class="gold">金錢+</span> <<gtiredness>> <<lstress>><br>
	<<link "拒絕" "HonestMarkets Encounter Result">>
		<<run setup.HonestMarkets.resolveMarketEncounter("refuse")>>
	<</link>>
<</widget>>

<<widget "HonestMarketsEncounterDroppedGoodsResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "paid">>
		你把賠償交給攤販，對方嘀咕了幾句後便蹲下整理商品。這場小意外總算就此結束。
	<<elseif _hmEncounter.result is "denied">>
		你堅稱自己沒有碰到貨架。攤販顯然不相信，但在周圍客人的注視下也沒有繼續糾纏，只能氣沖沖地收拾散落的商品。
	<<elseif _hmEncounter.result is "smashed_escaped">>
		你看了一眼地上的商品，又看了一眼正要找你算帳的攤販，乾脆猛地撞向旁邊的攤位。貨架轟然歪倒，商品灑了一地，附近的人群頓時亂成一團。<br><br>
		「喂——！你做什麼！？」<br><br>
		趁所有人手忙腳亂，你鑽進人群，幾個急轉便把追上來的人甩在身後。等怒吼聲被市場的喧鬧吞沒，你才放慢腳步，心情反而暢快了不少。<br><br>
		<<if $debug is 1>><span class="gray">Debug：逃脫成功率 <<print _hmEncounter.escapeChance>>%；擲骰 <<print _hmEncounter.escapeRoll>> → 成功；整攤損失 <<print setup.HonestMarkets.moneyText(_hmEncounter.stallDamage)>>（原損失 ×<<print _hmEncounter.stallMultiplier>>）。</span><br><br><</if>>
	<<elseif _hmEncounter.stage is "caught_after_smash">>
		你看了一眼地上的商品，又猛地撞向旁邊的攤位。貨架轟然倒下，整個場面瞬間亂成一團。你趁機鑽進人群，卻沒能甩掉追上來的人。沒跑多遠，你就被抓住帶回了那片狼藉前。<br><br>
		攤販氣得臉色發青。原本只是 <<print setup.HonestMarkets.moneyText(_hmEncounter.compensation)>> 的損失，現在整個攤位都被你掀了。對方最後算出要你賠 <<print setup.HonestMarkets.moneyText(_hmEncounter.stallDamage)>>。<br><br>
		<<if $debug is 1>><span class="gray">Debug：逃脫成功率 <<print _hmEncounter.escapeChance>>%；擲骰 <<print _hmEncounter.escapeRoll>> → 失敗；整攤損失倍率 ×<<print _hmEncounter.stallMultiplier>>。</span><br><br><</if>>
		<<if $money gt 0>>
			<<if $money gte _hmEncounter.stallDamage>>
				<<link "賠償全部損失" "HonestMarkets Encounter Result">>
					<<run setup.HonestMarkets.resolveMarketEncounter("stall_pay")>>
				<</link>> <span class="gold">金錢-<<print setup.HonestMarkets.moneyText(_hmEncounter.stallDamage)>></span><br>
			<<else>>
				<<link "把身上的錢全交出去" "HonestMarkets Encounter Result">>
					<<run setup.HonestMarkets.resolveMarketEncounter("stall_pay")>>
				<</link>> <span class="gold">失去全部現金</span><br>
			<</if>>
		<</if>>
		<<if $promiscuity gte 60 or $debug is 1>>
			<<link "提出用別的方式賠償" "HonestMarkets Combat">>
				<<run setup.HonestMarkets.resolveMarketEncounter("voluntary_compensation")>>
				<<set $honestMarketsCombatSource to "stall_compensation">>
				<<set $honestMarketsCombatConsensual to 1>>
				<<set $honestMarketsCombatLootItem to _hmEncounter.itemId>>
				<<set $sexstart to 1>>
				<<run setup.HonestMarkets.clearMarketEncounter()>>
			<</link>> <span class="pink">志願</span><br>
		<</if>>
		<<if $money lte 0>>
			<<link "你根本拿不出錢" "HonestMarkets Combat">>
				<<run setup.HonestMarkets.resolveMarketEncounter("forced_compensation")>>
				<<set $honestMarketsCombatSource to "stall_compensation">>
				<<set $honestMarketsCombatConsensual to 0>>
				<<set $sexstart to 1>>
				<<run setup.HonestMarkets.clearMarketEncounter()>>
			<</link>> <span class="red">非志願</span><br>
		<</if>>
	<<elseif _hmEncounter.result is "stall_paid">>
		你把 <<print setup.HonestMarkets.moneyText(_hmEncounter.paidAfterSmash)>> 交給攤販。對方接過錢仔細數了一遍，又看了看身後一片狼藉的攤位。<br><br>「算你識相。」<br><br>對方沒好氣地揮了揮手，轉身回去收拾散落一地的商品。
	<<elseif _hmEncounter.result is "stall_partial">>
		你把身上僅剩的 <<print setup.HonestMarkets.moneyText(_hmEncounter.paidAfterSmash)>> 全部交了出去。攤販數完錢，臉色依然難看。<br><br>「這連全部損失都賠不起……算了，滾吧。」<br><br>對方顯然還在氣頭上，但看你確實拿不出更多錢，最後還是放你離開，轉身去收拾被你掀翻的攤位。
	<</if>><br><br>
<</widget>>
<<widget "HonestMarketsEncounterQueueJumperResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "ignored">>你沒有和對方計較，任由那人消失在前方擁擠的人群裡。 <<gstress>><<elseif _hmEncounter.result is "argued">>你直接指出對方剛才硬擠的行為。幾句爭執後，對方終究在周圍人的目光下退到了一旁。 <<if _hmEncounter.argumentStressChange lt 0>><<lstress>><<else>><<ggstress>><</if>><<else>>你毫不客氣地把位置擠了回來。對方踉蹌了一下，瞪了你幾眼，最後沒有再往前湊。 <<llstress>> <<gpain>><</if>><br><br><</widget>>
<<widget "HonestMarketsEncounterMarketArgumentResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "watched">>
		你在人群旁看了一會兒。雙方吵得口乾舌燥，翻來覆去還是那些話。最後顧客氣沖沖地丟下一句「以後再也不來了」，轉身擠出人群。攤販則一邊整理攤面，一邊仍朝對方離開的方向罵個不停。<br><br>圍觀的人見沒什麼新鮮事，也很快各自散去。
	<<elseif _hmEncounter.stage is "fight_aftermath">>
		你在人群旁饒有興致地看著兩人越吵越兇。<br><br>「你再說一次試試看？」<br><br>顧客伸手推了攤販一把。四周頓時響起一陣起鬨和驚呼。攤販踉蹌著撞上自己的攤位，愣了一瞬，隨即怒吼著撲了回去。兩人很快扭打成一團，撞得攤位上的貨物東倒西歪。<br><br>你和其他圍觀的人默契地往後退了幾步。直到附近幾名攤販趕來把兩人硬生生拉開，這場鬧劇才總算告一段落。<br><br>原本整齊的攤位已經一片狼藉，幾個箱子倒在地上，商品散得到處都是。剛才還在和人扭打的攤販喘著氣，看著眼前的慘狀，臉色變得更加難看。<br><br>
		<<link "幫忙收拾散落的商品" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("help_cleanup")>>
		<</link>> <<lstress>><br>
		<<link "看夠了，離開" "HonestMarkets Encounter Result">>
			<<run setup.HonestMarkets.resolveMarketEncounter("leave_after_fight")>>
		<</link>>
	<<elseif _hmEncounter.result is "helped_cleanup">>
		你蹲下來，幫忙把散落在地上的商品一件件撿回箱子。攤販仍氣得不輕，但看到你主動留下來幫忙，神情稍微緩和了一些。<br><br>「……謝了。」
		<<if _hmEncounter.giftQty gt 0>><br><br>對方從剛整理好的貨物裡拿出 <<print _hmEncounter.giftQty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」塞給你。<br><br>「拿著吧。反正今天已經夠亂了。」<</if>>
	<<elseif _hmEncounter.result is "left_after_fight">>
		你看了一場免費的熱鬧，趁其他人開始收拾滿地狼藉時離開了人群。至少你沒有把自己也捲進去。
	<<elseif _hmEncounter.result is "mediated">>
		你趁兩人還只是互相叫罵時插進中間。「行了，再吵下去也解決不了價錢的問題。」<br><br>你費了一番口舌，總算讓兩人各退一步。顧客依然滿臉不快，最後還是轉身離開；攤販則嘴裡嘀咕著幾句，重新整理起自己的商品。<br><br>雙方雖然都不太服氣，至少沒有繼續把事情鬧大。 <<lstress>>
	<<elseif _hmEncounter.result is "mediated_fight">>
		你看兩人的火氣越來越大，連忙擠進中間。<br><br>「行了，有什麼事情——」<br><br>話還沒說完，顧客突然伸手推向攤販。攤販也毫不客氣地撲了回來，而你正好站在兩人中間。<br><br>「等等——！」<br><br>混亂中，一記不知道原本打算招呼誰的手肘狠狠撞在你身上。你吃痛地縮了一下，緊接著又被其中一人撞得踉蹌後退。 <<ggpain>><br><br>幾名原本只打算看熱鬧的攤販見事情真的失控，這才一擁而上，把扭打在一起的兩人強行拉開。<br><br>等場面終於平靜下來時，你身上也已經多了幾處隱隱作痛的地方。<br><br>剛才和人扭打的攤販看了看一片狼藉的攤位，又看了看莫名其妙挨了一下的你，顯得有些尷尬。<br><br>「……你還好吧？本來也不關你的事。」
		<<if _hmEncounter.giftQty gt 0>><br><br>對方從還沒被撞翻的貨物裡拿出 <<print _hmEncounter.giftQty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」塞給你。<br><br>「拿著。算是……賠你的。」<</if>><br><br>早知道就讓他們自己吵了。
	<<else>>
		你沒有捲進這場爭執，繞過聚集的人群繼續逛市場。
	<</if>><br><br>
<</widget>>
<<widget "HonestMarketsEncounterBeggarResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "gave">>你拿出 <<print setup.HonestMarkets.moneyText(_hmEncounter.given)>> 交給對方。陌生人連聲道謝，很快退回人群邊緣。<<elseif _hmEncounter.result is "cannot_give">>你摸了摸口袋，才發現自己拿不出剛才想給的 <<print setup.HonestMarkets.moneyText(_hmEncounter.requested)>>。對方失望地點點頭，沒有再糾纏。<<else>>你搖頭拒絕。對方也沒有多說什麼，很快又去詢問下一名路人。<</if>><br><br><</widget>>
<<widget "HonestMarketsEncounterStreetPerformerResult">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter.result is "tipped">>
        你駐足聽了一會兒，隨後將 <<print setup.HonestMarkets.moneyText(_hmEncounter.tipped)>> 放進藝人面前的帽子裡。對方朝你露出感激的微笑，手上的演奏卻沒有停下。你帶著稍微放鬆的心情繼續逛市場。<br><br>
    <<elseif _hmEncounter.result is "watched">>
        你停下腳步聽了一會兒。熟悉的喧鬧聲彷彿漸漸遠去，等到一曲終了，你才心情輕鬆地繼續往前走。<br><br>
    <<elseif _hmEncounter.result is "cannot_tip">>
        你摸了摸口袋，發現自己拿不出想打賞的 <<print setup.HonestMarkets.moneyText(_hmEncounter.requested)>>。你只好收回手，沒有打擾藝人的演奏。<br><br>
    <<else>>
        你沒有停留，讓樂聲隨著人群的喧鬧漸漸消失在身後。<br><br>
    <</if>>
<</widget>>
<<widget "HonestMarketsEncounterDirectionsResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "pointed">>你替對方指明方向。陌生人確認了兩次，向你道謝後便匆匆離開。<<elseif _hmEncounter.result is "guided">>你乾脆帶對方走到比較容易辨認的路口。雖然花了一點時間，至少對方不會再繞回市場裡迷路。<<else>>你表示自己也不清楚。對方只好繼續找其他人詢問。<</if>><br><br><</widget>>
<<widget "HonestMarketsEncounterSleepingVendorResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "woke">>你敲了敲攤面。商販猛地驚醒，愣了幾秒才意識到自己睡著了，尷尬地向你道謝。<<elseif _hmEncounter.result is "stolen">>你趁對方仍在打瞌睡，把一份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」悄悄收進自己的東西裡，隨即若無其事地離開。<<else>>你沒有打擾熟睡的商販，直接從攤位前走過。<</if>><br><br><</widget>>
<<widget "HonestMarketsEncounterSuspiciousGoodsResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "bought">>你付了錢，把這批共 <<print _hmEncounter.qty>> 份、來源不明的<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」收好。攤販收錢後立刻把注意力轉向別處，完全沒有多談的意思。<<elseif _hmEncounter.result is "cannot_buy">>價錢雖低，你身上的錢仍然不夠。攤販立刻把商品收回攤位底下。<<elseif _hmEncounter.result is "questioned">>你追問東西從哪來。攤販臉上的笑容立刻消失，只丟下一句「不買就算了」，便把商品藏回去。<<else>>你搖頭離開。這種價格或許很誘人，但你不打算追究它究竟是怎麼來的。<</if>><br><br><</widget>>
<<widget "HonestMarketsEncounterCarryGoodsResult">>
	<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
	<<if _hmEncounter.result is "helped">>你幫著把幾箱貨搬到攤位後方。工作不算久，手臂還是有些發酸。商販照約定把 <<print setup.HonestMarkets.moneyText(_hmEncounter.pay)>> 塞到你手裡，笑著向你道謝。<<if _hmEncounter.giftQty gt 0>><br><br>「這些你也拿去吧。」對方又從剛搬好的貨物裡隨手挑了 <<print _hmEncounter.giftQty>> 份<<foodstufficon _hmEncounter.itemId>>「<<print setup.HonestMarkets.encounterItemName(_hmEncounter.itemId)>>」塞給你，算是額外的謝禮。<</if>><<else>>你表示自己還有別的事。商販點點頭，只好重新抱起箱子，慢慢往攤位後方挪。<</if>><br><br><</widget>>




<<widget "HonestMarketsPhotographerPoseText">>
<<hmPhotographerPose _args[0] _args[1] _args[2] _args[3]>><br>
<</widget>>
<<widget "HonestMarketsPhotographerMovement">>
<<if _args[0] is "伸展">>
<<if _args[1] is 0>>你伸展到一半就停住，手腳像是各有自己的節奏，動作顯得相當勉強。
<<elseif _args[1] is 1>>你跟著口令慢慢完成伸展，雖然需要多練習一次，最後仍把動作接了起來。
<<elseif _args[1] is 2>>你流暢地完成整段伸展，停頓和收勢都恰好落在攝影師按下快門的時候。<</if>>
<<elseif _args[0] is "倚靠">>
<<if _args[1] is 0>>你一靠上牆就不知道該怎麼擺放手腳，肩膀不自然地聳起，只好重新調整。
<<elseif _args[1] is 1>>你換了幾次重心，終於找到舒服的倚靠角度，也能在口令下維持姿勢。
<<elseif _args[1] is 2>>你順勢將重心交給牆面，肩膀與手臂都放得恰到好處，換角度時也毫不費力。<</if>>
<<elseif _args[0] is "凝視">>
<<if _args[1] is 0>>你盯著鏡頭幾秒便忍不住移開視線，表情越想控制反而越顯得不自然。
<<elseif _args[1] is 1>>你先看向攝影師指的位置，慢慢固定目光，終於能在快門響起時維持神情。
<<elseif _args[1] is 2>>你自然地掌握目光焦點，細微的表情變化也能配合鏡頭，讓畫面顯得生動。<</if>>
<<elseif _args[0] is "回頭">>
<<if _args[1] is 0>>你聽到口令才匆忙回頭，脖子與肩膀僵成一團，目光也錯過了鏡頭。
<<elseif _args[1] is 1>>你先穩住姿勢，再緩緩回過頭，經過一次調整後終於迎上鏡頭。
<<elseif _args[1] is 2>>你抓準快門前的一瞬回眸，神情與動作自然連貫，完全不必重來。<</if>>
<<elseif _args[0] is "坐姿">>
<<if _args[1] is 0>>你坐下後不停挪動位置，雙手也不知該放在哪裡，攝影師只好重新說明構圖。
<<elseif _args[1] is 1>>你逐漸掌握座位與鏡頭的距離，調整幾次後能穩穩維持攝影師指定的姿態。
<<elseif _args[1] is 2>>你坐下時便自然地安排好重心與肩線，還能輕鬆配合鏡頭切換方向。<</if>>
<<elseif _args[0] is "整理">>
<<if _args[1] is 0>>你手忙腳亂地調整衣著與站位，才整理好一邊，另一邊又偏了；攝影師只好耐心等待。
<<elseif _args[1] is 1>>你依照指示逐項調整細節，雖然動作有些生疏，最後仍讓姿態與衣著看起來整齊。
<<elseif _args[1] is 2>>你俐落地完成細節調整，還會主動確認衣物線條與鏡頭角度是否協調。<</if>>
<<elseif _args[0] is "站姿">>
<<if _args[1] is 0>>你一時不知道該把重量放在哪隻腳上，雙肩繃得筆直；每次試著放鬆，反而讓身體晃了一下。
<<elseif _args[1] is 1>>你照著指示慢慢調整站姿，幾次嘗試後終於找到了較穩的重心，肩膀也不再那麼僵硬。
<<elseif _args[1] is 2>>你幾乎立刻找準了站位，稍微改變肩線與腳尖方向，就讓整個姿勢顯得乾淨而自然。<</if>>
<<elseif _args[0] is "行走">>
<<if _args[1] is 0>>你總在鏡頭靠近時放慢腳步，走得像是在數地上的石板，連手臂都不知道該如何擺動。
<<elseif _args[1] is 1>>你照著節拍走了幾趟，逐漸能把步伐和視線配合起來，動作比起初自然不少。
<<elseif _args[1] is 2>>你以穩定又輕快的節奏走過巷道，甚至懂得在光線變化時稍稍放慢，讓攝影師連續取景。<</if>>
<<elseif _args[0] is "起身">>
<<if _args[1] is 0>>你急著站起來，腳下重心一亂，只得扶穩自己，讓攝影師再拍一次。
<<elseif _args[1] is 1>>你先確認腳步位置，按著節奏站起來，第二次便順利接上下一個姿勢。
<<elseif _args[1] is 2>>你從坐姿順暢地起身，動作既穩定又有節奏，攝影師幾乎不必重新對焦。<</if>>
<<elseif _args[0] is "轉身">>
<<if _args[1] is 0>>你轉得太急，腳步與肩膀沒有跟上，差點踏錯位置；只得停下來重新面對鏡頭。
<<elseif _args[1] is 1>>你刻意放慢速度，先移動腳步再帶動肩膀，轉到一半還會確認攝影師的手勢。
<<elseif _args[1] is 2>>你讓肩膀、腰部與腳步順暢銜接，轉身時還能準確停在光線最好的位置。<</if>>
<</if>><br>
<</widget>>
<<widget "HonestMarketsPhotographerComposure">>
/* 參數：階段、從容度級別、鏡位索引。每個鏡位使用不同反應，避免重複。 */
<<if _args[0] is 0>>
<<if _args[1] is 0>>
<<if _args[2] is 0>>你聽見第一聲快門時不自覺地繃緊肩膀，直到攝影師示意放鬆，才慢慢吐出一口氣。
<<elseif _args[2] is 1>>換到第二個角度後，你又忍不住瞄了一眼相機，扶著牆面穩住呼吸才重新看向指定方向。
<<elseif _args[2] is 2>>最後一張照片前，你終於能稍微忽略快門聲；雖然神情仍有些拘謹，至少沒有再急著躲開鏡頭。
<</if>>
<<elseif _args[1] is 1>>
<<if _args[2] is 0>>你先試著適應相機的距離，等攝影師倒數完畢，才讓表情慢慢自然起來。
<<elseif _args[2] is 1>>連續幾次拍攝讓你逐漸熟悉節奏，這回不必再特意確認鏡頭是否已經對準。
<<elseif _args[2] is 2>>你對最後的近距離取景仍稍感在意，但已能穩定地迎向鏡頭，等攝影師說完成才移開視線。
<</if>>
<<elseif _args[1] is 2>>
<<if _args[2] is 0>>你很快就適應了攝影師的口令，甚至在他舉起相機前，便自然地調整好神情。
<<elseif _args[2] is 1>>即使攝影師臨時改變站位，你也沒有慌張，而是從容地跟著他的手勢轉換目光。
<<elseif _args[2] is 2>>最後的特寫反而讓你更加投入；你穩穩看向鏡頭，讓攝影師一口氣拍完連續幾張照片。
<</if>>
<</if>>
<<elseif _args[0] is 1>>
<<if _args[1] is 0>>
<<if _args[2] is 0>>聽見新的造型要求，你猶豫了片刻才答應，動作開始前仍不時留意巷口的聲響。
<<elseif _args[2] is 1>>攝影師希望你再放開一些，你卻本能地收緊肩膀，得等他重新說明才願意繼續。
<<elseif _args[2] is 2>>接近尾聲時你仍顯得不自在，拍完最後一張便立即詢問這組是否已經結束。
<</if>>
<<elseif _args[1] is 1>>
<<if _args[2] is 0>>你對較大膽的姿勢有些遲疑，但在確認攝影師的要求後，還是試著自然地完成動作。
<<elseif _args[2] is 1>>比起剛開始，你已經不再頻頻停下；只是換角度時，仍會先確認自己的站姿是否妥當。
<<elseif _args[2] is 2>>你終於能把注意力放回拍攝本身，最後一張的神情比第一張明顯輕鬆許多。
<</if>>
<<elseif _args[1] is 2>>
<<if _args[2] is 0>>你對這一組的新要求並不慌張，反而好奇攝影師準備從哪個角度拍攝。
<<elseif _args[2] is 1>>攝影師還沒說完下一個指示，你便能從容地配合調整，偶爾還主動提出更合適的站位。
<<elseif _args[2] is 2>>你對最後的鏡頭充滿信心，直到快門停下才放鬆姿勢，還主動詢問照片拍得如何。
<</if>>
<</if>>
<<elseif _args[0] is 2>>
<<if _args[1] is 0>>
<<if _args[2] is 0>>服裝調整完畢，你先確認四周安靜，才慢慢走到攝影師指定的位置。
<<elseif _args[2] is 1>>聽見遠處傳來市集的吆喝聲，你短暫停下動作，等聲音遠去才重新集中精神。
<<elseif _args[2] is 2>>完成最後一張時你仍急著結束這組拍攝，直到攝影師放下相機才真正鬆了口氣。
<</if>>
<<elseif _args[1] is 1>>
<<if _args[2] is 0>>你花了一點時間適應新的造型，確認自己的站位後，才重新迎向鏡頭。
<<elseif _args[2] is 1>>第二個角度比想像中容易掌握，你逐漸不再分心，只偶爾向攝影師確認下一步。
<<elseif _args[2] is 2>>這一組接近尾聲時，你已能平穩地完成最後的轉身，不再因為相機靠近而停頓。
<</if>>
<<elseif _args[1] is 2>>
<<if _args[2] is 0>>你很快就進入新的拍攝節奏，對攝影師調整光線和鏡頭的動作也十分習慣。
<<elseif _args[2] is 1>>換到另一個位置時，你甚至能主動留意光線，從容地等攝影師找到合適的構圖。
<<elseif _args[2] is 2>>最後幾次快門聲響起，你始終保持專注；直到攝影師宣布完成，才自然地放鬆下來。
<</if>>
<</if>>
<<elseif _args[0] is 3>>
<<if _args[1] is 0>>
<<if _args[2] is 0>>這組拍攝的安排讓你格外緊張，攝影師只得放慢口令，等你準備好再開始。
<<elseif _args[2] is 1>>拍到第二個角度時，你仍會被巷外偶爾傳來的聲音分散注意力，得重新確認自己的位置。
<<elseif _args[2] is 2>>聽見攝影師說最後一張已完成，你幾乎立刻鬆懈下來，顯然一直在努力維持鎮定。
<</if>>
<<elseif _args[1] is 1>>
<<if _args[2] is 0>>你先調整呼吸，努力把注意力放在動作和取景指示上。
<<elseif _args[2] is 1>>鏡頭移動時，你努力保持站姿穩定，雖然偶爾仍會顯得拘謹。
<<elseif _args[2] is 2>>最後的鏡頭結束時，你終於能坦然面對攝影師的預覽畫面，等待他確認成果。
<</if>>
<<elseif _args[1] is 2>>
<<if _args[2] is 0>>你對攝影師的口令適應得很快，從容地等候攝影師確認光線後才開始動作。
<<elseif _args[2] is 1>>攝影師改變角度時，你依然保持專注，沒有因為連續拍攝而打亂自己的呼吸。
<<elseif _args[2] is 2>>直到最後一聲快門落下，你仍能自然地維持姿態，讓攝影師順利完成整組構圖。
<</if>>
<</if>>
<</if>><br>
<</widget>>
<<widget "HonestMarketsPhotographerReaction">>
<<if _args[0] is 0>>
<<if _args[1] is 0>>攝影師放下相機，先讓你休息片刻。他看了看剛才的照片，耐心指出需要調整的位置，表示可以慢慢來。
<<elseif _args[1] is 1>>攝影師皺眉放大預覽畫面，請你把剛才的動作重做一次，這回他刻意放慢了口令。
<<elseif _args[1] is 2>>攝影師收起一瞬間的失望，重新安排角度，鼓勵你先站穩，再試著完成下一張。
<</if>>
<<elseif _args[0] is 1>>
<<if _args[1] is 0>>攝影師看著預覽點了點頭，說這次總算抓到合適的角度，接著示意你換下一個姿勢。
<<elseif _args[1] is 1>>他確認焦距後露出稍微滿意的神情，提醒你保持剛才的節奏，別在快門前突然移動。
<<elseif _args[1] is 2>>攝影師表示畫面已經可以使用，雖然還有改善空間，但至少不用再重拍。
<</if>>
<<elseif _args[0] is 2>>
<<if _args[1] is 0>>攝影師連續按下幾次快門，笑著說這一段比預期順利，甚至多補拍了幾張不同角度。
<<elseif _args[1] is 1>>他看著相機螢幕稱讚你的配合，隨後退後兩步，試著用另一個構圖再拍一張。
<<elseif _args[1] is 2>>攝影師對照片相當滿意，特地讓你看看預覽，說光線與姿態搭配得剛剛好。
<</if>>
<<elseif _args[0] is 3>>
<<if _args[1] is 0>>攝影師幾乎沒有停下快門，興奮地說這組照片十分出色，還主動調整鏡頭捕捉更多自然瞬間。
<<elseif _args[1] is 1>>他反覆查看剛才的連拍，連聲稱讚你的鏡頭感，表示不必再花時間修正姿勢。
<<elseif _args[1] is 2>>攝影師笑得合不攏嘴，說你能準確理解每個指示，這種拍攝節奏實在難得。
<</if>>
<</if>><br>
<</widget>>
/* 每幕結束：先回應最後一張的互動，再按完成度／階段／固定變體檢視成果。 */
<<widget "HonestMarketsPhotographerReview">>
<<set _prTier to Number(_args[0])>>
<<set _prPhase to Number(_args[1])>>
<<set _prVariant to Number(_args[2]) % 3>>
<<set _prReaction to _args[3]>>
<<if _prTier is 0>>
    <<if _prVariant is 0>>他在幾張略顯僵硬的畫面間來回切換，最後挑出構圖較完整的照片。「不是每張都成功，但至少有能交件的。」
    <<elseif _prVariant is 1>>他放大一張失焦的照片，又迅速滑過幾張動作沒跟上的畫面，嘆了口氣。「這組得仔細挑，不過約好的報酬照付。」
    <<else>>攝影師將照片依光線和姿勢分成兩批，反覆比較後留下少數幾張。「還有不少能改進的地方，今天先到這裡。」<</if>>
<<elseif _prTier is 1>>
    <<if _prVariant is 0>>他挑出幾張姿態完整的照片，指著其中一張說：「這個角度可以留下，其他的再慢慢選。」
    <<elseif _prVariant is 1>>攝影師檢查焦點與曝光，偶爾點頭，偶爾把照片劃到一旁。「有幾張很穩，這組算是完成了。」
    <<else>>他先看整體構圖，再回頭比較你的站姿變化，最後保留幾張節奏最自然的照片。「成果比剛開始穩定。」<</if>>
<<elseif _prTier is 2>>
    <<if _prVariant is 0>>攝影師停在一張側光照片上，仔細比較前後兩張的肩線。「這張很好，光線剛好把姿態帶出來了。」
    <<elseif _prVariant is 1>>他將幾張不同角度的照片排在一起，越看越滿意。「姿勢變化很自然，這組可以留下不少。」
    <<else>>攝影師快速翻過前幾張，又倒回其中一張放大查看。「這個瞬間抓得漂亮，整組的節奏也比預期好。」<</if>>
<<else>>
    <<if _prVariant is 0>>攝影師一連標記好幾張照片，甚至忘了立刻關閉預覽。「連轉身的瞬間都拍得很好，這組選片恐怕要花些時間。」
    <<elseif _prVariant is 1>>他反覆比較連拍的細微差異，嘴角忍不住上揚。「原本只打算留下幾張，現在每個角度都有值得挑的畫面。」
    <<else>>攝影師將相機稍微轉向你，指著幾張連續的構圖。「你看，動作接得非常順，幾乎不用刻意挑掉哪一張。」<</if>>
<</if>><br>
<</widget>>

/* 攝影師局部取景：由原版 Widget 提供身體特徵差分，事件只負責敘事。 */
<<widget "HonestMarketsPhotographerFocusDescription">>
<<if _args[0] is "chest">>你的<<chest>>
<<elseif _args[0] is "hips">>你的<<bottom>>
<<elseif _args[0] is "legs">>你的雙腿
<<elseif _args[0] is "feet">>你的足部與腳尖
<<elseif _args[0] is "waist">>你的腰身
<<elseif _args[0] is "face">>你的側臉
<<elseif _args[0] is "full">>你的全身輪廓
<<else>>你的身形<</if>>
<</widget>>

<<widget "HonestMarketsPhotographerCameraReaction">>
<<set _cr to _args[0]>>
<<if _cr>>
    <<if _cr.index is 1>>
        <<if _cr.phase is 3>>
            <<if _cr.variant is 0>>攝影師先拍了一張完整構圖，隨後鏡頭卻幾次轉回<<HonestMarketsPhotographerFocusDescription _cr.focus>>。你發現他放大預覽的次數，似乎遠比其他角度多。
            <<elseif _cr.variant is 1>>快門聲原本十分規律，直到鏡頭對準<<HonestMarketsPhotographerFocusDescription _cr.focus>>時，攝影師突然放慢了動作。他聲稱是在等待光線，卻又悄悄補拍了好幾張。
            <<else>>攝影師請你維持姿勢，自己卻反覆調整對準<<HonestMarketsPhotographerFocusDescription _cr.focus>>的取景範圍。當你望向他時，他立刻恢復一本正經的神情。<</if>><br>
        <<else>>
            <<if _cr.variant is 2>>攝影師把相機放低又舉起，似乎一直在尋找<<HonestMarketsPhotographerFocusDescription _cr.focus>>的特定角度。他口頭上說快好了，卻又按了幾次快門。
            <<elseif _cr.focus is "chest">>攝影師查看預覽時，在你的上半身構圖上停留得格外久，直到發現你正在看他，才若無其事地抬起鏡頭。
            <<elseif _cr.focus is "hips">>攝影師繞到側面，反覆確認你的腰臀輪廓。他說是在找光線，卻又回到先前已拍過的位置。
            <<elseif _cr.focus is "feet">>攝影師忽然蹲低鏡頭，要求你調整腳尖的方向，接著又拍了幾張足部近景。你發現他檢查這些照片的時間格外久。
            <<elseif _cr.focus is "waist">>攝影師反覆要求你微微側身，幾次把畫面裁到腰線附近，卻沒有解釋為何捨棄原本的全身構圖。
            <<else>>攝影師連續拍下幾張腿部構圖，快門停下後仍盯著預覽，遲遲沒有給出下一個指示。<</if>><br>
        <</if>>
        <<if _cr.reaction is "guarded">>
            你本來已經鼓起勇氣完成這個姿勢，但鏡頭反覆停留的方向仍讓你感到窘迫。你下意識收攏肩膀，<<if _cr.focus is "chest">>將手臂移到身前，遮住一部分上半身<<elseif _cr.focus is "hips">>稍微側轉腰身，避開原本毫無遮擋的角度<<elseif _cr.focus is "feet">>將腳步收回原位，不再照著他反覆調整腳尖<<elseif _cr.focus is "waist">>稍微轉正身體，避免他一直停在同個側面角度<<else>>併攏雙腿，縮小原本的站姿幅度<</if>>。你提醒自己還有約好的報酬，卻也開始希望這張照片能快點結束。<br>
        <<elseif _cr.reaction is "hesitant">>
            你不至於完全無法接受這種拍攝尺度，但攝影師的執著仍讓你有些難為情。你<<if _cr.focus is "chest">>稍微轉過肩膀，讓手臂自然停在胸前一側<<elseif _cr.focus is "hips">>重新調整重心，讓側面的角度不那麼直接<<elseif _cr.focus is "feet">>將腳跟落回地面，換成比較自在的站姿<<elseif _cr.focus is "waist">>放鬆側轉的腰身，試著回到正面構圖<<else>>短暫收回伸展的腿，再換成比較自在的站姿<</if>>，心裡盤算著要不要開口問他為何非得重拍。<br>
        <<elseif _cr.reaction is "confident">>
            你對自己的表現頗有信心，也看得出攝影師對這個角度特別在意。你沒有慌亂，反而<<if _cr.focus is "chest">>挺直背脊、舒展雙肩，重新調整上半身的線條<<elseif _cr.focus is "hips">>側轉腰身，讓整體輪廓更清楚<<elseif _cr.focus is "feet">>微調腳尖朝向，讓腳步自然落在光線下<<elseif _cr.focus is "waist">>調整站姿與肩線，讓腰部輪廓更連貫<<else>>伸展單腿，重新安排雙腿的前後位置<</if>>。不過你仍留意著他的一舉一動，並不打算任由他無限重拍。<br>
        <<else>>
            你早已察覺攝影師對這個角度的偏好，對鏡頭卻沒有多少顧慮。你索性<<if _cr.focus is "chest">>舒展雙肩、挺起胸膛，主動調整上半身的構圖<<elseif _cr.focus is "hips">>轉動腰臀、改變重心，讓側身線條更鮮明<<elseif _cr.focus is "feet">>稍稍移動腳步，主動讓他確認想要的取景範圍<<elseif _cr.focus is "waist">>側過上半身，從容地調整腰部線條<<else>>將一條腿向前伸展，從容地改變腿部線條<</if>>，反過來觀察他的反應。攝影師愣了片刻，才匆忙重新對焦。<br>
        <</if>>
    <<elseif _cr.index is 2>>
        <<if _cr.phase is 2>>
            <<if _cr.variant is 0>>攝影師原本正在確認整體姿勢，卻將鏡頭轉向<<HonestMarketsPhotographerFocusDescription _cr.focus>>，接連拍下幾張局部畫面。你發現他似乎更在意這個角度，而非完整的姿勢。
            <<elseif _cr.variant is 1>>攝影師翻看剛拍好的照片，隨即把鏡頭對準<<HonestMarketsPhotographerFocusDescription _cr.focus>>，反覆調整距離。他嘴上說是在確認細節，卻遲遲沒有回到完整的人像構圖。
            <<else>>攝影師幾次將鏡頭停在<<HonestMarketsPhotographerFocusDescription _cr.focus>>，即使你已維持好姿勢，他仍不斷微調取景、補拍細節。你察覺他的注意力早已從整體構圖移到局部畫面。<</if>><br>
        <<elseif _cr.phase is 3>>
            <<if _cr.variant is 0>>他明明說過只剩最後一張，鏡頭卻又回到<<HonestMarketsPhotographerFocusDescription _cr.focus>>。你忍不住皺眉，等他解釋為何還要補拍。
            <<elseif _cr.variant is 1>>攝影師翻過幾張預覽，嘴裡說著快完成了，卻又要求保留<<HonestMarketsPhotographerFocusDescription _cr.focus>>的角度。你注意到他似乎根本捨不得結束這一組。
            <<else>>他調整了好幾次焦距，始終繞著<<HonestMarketsPhotographerFocusDescription _cr.focus>>打轉。你已經分不清這究竟是工作上的堅持，還是他私下的偏好。<</if>><br>
        <</if>>
        <<if _cr.reaction is "guarded">>
            <<if _cr.variant is 0>>
                你放下原本維持的姿勢，朝鏡頭看了一眼。「這個角度剛才不是拍過了嗎？」攝影師停下動作，解釋自己在比較光線，但也答應不再追加同樣的照片。<br>
            <<elseif _cr.variant is 1>>
                你稍微退離取景位置，沒有立刻配合下一個指示。「我們不是說好只拍這幾張？」攝影師看了看預覽，終於承認現有的照片已經足夠。<br>
            <<else>>
                你察覺他又把鏡頭移向<<HonestMarketsPhotographerFocusDescription _cr.focus>>，便先收起姿勢。「我想先看看拍好的照片。」攝影師猶豫片刻，放低相機，開始翻閱剛才的成果。<br>
            <</if>>
        <<elseif _cr.reaction is "hesitant">>
            「最後一張。」攝影師再次保證。你看著他遲遲不肯放下的相機，深吸一口氣，略微側身，決定完成這張後就不再接受額外要求。<br>
        <<elseif _cr.reaction is "confident">>
            你放鬆原本的姿勢，直接詢問他還需要什麼畫面。攝影師原本準備好的說詞忽然卡住，只得低頭翻看預覽，承認這組照片其實已經足夠。<br>
        <<else>>
            你從容地完成最後一次姿勢調整，反而先提醒他這是約好的最後一張。攝影師一時接不上話，只好笑著點頭，終於把鏡頭移回完整構圖。<br>
        <</if>>
    <</if>>
<</if>>
<</widget>>

/* 攝影開場衣著心理：只在暴露 3／5 的拍攝開始時顯示，與提議階段的接受心理分開。 */
<<widget "HonestMarketsPhotographerClothingMood">>
<<set _hmClothingPhase to _args[0]>>
<<set _hmClothingMood to setup.HonestMarkets.photographerOfferMood(_hmClothingPhase)>>
<<set _hmClothingEvent to _args[1]>>
<<if _hmClothingPhase is 2 and !_hmClothingEvent?.photoClothingBefore?.outer>>
    <<if _hmClothingMood is "reluctant">>你走到攝影燈前，低頭確認貼身衣物是否整理妥當。雖然已答應拍攝，真正面對鏡頭時仍有些緊張；你確認好站位，提醒自己完成這組便能拿到報酬。<br><br>
    <<elseif _hmClothingMood is "curious">>攝影師開始調整光線，你稍微整理身上的貼身衣物，既有些害羞，也好奇照片會呈現什麼效果。<br><br>
    <<else>>你站到預定的位置，整理好姿勢，將注意力放在燈光與構圖上。<br><br><</if>>
<<elseif _hmClothingPhase is 3 and !_hmClothingEvent?.photoClothingBefore?.outer and !_hmClothingEvent?.photoClothingBefore?.underwear>>
    <<if _hmClothingMood is "reluctant">>你走進攝影燈照亮的範圍，雖然身上沒有遮蔽身體的衣物，真正面對鏡頭時仍難免緊張。你再次確認拍攝的約定，努力把注意力放在姿勢與報酬上。<br><br>
    <<elseif _hmClothingMood is "curious">>攝影師調整好鏡頭，你站到光線下，試著想像這組藝術寫真的成果。你對構圖感到好奇，同時也留意著他是否遵守約定。<br><br>
    <<else>>你從容地站到光線下，專注確認自己的姿勢與攝影師安排的構圖，準備開始這組藝術寫真。<br><br><</if>>
<<else>>
<<if _hmClothingPhase is 2>>
    <<if _hmClothingMood is "reluctant">>
        你低頭看了看剛脫下的外層衣物，原本熟悉的穿著突然變得單薄許多。即使先前已經答應，真正站到攝影燈前，仍讓你忍不住確認衣物是否收好、巷口是否有人經過。你不由自主地整理了一下身上剩餘的衣料，暗自提醒自己：只要完成約定的幾張照片，就能拿到這一組的報酬。<br><br>
    <<elseif _hmClothingMood is "curious">>
        少了外層衣物，你站在鏡頭前時不由得多留意了幾分。你起初仍習慣性地整理衣角，隨後才發現攝影師正等著你站好。這樣的造型讓你有些難為情，卻也好奇自己在照片裡會呈現什麼模樣。你稍微調整肩膀，決定先試一張看看。<br><br>
    <<elseif _hmClothingMood is "eager">>
        你將脫下的外衣放到一旁，重新打量身上這套更簡潔的造型。與其擔心衣物少了多少，你反而開始注意衣料的線條、燈光落下的位置，以及自己能否擺出更漂亮的姿態。你從容地確認衣物沒有妨礙動作，抬頭示意攝影師可以開始。<br><br>
    <<else>>
        你望著被放到一旁的外衣，仍對接下來的造型有些不安，遲遲沒有走到鏡頭前。<br><br>
    <</if>>
<<elseif _hmClothingPhase is 3>>
    <<if _hmClothingMood is "reluctant">>
        當身上的衣物被暫時收起，你才真正意識到站在鏡頭前需要多少勇氣。少了熟悉的衣料，你下意識想抬起手臂遮擋，又想起自己已經答應完成這組藝術寫真。你站在原地調整呼吸，努力說服自己只要照著約定拍完，就能拿到那筆可觀的報酬；然而攝影師一舉起相機，你仍忍不住稍微側過身。<br><br>
    <<elseif _hmClothingMood is "curious">>
        你看了一眼整齊放在旁邊的衣物，才發現自己竟真的準備以這樣的狀態面對鏡頭。最初的難為情仍在，你不時想伸手整理早已不在身上的衣角，隨後又覺得自己的反應有些好笑。你試著放鬆肩膀，心裡既期待照片的成果，也暗暗希望攝影師不要提出超出約定的要求。<br><br>
    <<elseif _hmClothingMood is "eager">>
        你坦然將剩餘的衣物交給攝影師保管，站到燈光下時，已能把注意力放在自己的姿態與整體構圖上。你對這種沒有服裝修飾的藝術寫真並不排斥，反而讓你更在意肩線、站姿和光影是否協調。你自然地舒展身體，等候第一個拍攝指示，但也留意著攝影師是否遵守先前說好的範圍。<br><br>
    <<else>>
        你望著收好的衣物，對眼前的拍攝要求仍感到不安，暫時沒有走向攝影燈。<br><br>
    <</if>>
<</if>>
<</if>>
<</widget>>

/* 每幕最後一聲快門後的玩家反應：拍攝完成度 × 階段 × 進入該組時的心理。 */
<<widget "HonestMarketsPhotographerPhaseEnding">>
<<set _pePhase to _args[0]>><<set _peTier to _args[1]>><<set _peMood to _args[2]>>
<<set _peEnding to setup.HonestMarkets.photographerPhaseEnding(_hmPhoto, _pePhase, _peTier, _peMood)>>
<<if _peEnding>>
    <<= _peEnding.action>><br><br>
    <<= _peEnding.thought>><br>
<</if>>
<</widget>>

/* 中途離場心理：只描述玩家對拍攝及攝影師的感受；衣物收拾與穿回由離場劇情處理。 */
<<widget "HonestMarketsPhotographerEscapeMood">>
<<set _eePhase to _args[0]>><<set _eeMood to _args[1]>><<set _eePaid to _args[2]>>
<<if _eePhase lte 1>>
    <<if _eePaid is 0>>你回頭望了一眼仍在擺弄相機的攝影師，覺得這份突然出現的工作實在不值得冒險。遠處傳來的人聲讓你稍微安心。
    <<else>>你掂了掂已經拿到的報酬，慶幸自己至少沒有白忙一場。至於攝影師後來的提議，你越想越覺得沒有必要答應。<</if>>
<<elseif _eePhase is 2>>
    <<if _eeMood is "reluctant" or _eeMood is "blocked">>你一邊快步離開，一邊回想他剛才越來越大膽的要求。想到自己已經完成的拍攝，你有些猶豫，但最後還是覺得及時離開更重要。
    <<else>>你對這組造型有些好奇，但對方似乎總想再往前試探一步。你並不後悔先前的照片，只是不願把接下來的尺度交給他決定。<</if>>
<<else>>
    <<if _eeMood is "reluctant" or _eeMood is "blocked">>想到不久就能回到熱鬧的市集，你才稍稍放鬆下來。攝影師那些遲遲不肯結束的要求仍在腦中打轉，你暗自慶幸自己沒有繼續勉強配合。
    <<elseif _eeMood is "curious">>你對拍攝成果仍有些好奇，卻不想再回頭面對攝影師。享受過某些鏡頭，不代表你必須接受後續所有要求。
    <<else>>你確認報酬已經拿妥，對先前的表現沒有什麼遺憾。真正讓你決定離開的，是攝影師一再試探的態度，而不是拍攝本身。<</if>>
<</if>><br><br>
<</widget>>

/* 領款演出：每組根據階段、表現與拍攝自在程度改變細節。
 * 心理收束仍由 PhaseEnding 負責；此處著重攝影師如何交錢，以及玩家領款當下的反應。
 * printmoney 只傳入已計算的變數，避免 SugarCube 將 Math.round(...) 拆成多個巨集參數。
 */
<<widget "HonestMarketsPhotographerSettlement">>
<<set _ps to _args[0]>>
<<if _ps>>
    <<set _psPennies to Math.round(Number(_ps.amount || 0) * 100)>>
    <<set _psVariant to (_ps.phase + _ps.tier) % 3>>
    <<if _ps.tier is 0>>
        攝影師在相機螢幕上來回翻找，刪去幾張失焦的照片，最後勉強挑出可以留下的成品。他抿了抿嘴，像是還想再提什麼要求，卻終究只是將約定的報酬數了出來。
    <<elseif _ps.tier is 1>>
        攝影師仔細比較了幾張照片，指著其中一張說構圖總算抓到了感覺。他將相機放到一旁，從錢包裡取出報酬，示意你清點。
    <<elseif _ps.tier is 2>>
        攝影師翻到後半段的照片時，神情明顯亮了起來。「這幾張不錯，你找到感覺了。」他又多看了一眼螢幕，才把事先準備好的報酬交給你。
    <<else>>
        攝影師一張接著一張地翻看照片，幾次想關掉預覽，卻又忍不住返回剛才的畫面。「這次拍得真好……」他說到一半才察覺自己看得太入神，連忙收起相機，拿出約定的報酬。
    <</if>><br><br>
    <<if _ps.phase is 0>>
        <<if _ps.tier lte 1>>你接過錢，重新確認了一遍數目。第一次拍攝的生疏還留在心頭，但至少這份臨時工作真的換到了報酬。
        <<else>>你接過報酬，指尖不自覺地把鈔票理齊。想到剛才鏡頭裡的自己，你對接下來的拍攝多了幾分把握。<</if>>
    <<elseif _ps.phase is 1>>
        <<if _ps.tier lte 1>>你一面收好報酬，一面活動剛才維持姿勢而有些僵硬的肩膀。攝影師已經開始整理下一組的鏡位，你卻想先喘口氣。
        <<else>>你將報酬收妥，回想那些原本以為難以完成的姿勢，心裡多了幾分成就感。攝影師還在翻看照片，似乎比你更捨不得結束這一組。<</if>>
    <<elseif _ps.phase is 2>>
        <<if _ps.mood is "reluctant">>你伸手接過錢，另一隻手仍下意識地整理著身上的衣物。攝影師的目光又飄向相機螢幕，你沒有催他，只希望他這次真的已經拍夠了。
        <<elseif _ps.mood is "curious">>你收下報酬，忍不住瞥了一眼螢幕上的成品。照片確實比你想像中自然，但想到他幾次反覆調整局部鏡位，你還是沒有完全放下戒心。
        <<else>>你從容地清點報酬，也順勢看了看成品。你對自己的表現頗為滿意，只是攝影師盯著螢幕的時間，似乎比確認照片品質所需的還要久。<</if>>
    <<else>>
        <<if _ps.mood is "reluctant">>你接過最後一筆錢，立即將它收好，目光已經移向放在一旁的衣物。這筆報酬確實可觀，但你更想結束攝影師那一再拖長的注視。
        <<elseif _ps.mood is "curious">>你仔細收起報酬，心裡仍惦記著剛才拍出的照片。那份好奇與成就感是真實的；只是攝影師幾次不肯移開鏡頭的模樣，也同樣讓你難以忽視。
        <<else>>你坦然收下報酬，甚至主動確認了其中幾張成品的構圖。你很清楚自己完成得不錯，也很清楚攝影師後來的反覆取景，已經不全是為了作品。<</if>>
    <</if>><br><br>
    <span class="gold">本組報酬：<<printmoney _psPennies>>。</span><br>
<</if>>
<</widget>>

:: HonestMarkets Photographer Widgets[widget]
<<widget "HonestMarketsEncounterPhotographer">>
    <<set _hmPhoto to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmPhoto and _hmPhoto.id is "alley_photographer">>
        <<if _hmPhoto.stage is "invitation">>
            一位揹著相機的攝影師在市集裡攔住你，表示正在尋找臨時模特兒，願意支付拍攝報酬。<br><br>
            <<if _hmPhoto.phase is 2>>
                攝影師打量了一下你的造型，提出以貼身衣物為主題的寫真邀請。「我想拍一組以姿態和光線為主的照片，願意試試嗎？報酬可以談。」<br><br>
            <<elseif _hmPhoto.phase is 3>>
                攝影師詢問你是否願意參與一組以人體線條與光影為主的藝術寫真。<<if setup.HonestMarkets.modelWardrobeSlots.some(slot => _hmPhoto.photoStartPhase is 3 && $worn[slot]?.name && $worn[slot].name !== "naked")>>「拍攝時需要暫時收好鞋襪及其他穿戴配件。」<</if>><br><br>
            <<else>>
                「附近有個安靜的地方，光線正好。要不要來拍幾組照片？」<br><br>
            <</if>>
            <<set _hmInviteMood to setup.HonestMarkets.photographerOfferMood(_hmPhoto.phase)>>
            <<if _hmInviteMood is "blocked">>
                這樣的拍攝要求超出了你願意接受的程度，你決定不跟他離開。<br><br>
            <<else>>
                <<link "跟隨攝影師" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
                <</link>><<if _hmPhoto.phase is 2>> <<exhibitionist3>><<elseif _hmPhoto.phase is 3>> <<exhibitionist5>><</if>><br>
            <</if>>
            <<link "拒絕邀請" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("decline")>>
            <</link>><br>
        <<elseif _hmPhoto.stage is "shoot">>
            <<if _hmPhoto.phase is _hmPhoto.photoStartPhase and _hmPhoto.phase gt 0>>
                你跟著攝影師離開市集，轉進一條安靜的小巷。人群的喧鬧聲漸漸遠去；他挑了一處光線合適的位置架起相機，確認構圖後示意你站到鏡頭前。<br><br>
            <</if>>
            <<if _hmPhoto.phase is 0>>
                你跟著攝影師穿過市集，走進一條偏僻的小巷。小販的叫賣聲被拋在身後，這裡幾乎不見行人。他在牆邊架好相機，示意你先從普通人像開始。<br><br>
            <<elseif _hmPhoto.phase is 1>>
                換過鏡位後，攝影師希望這組照片比剛才更有動感。他示範了幾個轉身與伸展的姿態，請你依照自己的節奏試試。<br><br>
            <<elseif _hmPhoto.phase is 2>>
                <<if _hmPhoto.photoClothingBefore?.outer>>攝影師請你暫時脫下外層服裝，以貼身衣物造型配合燈光與構圖。<<else>>攝影師調整燈光與背景，請你以目前的貼身衣物造型站到鏡頭前。<</if>><br><br>
                <<HonestMarketsPhotographerClothingMood _hmPhoto.phase _hmPhoto>>
            <<else>>
                <<if _hmPhoto.photoClothingBefore?.outer or _hmPhoto.photoClothingBefore?.underwear>>你將需要暫時取下的衣物與配件交由攝影師收好。<<elseif _hmPhoto.photoChangedThisPhase>>你將鞋襪或配件暫時交由攝影師保管。<<else>>攝影師確認好鏡位與光線。<</if>>藝術寫真拍攝開始，他調整鏡頭距離，安排人物構圖。<br><br>
                <<HonestMarketsPhotographerClothingMood _hmPhoto.phase _hmPhoto>>
            <</if>>
            /* 鏡位敘述順序：姿勢、完成度、從容度、攝影師反應。 */
            <<for _hmPoseIndex = 0; _hmPoseIndex < 3; _hmPoseIndex++>>
                <<set _hmPose to setup.HonestMarkets.photographerPoseData(_hmPhoto, _hmPoseIndex)>>
                <<if _hmPose>>
                    <<set _hmCameraReaction to setup.HonestMarkets.photographerCameraReaction(_hmPhoto, _hmPoseIndex)>>
                    <<HonestMarketsPhotographerPoseText _hmPose.poseId (_hmCameraReaction ? _hmCameraReaction.focus : "") _hmPhoto _hmPoseIndex>>
                            <<if _hmPoseIndex is 0>>
                        <<HonestMarketsPhotographerMovement _hmPose.action _hmPhoto.performance[_hmPhoto.phase].danceTier>>
                    <<elseif _hmPoseIndex is 1 and _hmPhoto.phase < 2>>
                        <<HonestMarketsPhotographerComposure _hmPhoto.phase _hmPhoto.performance[_hmPhoto.phase].calmTier _hmPoseIndex>>
                    <</if>>
                <</if>>
                <<if _hmCameraReaction>>
                    <<HonestMarketsPhotographerCameraReaction _hmCameraReaction>>
                <</if>>
                <br>
            <</for>>
            <<HonestMarketsPhotographerReview _hmPhoto.performance[_hmPhoto.phase].tier _hmPhoto.phase (_hmPhoto.photoReviewVariants ? _hmPhoto.photoReviewVariants[_hmPhoto.phase] : (_hmPhoto.phase + _hmPhoto.performance[_hmPhoto.phase].tier + _hmPhoto.completedCount)) _hmCameraReaction>><br>
            <<HonestMarketsPhotographerPhaseEnding _hmPhoto.phase _hmPhoto.performance[_hmPhoto.phase].tier _hmPhoto.offerMood>><br>
            <<link "完成這組拍攝並領取報酬" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("finish")>>
            <</link>><br>
        <<elseif _hmPhoto.stage is "offer">>
            <<HonestMarketsPhotographerSettlement _hmPhoto.lastSettlement>><br>
            清點完這組報酬，攝影師沒有立刻收工，而是指向另一處取景位置，詢問你願不願意再拍一組。<br><br>
            <<if _hmPhoto.phase is 1>>
                「這次試試更有張力的姿勢，報酬也會提高。」<br><br>
            <<elseif _hmPhoto.phase is 2>>
                「這組需要先脫去外層服裝，再拍一些更有張力的姿勢。」<br><br>
            <<else>>
                「我想拍一組以人體線條和光影為主的藝術寫真，需要暫時收好身上剩餘的衣物、鞋襪與配件，報酬也會提高。」<br><br>
            <</if>>
            <<set _hmPhotoRequirement to setup.HonestMarkets.photographerOfferRequirement(_hmPhoto.phase)>>
            <<set _hmPhotoMood to setup.HonestMarkets.photographerOfferMood(_hmPhoto.phase)>>
            <<if _hmPhotoRequirement > 0>>
                <<if _hmPhotoMood is "reluctant">>
                    這樣的要求讓你有些害羞。你遲疑著看向對方開出的報酬，想到這筆錢確實不少，最後還是決定試著配合。<br><br>
                <<elseif _hmPhotoMood is "curious">>
                    你仍有些害羞，但想到豐厚的報酬，心裡除了緊張，竟也升起一絲莫名的興奮。<br><br>
                <<elseif _hmPhotoMood is "eager">>
                    對方越來越大膽的要求反而讓你有些期待。你看了看報酬，發現自己不只是為了錢，也開始享受這場拍攝。<br><br>
                <</if>>
            <<else>>
            <</if>>
            <<if _hmPhotoMood is "blocked">>
                你無法接受對方繼續加碼的要求，只想盡快離開這條小巷。<br><br>
                <<link "逃離小巷" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("escape")>>
                <</link>><br>
            <<else>>
                <<link "接受拍攝邀請" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("continue")>>
                <</link>><<if _hmPhotoRequirement is 3>> <<exhibitionist3>><<elseif _hmPhotoRequirement is 5>> <<exhibitionist5>><</if>><br>
                <<link "結束拍攝並離開" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("escape")>>
                <</link>><br>
            <</if>>
        <<elseif _hmPhoto.stage is "photo_final">>
            /* 攝影結果只在尚未離場時顯示，避免追逐每回合重複結算文字。 */
            <<if _hmPhoto.photoOutcome is "declined">>
                你沒有接受陌生攝影師的邀請，轉身回到市集的人潮之中。<br><br>
            <<elseif _hmPhoto.photoOutcome is "escaped">>
                <<if _hmPhoto.photoEscapeWithClothes>>
                    你抓起拍攝期間脫下的衣物，匆忙離開拍攝位置。直到找到另一處安靜的角落，你才停下腳步，將衣物重新穿妥，準備返回市集。<br><br>
                <<else>>
                    你沒有理會攝影師的挽留，快步離開拍攝位置，沿著小巷往市集的方向走去。<br><br>
                <</if>>
                <<HonestMarketsPhotographerEscapeMood _hmPhoto.phase _hmPhoto.escapeMood _hmPhoto.completedCount>>
                已經收到的報酬仍留在你身上；未完成的拍攝不會再付款。<br><br>
            <<elseif _hmPhoto.photoOutcome is "restore_failed">>
                拍攝結束，但衣物還原發生問題。請檢查衣櫃狀態。<br><br>
            <<elseif _hmPhoto.photoOutcome is "complete">>
                最後一聲快門落下，攝影師確認照片已經拍齊，開始收拾器材。<br><br>
                <<HonestMarketsPhotographerSettlement _hmPhoto.lastSettlement>><br>
                你確認衣物與隨身物品都已收妥，向攝影師道別，獨自踏上返回市集的小巷。<br><br>
            <</if>>
            <<set _hmPhotoTotalPennies to Math.round(((_hmPhoto.payments[0] || 0) + (_hmPhoto.payments[1] || 0) + (_hmPhoto.payments[2] || 0) + (_hmPhoto.payments[3] || 0)) * 100)>>
            本次已領取報酬：<<printmoney _hmPhotoTotalPennies>>。<br><br>
            <<link "返回市集" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("return_depart")>><</link>>
        <<elseif _hmPhoto.stage is "follow_intro">>
            <<if _hmPhoto.photoFollowOriginalResult is "escaped">>
                <<if _hmPhoto.photoFollowVariant is 0>>你沿著小巷往市集走去，卻聽見身後的腳步聲始終沒有遠去。回頭一看，竟是剛才那名攝影師。<</if>>
                <<if _hmPhoto.photoFollowVariant is 1>>你原以為已經擺脫了攝影師，沒想到才沿著小巷走了一段路，那個熟悉的身影又出現在身後。<</if>>
                <<if _hmPhoto.photoFollowVariant is 2>>你正沿著小巷返回市集，察覺有人始終與你保持著距離。你突然停下腳步，認出了身後的攝影師。<</if>>
            <<else>>
                <<if _hmPhoto.photoFollowVariant is 0>>你沿著小巷往市集走去，身後卻傳來與你步調相近的腳步聲。你回頭一看，竟是剛才的攝影師。<</if>>
                <<if _hmPhoto.photoFollowVariant is 1>>你才離開拍攝的位置不久，就察覺身後有個熟悉的身影。攝影師不知何時已經跟了上來。<</if>>
                <<if _hmPhoto.photoFollowVariant is 2>>你走在返回市集的小巷裡，忽然停下腳步，身後的腳步聲也跟著停了。轉過頭，你看見攝影師站在不遠處。<</if>>
            <</if>><br><br>
            對方發現你已經察覺，突然加快腳步。你轉身跑了起來！<br><br>
            <<link "快跑！" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("follow_begin")>><</link>>
        <<elseif _hmPhoto.stage is "follow_chase">>
            <<hmChaseView>>
        <<elseif _hmPhoto.stage is "follow_escaped">>
            身後的腳步聲漸漸消失。你仍不敢立刻停下，直到確認攝影師沒有跟上來，才放慢腳步，循著人聲尋找回市集的路。<br><br>
            <<link "返回市集" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("follow_escape_finish")>><</link>>
        <<elseif _hmPhoto.stage is "follow_caught">>
            <<if _hmPhoto.photoFollowCaughtVariant is 0>>攝影師追上你，擋住去路，臉上已經沒有拍攝時那副親切的笑容。「拍照只是個開始。我還有別的打算。」
            <<elseif _hmPhoto.photoFollowCaughtVariant is 1>>你還沒來得及轉過下一個彎，攝影師就攔在你面前。「別急著走，我還沒打算就這麼結束。」
            <<else>>攝影師終於追上你，把相機放到一旁，露出令人不安的笑容。你明白對方的目的早已不是拍照。<</if>><br><br>
            <<link "奮力抵抗" "HonestMarkets Photographer Combat">><<run setup.HonestMarkets.resolveMarketEncounter("follow_combat")>><<set $sexstart to 1>><</link>>
        <<elseif _hmPhoto.stage is "return_safe">>
            你繼續沿著小巷前行，偶爾回頭確認，始終沒有再看見攝影師。前方逐漸傳來攤販的叫賣聲，市集就在不遠處。<br><br>
            <<link "返回市集" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("return_finish")>><</link>>
        <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterPhotographerResult">>
    <<set _hmPhoto to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmPhoto>>
        <<if _hmPhoto.result is "declined">>
            你沒有接受陌生攝影師的邀請，轉身回到市集的人潮之中。<br><br>
        <<elseif _hmPhoto.result is "restore_failed">>
            拍攝結束，但衣物還原發生問題。請檢查衣櫃狀態。<br><br>
        <<elseif _hmPhoto.result is "escaped">>
            你回到熱鬧的市集，混入往來的人群，這才真正確定攝影師已被甩開。<br><br>
        <<elseif _hmPhoto.result is "combat">>
            你穿過最後一段小巷，終於回到市集。周圍的人聲讓你稍稍安心，但剛才的衝突仍令你心有餘悸。<br><br>
        <<elseif _hmPhoto.result is "complete">>
            你再次走進熟悉的攤販間，這趟臨時拍攝工作總算真正結束。<br><br>
        <</if>>
        /* 報酬總額已在 photo_final 結算，返回市集時不重複列出。 */
    <</if>>
<</widget>>

:: HonestMarkets Photographer Combat[]
<<set $outside to 1>>
<<effects>>
<<if $sexstart is 1>>
    <<set $sexstart to 0>>
    <<set $consensual to 0>>
    <<neutral 1>>
    <<maninit>>
    <<run setup.HonestMarkets.photographerNameNPC("變態攝影師")>>
    攝影師攔住你，企圖強行控制你。你只能設法反抗並尋找脫身的機會。<br><br>
<<else>>
    <<if setup.HonestMarkets.rollChance(35)>>
        <<if random(1,2) is 1>>你試著與對方拉開距離，尋找逃跑的機會。
        <<else>>攝影師仍緊盯著你，不肯讓你離開。<</if>><br><br>
    <</if>>
<</if>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
    <span id="next"><<link [[繼續|HonestMarkets Photographer Combat Finish]]>><</link>></span><<nexttext>>
<<else>>
    <span id="next"><<link [[繼續|HonestMarkets Photographer Combat]]>><</link>></span><<nexttext>>
<</if>>

:: HonestMarkets Photographer Combat Finish[]
<<effects>>
<<if $enemyarousal gte $enemyarousalmax and $enemyhealth gt 0>>
    <<ejaculation "short">>
<</if>>
<<if $enemyhealth lte 0>>
    攝影師終於無力再攔住你。你趁他尚未回過神，沿著巷道快步離開。<br><br>
<<elseif $enemyarousal gte $enemyarousalmax>>
    一番掙扎後，攝影師終於停下動作。你趁對方分神，迅速離開。<br><br>
<<else>>
    你抓住他露出破綻的瞬間掙脫，轉身朝巷道出口跑去。<br><br>
<</if>>
<<clotheson>>
<<endcombat>>
<<link "返回市集" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("follow_combat_finish")>><</link>>

:: HonestMarkets Collector Combat[]
<<set $outside to 1>>
<<effects>>
<<if $sexstart is 1>>
    <<set $sexstart to 0>>
    <<consensual>>
    <<set $consensual to 1>>
    <<neutral 1>>
    <<maninit>>
    <<set $enemyanger to 0>>
    聽見你答應了最後的邀約，對方先是微微一怔，隨即露出比先前更加燦爛的笑容。<br><br>
    「真的？太好了！我原本還以為你會拒絕呢。」<br><br>
    他似乎有些喜出望外，連說話的語氣都比剛才熱切了幾分。<br><br>
    「放心，說好的報酬一分都不會少。像你這樣願意陪我完成這筆特殊交易的人，可不是每天都能遇見的。」<br><br>
    你環顧四周。這處僻靜的地方依然沒有其他人的蹤影，彷彿整個熱鬧的市集都被隔絕在外。<br><br>
    /* 開場心理差分僅描述玩家的態度，不改變戰鬥狀態。 */
    <<if $exhibitionism lte 20>>
        想到自己竟然答應了如此大膽的要求，你不由得有些緊張。儘管已經做出決定，心裡仍忍不住懷疑自己是不是太衝動了。<br><br>
    <<elseif $exhibitionism lte 60>>
        你對這筆意料之外的交易感到有些難為情，但心底也浮現出一絲好奇。事情都已經發展到這一步，你不禁想知道接下來會如何。<br><br>
    <<else>>
        你倒是沒有多少猶豫。既然對方願意開出如此優厚的條件，而你也已經答應了這筆交易，自然沒有必要再扭扭捏捏。<br><br>
    <</if>>
    對方滿懷期待地望著你，臉上的笑意始終沒有消退。<br><br>
    「那麼，我們開始吧？」<br><br>
<<else>>
    /* 回合僅偶爾插入簡短評語，不描述動作或場景變更。 */
    <<if setup.HonestMarkets.rollChance(20)>>
        <<set _hmCollectorCombatText to random(1, 5)>>
        <<if _hmCollectorCombatText is 1>>
            「真沒想到，你竟然真的答應了。」他語氣裡透著掩不住的欣喜。<br><br>
        <<elseif _hmCollectorCombatText is 2>>
            「今天可真是讓我大開眼界。」對方忍不住讚嘆。<br><br>
        <<elseif _hmCollectorCombatText is 3>>
            「這筆交易，恐怕會讓我記上很久。」他低聲感嘆。<br><br>
        <<elseif _hmCollectorCombatText is 4>>
            「你總能讓我感到意外。」對方笑著說。<br><br>
        <<else>>
            「我開始覺得，自己開出的價碼還不夠高了。」他半開玩笑地說道。<br><br>
        <</if>>
    <</if>>
<</if>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
    <span id="next"><<link [[繼續|HonestMarkets Collector Combat Finish]]>><</link>></span><<nexttext>>
<<else>>
    <span id="next"><<link [[繼續|HonestMarkets Collector Combat]]>><</link>></span><<nexttext>>
<</if>>

:: HonestMarkets Collector Combat Finish[]
<<effects>>
<<set _hmCollectorCompleted to $enemyarousalmax gt 0 and $enemyarousal gte $enemyarousalmax and $enemyhealth gt 0>>
<<set _hmCollectorKnockedOut to $enemyhealth lte 0>>
<<if _hmCollectorKnockedOut>>
    對方原本還滿懷期待地望著你，卻沒料到迎面而來的竟是一記拳頭。<br><br>
    「等、等等——！」<br><br>
    他整個人向後飛了出去，重重摔在地上，一時間連話都說不出來。<br><br>
    你低頭看看自己的拳頭，又看看倒在遠處的對方。<br><br>
    ……這場交易的發展，好像連你自己都沒有預料到。<br><br>
    至於原先說好的那筆報酬，看來是不用指望了。<br><br>
<<elseif _hmCollectorCompleted>>
    <<ejaculation "short">>
    這場意料之外的親密交易終於告一段落。<br><br>
    對方望著你，臉上仍掛著難以掩飾的笑容，似乎還沉浸在剛才的經歷之中。<br><br>
    「真是令人難忘……原本只是想買下你的衣物，沒想到今天竟然會有這麼多意外的收穫。」<br><br>
    他依照約定付清報酬，隨後又上下打量你的<<breasts>>及<<genitals>>，你身上還殘留著剛剛雲雨過後的痕跡。<br><br>
    他似乎忽然想到了什麼，從隨身物品中取出一條浴巾，遞到你的面前。<br><br>
    「嗯……還是先把這個套上吧。」<br><br>
    /* 對浴巾的心理反應：沿用開場的暴露程度分級。 */
    <<if $exhibitionism lte 20>>
        你原本就對自己現在的模樣有些難為情，看見對方遞來浴巾，心裡總算鬆了口氣。不過仔細想想，把你弄得一件衣服都不剩的人，不正是他嗎？<br><br>
    <<elseif $exhibitionism lte 60>>
        你看著他遞來的浴巾，一時間竟有些哭笑不得。明明是他買走了你的全部衣物，現在卻又擔心你沒東西穿，這人還真是奇怪。<br><br>
    <<else>>
        你忍不住覺得有些好笑。剛才還對你的模樣讚不絕口，現在卻突然要你裹上浴巾。你倒是不介意繼續這樣待著，不過既然是對方的一番好意，收下也無妨。<br><br>
    <</if>>
    你接過浴巾，將它裹在身上。<br><br>
    「希望以後還有機會見到你。」<br><br>
    對方露出滿意的笑容，帶著從你這裡買下的衣物離開了。<br><br>
    你目送他的背影消失，這場出乎意料的交易終於正式結束。<br><br>
<<else>>
    這場額外的交易沒能按照原先的約定完成。<br><br>
    對方看了看你，原本滿懷期待的神情漸漸變得有些複雜。<br><br>
    「唉，真可惜……看來今天只能到此為止了。」<br><br>
    他無奈地搖搖頭。<br><br>
    「既然沒有完成約定，最後那筆報酬恐怕也不能支付了。希望你能理解。」<br><br>
    這場特殊的交易就此結束。<br><br>
<</if>>
/* 先完成原版戰鬥收尾，再處理浴巾；僅正常完成時贈送。 */
<<clotheson>>
<<run setup.HonestMarkets.resolveMarketEncounter("intimate_combat_finish")>>
<<endcombat>>
<<if _hmCollectorCompleted>>
    <<exposure>><<towelup>>
<</if>>
<<honestMarketsEncounterResult>>
<<run setup.HonestMarkets.clearMarketEncounter()>>
<<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>

:: HonestMarkets Encounter[]
<<honestMarketsEncounter>>

:: HonestMarkets Encounter Continue[]
<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
<<if _hmEncounter and !_hmEncounter.result>>
    <<honestMarketsEncounter>>
<<else>>
    <<include "HonestMarkets Encounter Result">>
<</if>>

:: HonestMarkets Encounter Result[]
<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
<<honestMarketsEncounterDebug>>
<<if !_hmEncounter>>市場的人潮仍舊熙熙攘攘。<br><br><<else>>
    <<honestMarketsEncounterResult>>
<</if>>
<<if !_hmEncounter>>
    <<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>
<<elseif _hmEncounter.result isnot "escalate">>
    <<run setup.HonestMarkets.clearMarketEncounter()>>
    <<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>
<</if>>

:: HonestMarkets Combat[]
<<set $outside to 1>>
<<effects>>
<<if $sexstart is 1>>
	<<set $sexstart to 0>>
	<<if $honestMarketsCombatConsensual is 1>>
		<<consensual>>
		<<set $consensual to 1>>
	<<else>>
		<<set $consensual to 0>>
	<</if>>
	<<neutral 1>>
	<<maninit>>
	<<if $honestMarketsCombatSource is "stall_compensation">>
		<<if $honestMarketsCombatConsensual is 1>>
			<<set $enemyanger to 0>>
		<<else>>
			<<set $enemyanger to 500>>
		<</if>>
		<<if $honestMarketsCombatConsensual is 1>>你提出用別的方式抵償損失。攤販愣了一下，隨即明白了你的意思，目光在你身上停留片刻後接受了這個提議。對方朝四周看了一眼，隨後領著你繞到攤位後方，把你帶進堆放貨物的小倉庫。前台的喧鬧聲被門板隔在外頭，這才開始談起這筆「賠償」要怎麼算。<br><br>
		<<else>>你翻遍身上的口袋，卻連一點能拿來賠償的錢都找不出來。攤販盯著你看了一會兒，顯然不打算就這麼放你走。<br><br>「沒錢？那就用別的方式賠。」<br><br>對方一把抓住你，避開前頭來往的人群，硬是把你拉到攤位後方堆放貨物的小倉庫裡。門一關上，市場的喧鬧頓時隔遠了不少。<br><br><</if>>
	<<elseif $honestMarketsCombatSource is "crowd_grope">>
		你試著掙脫，對方卻猛地抓緊你，藉著四周擁擠的人潮遮掩，硬是把你往一旁拖去。等你終於站穩時，已經被拉進幾座攤位後方狹窄的貨運通道。堆放的木箱和垂下的棚布擋住了市場裡大部分人的視線，外頭的叫賣聲卻依然近在咫尺。<br><br>
	<</if>>
<<else>>
	<<set _hmCombatSpecialText to 0>>

	/* 志願賠償的隱藏受傷彩蛋：依 NPC 剩餘生命百分比分三階段，且每階段只顯示一次。 */
	<<if $honestMarketsCombatSource is "stall_compensation" and $honestMarketsCombatConsensual is 1 and $enemyhealthmax gt 0>>
		<<set _hmEnemyHealthPercent to ($enemyhealth / $enemyhealthmax) * 100>>
		<<if _hmEnemyHealthPercent lte 25 and !$honestMarketsCombatHealthText25>>
			<<set $honestMarketsCombatHealthText25 to 1>>
			<<set _hmCombatSpecialText to 1>>
			攤販狼狽地扶住旁邊的貨箱，看你的表情像是終於開始懷疑，自己答應這筆「賠償」是不是一個嚴重的錯誤。<br><br>
		<<elseif _hmEnemyHealthPercent lte 50 and !$honestMarketsCombatHealthText50>>
			<<set $honestMarketsCombatHealthText50 to 1>>
			<<set _hmCombatSpecialText to 1>>
			攤販捂著被你打中的地方退了半步，看向你的眼神已經從困惑逐漸變成警戒。這場「賠償」的發展似乎和對方原先想像的不太一樣。<br><br>
		<<elseif _hmEnemyHealthPercent lte 75 and !$honestMarketsCombatHealthText75>>
			<<set $honestMarketsCombatHealthText75 to 1>>
			<<set _hmCombatSpecialText to 1>>
			攤販挨了你一下，錯愕地看著你，似乎沒想到你所說的「別的方式」還包括這個。<br><br>
		<</if>>
	<<elseif $honestMarketsCombatSource is "stall_compensation" and $honestMarketsCombatConsensual is 1>>
	    <<set $enemyanger to 0>>
	<</if>>

	/* 沒有觸發特殊彩蛋時，偶爾補上市集／倉庫本身的回合互動。 */
	<<if !_hmCombatSpecialText and setup.HonestMarkets.rollChance(40)>>
		<<set _hmCombatText to random(1, 4)>>
		<<if $honestMarketsCombatSource is "stall_compensation">>
			<<if $honestMarketsCombatConsensual is 1>>
				<<if $enemyarousalmax gt 0 and $enemyarousal gte ($enemyarousalmax * 0.75)>>
					對方的呼吸明顯變得急促，原本還不時留意門外動靜的視線，也漸漸只剩下眼前這場「賠償」。<br><br>
				<<elseif _hmCombatText is 1>>
					門外仍是不間斷的叫賣聲。偶爾有人從倉庫前經過，卻沒有人特地往裡頭多看一眼。<br><br>
				<<elseif _hmCombatText is 2>>
					你們的動作碰到了身旁堆放的貨物，幾個箱子晃了晃，發出一陣令人不安的碰撞聲。<br><br>
				<<elseif _hmCombatText is 3>>
					門外傳來幾個人的腳步聲，但很快又混進市場嘈雜的人聲裡，逐漸遠去。<br><br>
				<<else>>
					狹窄的倉庫裡幾乎沒有多少活動空間，你只能不時避開身旁堆得亂七八糟的貨物。<br><br>
				<</if>>
			<<else>>
				<<if $enemyarousalmax gt 0 and $enemyarousal gte ($enemyarousalmax * 0.75)>>
					對方的呼吸越來越急促，堵在你與倉庫出口之間的動作卻絲毫沒有放鬆。<br><br>
				<<elseif _hmCombatText is 1>>
					你試著往門口挪近一些，攤販立刻察覺了你的意圖，再次擋在你和出口之間。<br><br>
				<<elseif _hmCombatText is 2>>
					外頭傳來一陣清楚的談笑聲，你下意識望向門口，對方也跟著回頭看了一眼，但腳步聲很快便遠去了。<br><br>
				<<elseif _hmCombatText is 3>>
					混亂中你撞上旁邊堆放的貨箱，沉悶的聲響被市場的喧鬧輕易蓋了過去。<br><br>
				<<else>>
					倉庫的門就在不遠處，但狹窄的空間和擋在面前的攤販讓你很難直接衝出去。<br><br>
				<</if>>
			<</if>>
		<<elseif $honestMarketsCombatSource is "crowd_grope">>
			<<if $enemyarousalmax gt 0 and $enemyarousal gte ($enemyarousalmax * 0.75)>>
				對方的呼吸變得急促，原本還不時留意通道口的視線也逐漸少了，似乎已經顧不上外頭隨時可能經過的人。<br><br>
			<<elseif _hmCombatText is 1>>
				外頭的腳步聲不時從通道口經過，但成排的貨箱和垂下的棚布遮住了裡頭大部分動靜。<br><br>
			<<elseif _hmCombatText is 2>>
				你試著往通道口退去，對方立刻跟著逼近，再次擋住你回到市場人群中的路。<br><br>
			<<elseif _hmCombatText is 3>>
				不遠處傳來攤販搬動貨物的聲音，木箱碰撞的動靜一度近得像就在轉角，隨後又逐漸遠去。<br><br>
			<<else>>
				一陣腳步聲突然從通道另一頭接近。對方的動作停頓了一瞬，直到聲音從外頭經過、重新混進市場的喧鬧裡。<br><br>
			<</if>>
		<</if>>
	<</if>>
<</if>>
<<effects>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
	<span id="next"><<link [[繼續|HonestMarkets Combat Finish]]>>
	<</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[繼續|HonestMarkets Combat]]>>
	<</link>></span><<nexttext>>
<</if>>

:: HonestMarkets Combat Finish[]
<<set $outside to 1>>
<<effects>>
<<if $honestMarketsCombatSource is "stall_compensation" and $honestMarketsCombatConsensual is 1>>
	<<if $enemyhealth lte 0>>
		<<set _hmLootQty to random(1, 3)>>
		事情的發展似乎和一開始說好的不太一樣。攤販倒在倉庫裡，一時半會兒顯然沒辦法再和你討論什麼「賠償」。<br><br>
		你整理好自己的衣物，若無其事地推開倉庫的門。經過前頭那座被你掀得一片狼藉的攤位時，你順手從散落的貨物裡撿了 <<print _hmLootQty>> 份<<foodstufficon $honestMarketsCombatLootItem>>「<<print setup.HonestMarkets.encounterItemName($honestMarketsCombatLootItem)>>」塞進身上，這才重新混進市場的人潮中。<br><br>
		<<tending_give $honestMarketsCombatLootItem _hmLootQty>>
		至於那筆帳……現在看來，似乎反而是你賺了一點。
	<<else>>
		<<if $enemyarousal gte $enemyarousalmax>>
			<<ejaculation>>
		<</if>>
		這場約定好的「賠償」總算結束。攤販整理好自己，又看了你一眼，顯然認為這筆帳已經兩清。<br><br>「行了，這次就算了。」<br><br>對方打開倉庫的門，先一步回到攤位前收拾那片狼藉。你也重新整理好衣物，從後方回到市場的人潮中。
	<</if>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	<<if $honestMarketsCombatSource is "stall_compensation">>攤販終於認為你已經付出了足夠的「代價」。對方鬆開你，整理好自己後打開倉庫的門，轉身回去處理被掀得一片狼藉的攤位，沒有再攔住你的去路。
	<<elseif $honestMarketsCombatSource is "crowd_grope">>對方終於停了下來。你抓住機會退到通道口，繞過堆放的貨箱回到市場的人群裡，總算和對方拉開了距離。
	<<else>>對方終於停了下來。你總算擺脫糾纏，重新拉開了距離。<</if>>
<<elseif $enemyhealth lte 0>>
	<<if $honestMarketsCombatSource is "stall_compensation">>你終於抓住機會擺脫對方。趁對方一時無法阻攔，你推開倉庫的門衝回市場，迅速鑽進來往的人群。至於那筆賠償，現在顯然沒有人能攔住你繼續逃了。
	<<elseif $honestMarketsCombatSource is "crowd_grope">>你總算掙脫對方，趁對方一時無法阻攔，立刻衝出狹窄的貨運通道，重新鑽回市場的人群中。對方沒有再追上來。
	<<else>>你總算掙脫對方，立刻退到較為開闊的地方。對方沒有再追上來。<</if>>
<<else>>
	<<if $honestMarketsCombatSource is "stall_compensation">>倉庫裡的混亂總算告一段落。攤販沒有再繼續糾纏，打開門讓你離開。你重新整理好自己，回到市場的人潮中。
	<<elseif $honestMarketsCombatSource is "crowd_grope">>貨運通道裡的糾纏總算停了下來。你重新整理好自己，繞過堆放的貨箱回到外頭的市場，迅速混進來往的人群。
	<<else>>糾纏總算停了下來。你重新整理好自己，和對方拉開距離。<</if>>
<</if>>
<br><br>
<<clotheson>>
<<endcombat>>
<<unset $honestMarketsCombatSource>>
<<unset $honestMarketsCombatConsensual>>
<<unset $honestMarketsCombatLootItem>>
<<unset $honestMarketsCombatHealthText75>>
<<unset $honestMarketsCombatHealthText50>>
<<unset $honestMarketsCombatHealthText25>>
<<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>>
<<endevent>><</link>>

:: HonestMarkets Clothier Trial[]
<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
<<if _hmEncounter and _hmEncounter.id is "suspicious_clothier" and _hmEncounter.stage is "trial">>
    <<if _hmEncounter.slot is "upper">>
        <<upperwear _hmEncounter.index _hmEncounter.colour>>
    <<else>>
        <<lowerwear _hmEncounter.index _hmEncounter.colour>>
    <</if>>
    <<set _hmTrialReady to setup.HonestMarkets.resolveMarketEncounter("trial_ready")>>
    <<if _hmTrialReady>>
        你走進攤位後方的試衣間，拉好門簾。<br><br>
        你換上小販遞來的衣服，對著鏡子調整衣角。尺寸倒是合適，但布料比你預想的少，剪裁也格外大膽。你試著拉平衣角，卻發現無論怎麼調整，都無法讓它看起來像普通的日常服裝。<br><br>
        隔間裡只有一面鏡子、一張矮凳和牆上的幾個衣鉤。你的原本衣服已經收好，門簾外則傳來市集不間斷的叫賣聲。<br><br>
        <<if $promiscuity gte 500>>
            你又對著鏡子看了一眼。雖然這套衣服大膽得超乎預期，你還是忍不住好奇它究竟賣多少錢。<br><br>
            <<link "詢問這套衣服的價格" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("ask_price")>>
            <</link>>
        <<else>>
            你越看越覺得不對勁。這套衣服讓你十分不自在，你下意識地拉了拉衣角，決定趕緊換回自己的衣服。<br><br>
            <<link "試著脫下衣服，換回原本的服裝" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("change_back")>>
            <</link>>
        <</if>>
    <<else>>
        <<run setup.HonestMarkets.resolveMarketEncounter("trial_failed")>>
        <<honestMarketsEncounterResult>>
        <<run setup.HonestMarkets.clearMarketEncounter()>>
        <<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>
    <</if>>
<<else>>
    <<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>
<</if>>

:: HonestMarkets Clothier Combat[]
<<set $outside to 0>>
<<effects>>
<<if $sexstart is 1>>
    <<set $sexstart to 0>>
    <<set $consensual to 0>>
    <<neutral 1>>
    <<maninit>>
    /* 小販起初試圖控制局面，而非立即暴怒；後續憤怒由原版戰鬥行為累積。 */
    <<set $enemyanger to 0>>
    <<set _hmClothierEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmClothierEncounter and _hmClothierEncounter.id is "suspicious_clothier" and _hmClothierEncounter.trialReaction is "ask_price">>
        你剛才只是詢問這套衣服的價錢，小販卻始終沒有正面回答，反倒一再打量你。你試著繞過他走向門簾，他立刻側身擋住去路。<br><br>
        「價錢晚點再談。難得你肯試穿，何必急著走呢？」他笑著說，語氣裡已經沒有半點商量的餘地。<br><br>
    <<elseif _hmClothierEncounter and _hmClothierEncounter.id is "suspicious_clothier" and _hmClothierEncounter.trialReaction is "change_back">>
        你原本打算脫下這套過於大膽的衣服，換回自己的服裝，卻被突然闖入的小販打斷。你要求他出去，對方非但不肯離開，還搶先堵住門簾。<br><br>
        「才剛換上就要脫掉？別這麼掃興嘛。」他仍掛著笑容，卻一步也不肯退讓。<br><br>
    <<else>>
        小販堵住試衣間的門簾，不肯讓你離開。你只能在狹窄的隔間裡設法抵抗。<br><br>
    <</if>>
    推擠間，矮凳被碰得歪向一旁。你穩住腳步，準備尋找脫身的機會。<br><br>
<<else>>
    /* 每回合以 40% 機率補充試衣間氛圍與小販的輕佻、威脅台詞，避免反覆顯示同一句。 */
    <<if setup.HonestMarkets.rollChance(40)>>
        <<set _hmClothierCombatText to random(1, 9)>>
        <<if $enemyhealthmax gt 0 and $enemyhealth lte ($enemyhealthmax * 0.3)>>
            <<if _hmClothierCombatText lte 3>>
                小販扶著牆邊的衣鉤，喘著氣盯住你，原先那副從容的模樣已經消失。<br><br>
            <<else>>
                你注意到小販的腳步開始不穩。只要再找到一個空隙，或許就能衝向門簾。<br><br>
            <</if>>
        <<elseif $enemyanger gte 500>>
            <<if _hmClothierCombatText lte 3>>
                「別亂動！」小販的聲音越來越急躁，伸手時撞上牆邊的衣鉤，發出清脆的聲響。<br><br>
            <<else>>
                小販惱怒地扯住門簾，布料被拉得緊繃，連掛簾的橫桿都跟著震動。<br><br>
            <</if>>
        <<elseif _hmClothierCombatText is 1>>
            試衣間的門簾被風吹得微微晃動。外頭有人走過，卻沒注意到裡面的爭執。<br><br>
        <<elseif _hmClothierCombatText is 2>>
            你退到矮凳旁，腳跟不小心碰到凳腳，趕緊穩住身形。<br><br>
        <<elseif _hmClothierCombatText is 3>>
            「剛才在外面還真看不出來，你倒是挺惹眼的。」小販毫不掩飾自己的打量，仍舊守著出口。<br><br>
        <<elseif _hmClothierCombatText is 7>>
            「別一直躲著我的視線嘛，剛才照鏡子的時候不是還挺自在？」小販輕佻地笑著，卻絲毫沒有讓開門簾的意思。<br><br>
        <<elseif _hmClothierCombatText is 8>>
            「你這麼緊張做什麼？我不過是想多欣賞一會兒。」小販說著，又向出口挪了一步。<br><br>
        <<elseif _hmClothierCombatText is 9>>
            「別用那種眼神看我。我只是請你試穿，何必把氣氛弄得這麼僵？」小販說得若無其事，卻仍不肯讓路。<br><br>
        <<elseif _hmClothierCombatText is 4>>
            牆上的鏡子映出你們糾纏的身影；你試著從倒影判斷門簾的位置。<br><br>
        <<elseif _hmClothierCombatText is 5>>
            門簾外有顧客喊著詢問價錢，小販卻充耳不聞，注意力始終放在阻止你離開上。<br><br>
        <<else>>
            試衣間裡的空間實在太窄，你一邊防備小販，一邊小心避開身後的鏡子和矮凳。<br><br>
        <</if>>
    <</if>>
<</if>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
    <span id="next"><<link [[繼續|HonestMarkets Clothier Combat Finish]]>><</link>></span><<nexttext>>
<<else>>
    <span id="next"><<link [[繼續|HonestMarkets Clothier Combat]]>><</link>></span><<nexttext>>
<</if>>

:: HonestMarkets Clothier Combat Finish[]
<<effects>>
<<if $enemyarousal gte $enemyarousalmax and $enemyhealth gt 0>>
    <<ejaculation "short">>
<</if>>
<<if $enemyhealth lte 0>>
    小販踉蹌著撞上牆邊，終於再也攔不住你。你趁機推開門簾，外頭明亮的攤位與嘈雜的人聲一下子湧了進來。<br><br>
<<elseif $enemyarousal gte $enemyarousalmax>>
    一陣混亂過後，你終於得以喘口氣。小販卻仍擋在出口，伸手指向你剛才試穿的衣服，堅持要把它拿回去。<br><br>
<<else>>
    你趁小販分神，猛地擠過對方身側。門簾被你扯開，終於露出通往市場的出口。<br><br>
<</if>>
<<clotheson>>
<<run setup.HonestMarkets.resolveMarketEncounter("combat_finish")>>
<<endcombat>>
<<honestMarketsEncounterResult>>
<<run setup.HonestMarkets.clearMarketEncounter()>>
<<link "繼續逛市集" setup.HonestMarkets.marketEncounterReturnPassage()>><<endevent>><</link>>

:: HonestMarkets Model Widgets[widget]

<<widget "hmModelReactionText">>
    <<set _n to _hmModel.modelLastNarrative>>
    <<if _n>>
        <<set _scenes to [ ["人潮從攤位前流過，只有零星路人往你身上瞥了一眼。", "幾個路人短暫停下腳步，但很快又被其他攤位吸引。", "兩名路人朝你看了看，交換幾句意見後繼續前進。", "攤位前仍有些冷清，偶爾才有人回頭留意展示服裝。", "有顧客稍稍放慢腳步，卻沒有真正走近攤位。"], ["有幾名路人放慢腳步，仔細端詳你身上的款式。", "你吸引了一小群人的注意，店主趁機介紹服裝的特色。", "幾名顧客輪流打量服裝的剪裁，其中一人向店主詢問價格。", "路過的人不時回頭，攤位前逐漸多了幾張好奇的面孔。", "一對逛街的朋友停下討論你的裝扮，店主立刻迎上前招呼。"], ["越來越多人注意到你的展示，幾名顧客圍到攤位前詢問款式。", "你的一次轉身吸引了不少目光，原本匆匆經過的路人也停下來觀看。", "附近幾名顧客循著同伴的招呼靠近，興致勃勃地打量服裝。", "攤位前陸續有人駐足，店主忙著回答關於尺寸與配色的問題。", "幾位路人停下來欣賞展示，其中有人開始挑選貨架上的同款服裝。"], ["攤位前聚起一群好奇的路人，店主忙著招呼接連上前詢問的顧客。", "你的展示引來一陣注目，附近的行人紛紛回頭，甚至有人招呼同伴一起過來看。", "圍觀的人漸漸擠到攤位前，店主一邊介紹商品，一邊忍不住朝你露出笑容。", "有人停下腳步稱讚服裝，更多路人受到吸引，連鄰近攤位的客人也望了過來。", "你的展示成了這一帶的焦點，顧客接連詢問店主是否還有其他顏色與尺寸。"] ]>>
        <<set _exhibition to [ ["被人盯著看讓你臉頰發燙，你不自覺縮起肩膀，擺姿勢時仍有些靦腆。", "你察覺到視線便低下頭，過了一會兒才鼓起勇氣重新面向人群。", "一名顧客望過來時，你慌忙移開目光，雙手不知該往哪裡放。", "你試著挺直背脊，卻仍忍不住紅著臉偷偷觀察路人的反應。", "聽見有人討論你身上的衣服，你緊張地抿起嘴，過了一會兒才重新擺好姿勢。"], ["你還是有點不好意思，但逐漸能迎著目光展示衣服。", "你深吸一口氣，努力讓自己的姿態看起來自然些。", "被人注視時你稍微有些緊張，仍試著向感興趣的顧客點頭。", "你偶爾會害羞地別開視線，但很快又鼓起勇氣面向人群。", "你整理好情緒，雖然臉頰仍有些熱，卻已能配合店主的介紹展示服裝。"], ["你坦然迎向路人的目光，從容地調整展示角度。", "你自在地擺出姿勢，甚至會主動向駐足的顧客微笑。", "你不慌不忙地轉向另一側，讓周圍的人看清服裝細節。", "面對接連投來的視線，你仍神情自然，還會適時與顧客交換目光。", "你大方地展示身上的衣服，對路人的稱讚報以自信的微笑。"] ]>>
        <<set _dancing to [ ["你轉身時腳步略顯僵硬，得停頓一下才能重新站穩。", "你想走得漂亮些，動作卻不太協調，只好放慢腳步。", "你照著店主的提示換個站姿，卻不小心把手腳擺得有些彆扭。", "你試著轉個圈展示衣服，結果步伐亂了一拍，只好趕緊站定。", "你在攤位前來回走了兩步，動作仍像是在努力記住每個姿勢。"], ["你試著配合衣服的剪裁調整步伐，動作漸漸順暢。", "你穩穩地走了幾步，再轉身展示服裝的另一面。", "你跟著店主的示意換了個角度，動作雖不花俏卻相當穩當。", "你放慢速度展示袖口與衣襬，轉身時也能保持平衡。", "你稍微調整站姿與步伐，讓服裝的線條自然地呈現在顧客眼前。"], ["你輕巧地轉了半圈，流暢的動作讓服裝線條顯得格外鮮明。", "你熟練地變換站姿與步伐，讓顧客看清服裝不同角度的效果。", "你踩著輕快的節奏走到攤位另一側，回身時衣襬恰好自然展開。", "你流暢地完成幾個展示動作，連店主都忍不住多看了一眼。", "你掌握好每次停頓與轉身的時機，讓整套服裝的特色一一展現。"] ]>>
        <<if _hmModel.modelMinutes gte 30>>到了最後一段展示時間，<<elseif _hmModel.modelMinutes gte 20>>又過了十分鐘，<<else>>剛開始展示時，<</if>><<print _scenes[_n.crowd][_n.crowdIndex]>> <<print _exhibition[_n.exhibition][_n.exhibitionIndex]>> <<print _dancing[_n.dancing][_n.dancingIndex]>>
        <<if _n.tipped>>一名欣賞你展示的路人留下了小費。<<else>>這一輪沒有人留下小費。<</if>>
    <</if>>
<</widget>>

<<widget "hmModelPhotoText">>
    <<if _hmModel.modelPhotoAction is "refuse">>
        你婉拒拍照邀請。對方表示理解，收起相機走回人群。<br>
    <<else>>
        <<switch _hmModel.modelPhotoVariant>>
            <<case 0>>攝影者先請你轉向攤位外側，讓光線落在服裝的剪裁上，接著舉起相機連拍幾張。
            <<case 1>>你配合攝影者的示意稍微側身，讓衣服的輪廓更清楚。快門聲接連響起。
            <<case 2>>攝影者退後幾步取景，又請你站到貨架旁，試著拍出整套服裝的效果。
            <<case 3>>對方調整相機角度，請你展示袖口與衣襬，拍攝逐漸進入狀況。
        <</switch>>
        <<if _hmModel.modelPhotoAction is "tip">>
            你事先談妥拍攝費用，對方已付給你 <span class="gold">£<<print _hmModel.modelPhotoOffer>></span>。
        <<else>>
            你答應免費讓對方拍照。
        <</if>>
        <<if _hmModel.modelIncidentAction is "">>
            拍攝順利結束。對方道謝後收起相機，離開攤位。
        <<else>>
            <<switch _hmModel.modelIncidentAction>>
                <<case "push">>對方拍攝時越過了你能接受的距離。你立即推開對方，要求停止拍攝。對方一臉尷尬，收起相機匆匆離開。
                <<case "warn">>你嚴正警告對方別再擅自碰觸。對方連聲道歉，保持距離拍完最後一張照片，便收起相機離開。
                <<case "close">>你沒有退開，反而主動調整站姿，讓對方拍完最後幾張照片。對方收起相機道謝，這才離開。
                <<case "extra">>
                    <<switch _hmModel.modelExtraVariant>>
                        <<case 0>>你提出追加報酬。攝影者露出意味深長的笑容，取出一疊鈔票，刻意將它塞進你胸前衣物的邊緣，放好後才慢吞吞地收回手。
                        <<case 1>>聽見你要求更多小費，對方掏出一把鈔票，藉口替你整理衣著，將錢塞進腰際的衣物邊緣。那過分從容的動作，讓你看出對方別有用心。
                        <<case 2>>對方答應加價，卻故意不把鈔票交到你手上，而是伸向胸前的衣襟。你看著對方裝作若無其事地整理好鈔票，才終於退後一步。
                        <<case 3>>攝影者數出額外的小費，俯身把鈔票塞在你腰際的衣物邊緣，還故作認真地確認沒有掉落。你知道這番殷勤並不單純。
                    <</switch>>
                    你額外得到 <span class="gold">£<<print _hmModel.modelPhotoExtra>></span>。對方拍完最後幾張照片，收起相機離開。
            <</switch>>
        <</if>><br>
    <</if>>
<</widget>>

<<widget "hmModelClosingText">>
    <<if _hmModel.modelMinutes is 0>>
        你還沒正式開始展示，就告訴店主自己改變了主意。店主愣了一下，臉上的期待明顯褪去，目光又不自覺地望向尚未有人接手的攤位。「這樣啊……好吧，沒關係。」對方勉強擠出笑容，雖然顯然很失望，卻也不好意思強留你。替補模特兒仍未抵達，店主只好繼續想辦法。
    <<else>>
        <<if _hmModel.modelMinutes gte 30>>
            正當你準備收工時，趕來的替補模特兒終於出現在攤位旁，連聲為遲到道歉。店主示意對方接手，這才轉向你。
        <<else>>
            你告訴店主自己得先離開。替補模特兒還沒趕到，店主雖然有些遺憾，仍然沒有挽留。
        <</if>>
        <<set _thanks to [ ["店主鬆了口氣，笑著說：『雖然今天有點手忙腳亂，但你肯幫忙就已經救了我一命，真的謝謝！』", "店主向你點點頭：『辛苦了！臨時要你上場確實不容易，幸好有你幫我撐過這段時間。』"], ["店主滿意地笑了：『你幫我留住了不少客人，臨時找你來真是找對人了！』", "店主一邊整理攤位一邊道謝：『剛才有好幾個人停下來看衣服，多虧你幫忙！』"], ["店主高興地說：『剛才攤位前可熱鬧了！你展示得很棒，幫了我大忙！』", "店主笑得合不攏嘴：『你一上場就吸引了那麼多目光，今天真的多虧你了！』"], ["店主興奮地握了握拳：『太精彩了！大家都被你吸引過來，我差點忙不過來！下次有機會還想請你幫忙！』", "店主忍不住讚嘆：『你簡直像專業模特兒！剛才那麼多人圍觀，真是幫了我大忙！』"] ]>>
        <<print _thanks[_hmModel.modelClosingTier][_hmModel.modelClosingIndex]>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterModel">>
    <<set _hmModel to setup.HonestMarkets.getMarketEncounter()>>
    <<honestMarketsEncounterDebug>>
    <<if _hmModel and _hmModel.id is "temporary_model">>
        <<if _hmModel.stage is "initial">>
            一名服裝攤販正焦急地四處張望，不時看向時間。你經過攤位時，恰好與店主對上了眼。對方先是一愣，隨即眼前一亮，快步向你走來。<br><br>
            「原本約好的模特兒今天竟然翹班了！雖然已經找了替補，但對方還要晚一些才能到，我現在就需要有人幫忙展示服裝。」<br><br>
            對方拿出一套<span class="blue"><<print _hmModel.modelLabel>></span>，向你解釋：「每展示十分鐘，我至少付你 <span class="gold">£50</span>。如果你表現得好、能幫我吸引顧客，我還會加薪。至於路人給的小費，全部都歸你！」<br><br>
            每輪展示十分鐘，最多工作半小時。<br><br>
            <<link "接受工作，前往試衣間" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("accept")>>
            <</link>><br>
            <<link "婉拒邀請" "HonestMarkets Encounter Result">>
                <<run setup.HonestMarkets.resolveMarketEncounter("decline")>>
            <</link>>
        <<elseif _hmModel.stage is "showing">>
            <<if _hmModel.modelMinutes is 0>>
                你換上了<span class="blue"><<print _hmModel.modelLabel>></span>，走到攤位前。攤販替你整理好衣角，示意你開始展示。<br><br>
            <<else>>
                你繼續穿著<span class="blue"><<print _hmModel.modelLabel>></span>，在攤位前展示服裝。<br><br>
            <</if>>
            <<if _hmModel.modelPhotoAction>>
                <<hmModelPhotoText>><br><br>
            <</if>>
            <<if _hmModel.modelLastNarrative>>
                <<hmModelReactionText>><br>
                這十分鐘店主支付 <span class="gold">£<<print _hmModel.modelLastBase || 0>></span>，路人打賞 <span class="gold">£<<print _hmModel.modelLastTip || 0>></span>，合計 <span class="gold">£<<print _hmModel.modelLastEarned>></span>。<br><br>
            <</if>>
            已展示：<<print _hmModel.modelMinutes>> 分鐘。累計店主報酬：<span class="gold">£<<print _hmModel.modelReward - (_hmModel.modelTips || 0)>></span>；累計打賞：<span class="gold">£<<print _hmModel.modelTips || 0>></span>；總收入：<span class="gold">£<<print _hmModel.modelReward>></span>。<br><br>
            <<if _hmModel.modelMinutes lt 30>>
                <<if _hmModel.modelMinutes is 0>>
                    <<link "開始展示十分鐘" "HonestMarkets Encounter Continue">>
                        <<run setup.HonestMarkets.resolveMarketEncounter("continue")>>
                    <</link>><br>
                <<else>>
                    <<link "繼續展示十分鐘" "HonestMarkets Encounter Continue">>
                        <<run setup.HonestMarkets.resolveMarketEncounter("continue")>>
                    <</link>><br>
                <</if>>
            <</if>>
            <<if _hmModel.modelMinutes is 0>>
                <<link "反悔，換回原本服裝" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("finish")>>
                <</link>>
            <<else>>
                <<link "結束工作，換回原本服裝" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("finish")>>
                <</link>>
            <</if>>
        <<elseif _hmModel.stage is "photo">>
            <<if _hmModel.modelLastNarrative>>
                <<hmModelReactionText>><br>
                這十分鐘店主支付 <span class="gold">£<<print _hmModel.modelLastBase || 0>></span>，路人打賞 <span class="gold">£<<print _hmModel.modelLastTip || 0>></span>。<br><br>
            <</if>>
            <<switch _hmModel.modelPhotoInviteVariant>>
                <<case 0>>一名路人拿著相機走近，稱讚你剛才的展示十分吸睛，詢問能不能替你拍幾張服裝照片。對方指了指攤位前光線較好的位置，等著你的回答。
                <<case 1>>你才剛結束一輪展示，一名背著相機的路人便停在攤位旁，說想記錄這套衣服的剪裁。對方先徵詢你的意見，並表示只會在攤位附近拍攝。
                <<case 2>>一名原本正在挑衣服的顧客看了你幾眼，忽然拿出相機，問能不能拍幾張照片留作穿搭參考。店主望向你，顯然打算讓你自己決定。
                <<case 3>>一名路人從人群中探出頭，舉著相機詢問是否方便拍攝。對方說剛才看見你轉身展示衣襬的動作，想趁你還穿著這套衣服時拍下來。
                <<case 4>>攤位前有人停下腳步，先詢問這套服裝的款式，接著拿起相機問你願不願意配合拍照。對方一邊確認拍攝位置，一邊等你答覆。
                <<case 5>>你正準備稍作休息，一名路人帶著相機走上前，表示想拍幾張展示照片。對方特地先問過你，沒有擅自按下快門。
            <</switch>><br><br>你打算怎麼回答？<br><br>
            <<link "答應免費拍照" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("photo_free")>>
            <</link>><br>
            <<link `"要求打賞 £" + _hmModel.modelPhotoOffer + " 才答應"` "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("photo_tip")>>
            <</link>><br>
            <<link "婉拒拍照" "HonestMarkets Encounter Continue">>
                <<run setup.HonestMarkets.resolveMarketEncounter("photo_refuse")>>
            <</link>>
        <<elseif _hmModel.stage is "photo_incident">>
            <<switch _hmModel.modelPhotoVariant>>
                <<case 0>>拍攝途中，攝影者以調整肩線為由突然走近，手指停留的時間明顯超過了整理衣服所需。
                <<case 1>>對方示意你換個姿勢，卻不等你答應便伸手碰觸你的腰際，還故意貼得很近。
                <<case 2>>攝影者放下相機，說衣服有些歪斜，隨即擅自替你拉扯衣襟。你察覺那並不只是為了拍照。
                <<case 3>>快門聲停下後，對方藉著示範站姿走到你身旁，手掌不請自來地搭上你的身側。
            <</switch>>
            <<switch _hmModel.modelIncidentVariant>>
                <<case 0>>你往旁邊一瞥，發現對方還在觀察你的反應。
                <<case 1>>對方若無其事地說著拍攝角度，卻沒有立刻退回原本的位置。
                <<case 2>>相機仍掛在對方胸前，對方卻像忘記了原本要拍什麼。
                <<case 3>>附近的人潮依舊來來往往，攝影者似乎認定你不會當眾抗議。
            <</switch>>
            <<if _hmModel.modelPhotoIncidentWilling>>你察覺這已超出普通拍攝的界線，卻也感到一絲刺激。<<else>>突如其來的碰觸讓你不舒服，心裡一陣緊張。<</if>><br><br>
            <<if $promiscuity gte 60>>
                <<link "主動拉近距離" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("incident_close")>>
                <</link>> <<lstress>> <<garousal>><br>
                <<link "要求額外打賞" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("incident_extra")>>
                <</link>> <<lstress>> <<ggarousal>>
            <<else>>
                <<link "推開對方" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("incident_push")>>
                <</link>> <<gstress>><br>
                <<link "口頭警告" "HonestMarkets Encounter Continue">>
                    <<run setup.HonestMarkets.resolveMarketEncounter("incident_warn")>>
                <</link>> <<gstress>>
            <</if>>
        <</if>>
    <</if>>
<</widget>>

<<widget "HonestMarketsEncounterModelResult">>
    <<set _hmModel to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmModel and _hmModel.id is "temporary_model">>
        <<if _hmModel.result is "declined">>
            你謝絕了邀請，繼續逛服裝市場。<br><br>
        <<elseif _hmModel.result is "wardrobe_failed">>
            試穿時出了點問題。攤販只好取消這次展示，你檢查了自己的衣服，確認已恢復原狀。<br><br>
        <<elseif _hmModel.result is "finished" or _hmModel.result is "clothes_lost">>
            <<if _hmModel.result is "clothes_lost">>
                你準備換回自己的衣服，卻發現原本寄放的衣物怎麼也找不到。老闆翻遍了試衣間和攤位後方，最後滿臉歉意地向你道歉：「真對不起，你的衣服好像弄丟了。你現在身上這套就送給你，當作補償吧。」<br><br>
                你只好穿著目前的服裝離開。<br><br>
                <span class="red">【模組異常提示】HonestMarkets 恢復原本服裝時發生錯誤，已跳過還原並結束事件，以避免卡死。這不是正常的劇情事件；原本服裝可能無法取回，請保留存檔並回報錯誤。</span><br><br>
            <<else>>
                你換回自己的衣服。<br><br>
            <</if>>
            <<hmModelClosingText>><br><br>
            <<if _hmModel.modelMinutes gt 0>>
                攤販依照約定結清報酬：店主支付 <span class="gold">£<<print _hmModel.modelReward - (_hmModel.modelTips || 0)>></span>，路人打賞 <span class="gold">£<<print _hmModel.modelTips || 0>></span>，合計 <span class="gold">£<<print _hmModel.modelReward>></span>。<br><br>
            <</if>>
        <</if>>
    <</if>>
<</widget>>


<<widget "HonestMarketsEncounterHiddenCouple">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter and _hmEncounter.id is "hidden_couple">>
        <<if _hmEncounter.stage is "initial">>
            <<switch random(0, 6)>>
                <<case 0>>你經過堆貨區時，聽見兩道聲音交錯著說了幾個字。話還沒說完，便被一陣急促的換氣打斷；那聲音很快又被市場的叫賣聲淹沒。
                <<case 1>>貨箱後傳來一聲短促的驚呼，緊接著有人低低地說：「噓，外面有人。」另一個人沒有立刻回答，只有不太平穩的呼吸聲。
                <<case 2>>你原以為是有人在搬貨，直到聽見一聲帶著笑意的埋怨，以及另一人忙不迭壓低聲音的安撫。那動靜顯然不太像正常的工作。
                <<default>><<switch _hmEncounter.sceneVariant>>
                <<case 0>>你經過市場角落時，聽見貨箱後傳來一陣刻意壓低的喘息，隨後有人急急地「噓」了一聲。幾個箱子接連輕晃，動靜沒有停下來的意思。
                <<case 1>>你正準備離開這排攤位，忽然聽見貨箱後傳來衣料摩擦與木板輕碰的聲音。「小聲一點……外面有人。」有人低聲提醒，話音未落，又傳來一聲被壓住的笑。
                <<case 2>>貨箱後傳來細微的衣料摩擦聲。你原以為有人正在搬貨，卻聽見兩道貼得很近的低語，接著又是一陣急忙壓低的喘息。
                <<case 3>>市場的叫賣聲中，貨箱後方傳來一聲悶響。「小聲一點……」有人急促地提醒同伴，隨後又傳來幾聲壓低的喘息。
            <</switch>>
            <</switch>><br><br>
            <<link "不關自己的事" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("ignore")>><</link>><br>
            <<link "靠過去看看" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("approach")>><</link>>
        <<elseif _hmEncounter.stage is "discovered">>
            <<switch random(0, 6)>>
                <<case 0>>從貨箱間望去，你只看見兩道緊密交疊的身影。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手停在<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的腰側；後者攀住前者的肩，臉頰泛紅，呼吸急促。<br><br>
                <<case 1>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>正貼近<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的耳邊低語，手掌沿著肩背慢慢移動；<<print $NPCList[1].pronouns.he>>握住同伴的手，卻沒有推開。兩人似乎都沒有留意貨堆外的腳步聲。<br><br>
                <<case 2>>你從縫隙裡看見<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>抬起泛紅的臉，似乎想說什麼，話音卻停在唇邊。<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>伸手扶住同伴的腰，兩道影子再次交疊。<br><br>
                <<default>><<switch _hmEncounter.sceneVariant>>
                <<case 0>>你沿著貨箱邊緣靠近，從縫隙裡看見兩個衣衫不整的人正擁在一起。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>緊攥著同伴的肩頭，<<print $NPCList[1].pronouns.he>>伸手抵住搖晃的木箱；兩人一邊低聲喘著氣，一邊試著在狹小的空間裡穩住腳步。衣袖輕輕擦過箱角，他們卻仍緊緊相依，沒有要停下的意思。<br><br>
                <<case 1>>你繞到貨箱側面，發現兩個人正擠在狹窄的陰影裡，衣領與頭髮都亂了。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>環住同伴的腰，<<print $NPCList[1].pronouns.he>>則抓緊對方的衣袖；兩人貼得很近，偶爾急急換一口氣，又立刻壓低聲音提醒彼此小心。鞋底在地上挪動，帶起一聲輕響，旁邊的紙箱傳來細微的摩擦聲。<br><br>
                <<case 2>>你探頭望去，才發現箱子後面根本沒有搬運工。兩個衣著凌亂的人正緊緊相擁。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>扶著貨箱邊緣，<<print $NPCList[1].pronouns.he>>攥住同伴的衣襟；低語與短促的換氣聲交錯，衣料隨著他們挪動而沙沙作響。有人輕碰箱角，隨即收回手臂，卻仍不肯分開。<br><br>
                <<case 3>>你小心靠近聲音的來源，發現兩個人躲在貨箱後方。一只空箱擱在他們腳邊。兩人衣衫凌亂地依偎著，<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>彎腰想撿箱子，卻被同伴拉住袖口，只得重新站直。兩人輕喘著交換幾句悄悄話，肩膀又碰上後面的貨架，發出一聲「喀噠」。誰也沒有心思再管地上的箱子。<br><br>
            <</switch>>
            <</switch>>
            <<if $NPCList and $NPCList[0] and $NPCList[1]>>
                <<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>仍沉浸在這場偷偷摸摸的親熱裡，尚未察覺你的存在。<br>
                <<if $NPCList[0].pronoun is "m" and $NPCList[1].pronoun is "m">>
                    <<switch _hmEncounter.coupleDynamic>>
                        <<case 0>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>靠得極近，<<print $NPCList[0].pronouns.he>>背抵木箱，<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>低頭吻住他。衣領早已歪斜。<<print $NPCList[0].pronouns.he>>抓緊同伴的上臂，聽見背後一聲悶響，便低聲喘著提醒他扶穩箱子；<<print $NPCList[1].pronouns.he>>伸手抵住木板，兩人相視一笑，又靠近彼此。
                        <<case 1>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>似乎比同伴更容易害羞，幾次低聲提醒「有人會聽見」，卻始終沒真正推開對方。<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>貼近耳邊說了句悄悄話，他紅著臉笑罵一句，卻仍抓著對方的衣襟不肯鬆手。兩人調整腳步時，鞋尖輕碰空箱，發出一聲「咚」；他們慌忙屏息，片刻後又低聲笑起來。
                        <<case 2>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>一面親吻，一面小聲爭論是誰挑了這個狹窄的角落。「都怪你選這裡……」抱怨才說到一半，<<print $NPCList[1].pronouns.he>>又湊近堵住他的話。<<print $NPCList[0].pronouns.he>>伸手環住對方肩膀，<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>忙著扶穩身後的箱子，笑聲、短促的換氣聲與木板輕響混在一起。
                    <</switch>>
                    <<if setup.HonestMarkets.rollChance(35)>><<switch random(0, 1)>><<case 0>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>靠得極近。<<print $NPCList[0].pronouns.he>>將手掌貼在同伴背上，後者抓住前者的衣袖，低聲說了句什麼，耳根隨即紅了。<<case 1>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>略微俯身，<<print $NPCList[1].pronouns.he>>伸手攬住他的肩。你只聽見一聲短促的吸氣，以及一句被壓得幾乎聽不清的回答。<</switch>><</if>><br><br>
                <<elseif $NPCList[0].pronoun is "f" and $NPCList[1].pronoun is "f">>
                    <<switch _hmEncounter.coupleDynamic>>
                        <<case 0>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>緊緊相擁，散亂的髮絲纏在一起。<<print $NPCList[0].pronouns.he>>輕聲喚著同伴，話還沒說完便被一個吻打斷；<<print $NPCList[0].pronouns.he>>扶著同伴的腰，<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>將手搭在她肩上，兩人踮腳換了個位置，衣袖擦過旁邊的布料，發出細碎的沙沙聲。她們忍著笑意，仍不肯拉開距離。
                        <<case 1>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>似乎怕被人聽見，輕輕提醒同伴別出聲；對方握住她的手，笑著貼近。她原本還想板起臉警告，卻被同伴拉近，話說到一半便輕輕吸了口氣。她伸手扶住身旁的貨架，兩人對望片刻，又忍不住笑了。
                        <<case 2>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的衣襟都有些凌亂，卻還在小聲打趣究竟是誰先提議躲進來的。「明明是你先……」<<print $NPCList[0].pronouns.he>>說到一半，便被同伴笑著拉近。兩人相互摟住，腳步一挪便擦過身旁的布料，沙沙作響。「小聲一點，外面有人。」<<print $NPCList[0].pronouns.he>>輕喘著提醒，<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>趕緊伸手扶穩，卻仍沒有鬆開她。
                    <</switch>>
                    <<if setup.HonestMarkets.rollChance(35)>><<switch random(0, 1)>><<case 0>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的身影重疊在貨箱陰影裡。<<print $NPCList[0].pronouns.he>>輕撫同伴的頸側，後者握住前者的手腕，臉頰泛紅，卻仍靠在她身旁。<<case 1>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>扶住同伴的腰，<<print $NPCList[1].pronouns.he>>把手搭上她的肩，湊近說了句悄悄話。回答是一聲壓低的笑，隨後又安靜下來。<</switch>><</if>><br><br>
                <<else>>
                    <<switch _hmEncounter.coupleDynamic>>
                        <<case 0>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>與<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>緊緊相擁，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>背後的木箱不時輕響。<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>輕聲提醒他注意動靜，他點了點頭，改用手掌抵住木箱；<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>抓緊他的衣袖，兩人調整站姿時，木板又輕輕碰上牆面。「咚。」她忍不住低聲笑罵一句，卻依然依偎著他。
                        <<case 1>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span>似乎擔心有人經過，親吻間不時停下來聽外面的腳步聲。<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>低聲說「不會有人注意的」，卻被她笑著提醒，剛才把木箱碰響的明明就是他。<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>扶著<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>的肩膀，兩人往貨箱內側挪了半步，衣料輕輕摩擦。<<print ($NPCList[0].pronoun === "m" ? $NPCList[0].pronouns.he : $NPCList[1].pronouns.he)>>短促地換了口氣，伸手避開旁邊的箱角；她則笑著提醒他，這次可別再碰響了。
                        <<case 2>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>的衣領歪到一旁，<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>笑著伸手替他拉正；他卻握住她的手，在她還沒整理完時便又吻了過去。「等一下，箱子……」她才提醒半句，<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>伸手扶著身旁的箱子，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>也連忙扶穩另一側。「呼……差點。」兩人壓低聲音笑了幾下，仍緊緊靠在一起。
                    <</switch>>
                    <<if setup.HonestMarkets.rollChance(35)>><<switch random(0, 1)>><<case 0>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>與<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>藏在貨箱後方。<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>伸手攀住<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>的肩，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>扶著她的背；兩人靠得極近，短促的呼吸聲交錯在一起。<<case 1>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>正低頭與<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>說話，手掌停在她的腰側。<<print ($NPCList[0].pronoun === "m" ? $NPCList[1].pronouns.he : $NPCList[0].pronouns.he)>>抓住他的衣袖，泛紅的臉稍稍偏開，卻沒有退離。<</switch>><</if>><br><br>
                <</if>>
            <<else>>
                那兩人衣著凌亂，正緊緊擁吻，偶爾傳來壓低的笑聲與喘息，完全沒有發現你。<br><br>
            <</if>>
            <<if setup.HonestMarkets.rollChance(35)>><<switch random(0, 1)>><<case 0>>你無法從這個角度看清全部細節，只能看見兩人相互牽引的手臂與交疊的輪廓。偶爾傳來的短促呼吸，讓貨箱後的秘密更加明顯。<br><br><<case 1>>兩人始終沒有留意你。你聽見一聲壓抑的驚呼，接著有人輕聲提醒同伴小聲些；市場外側依然人來人往。<br><br><</switch>><</if>>
            <<if $promiscuity gte 60>>
                兩人仍沒有發現你，親暱的動靜也沒有停止。你可以悄悄離開，也可以再觀察一會兒；若想惡作劇，只要出個聲就能打斷他們。<br><br>
                <<link "躲起來偷看" "HonestMarkets Encounter Continue">><<run setup.HonestMarkets.resolveMarketEncounter("watch")>><</link>> <<ggarousal>><br>
                <<link "突然出聲嚇他們一跳" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("startle")>><</link>> <<llstress>><br>
                <<link "不打擾他們，悄悄離開" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("leave")>><</link>>
            <<else>>
                你一下子明白自己撞見了什麼：這兩人根本沒有要停下來的意思。你的臉頰頓時發燙，只想趁他們還沒發現時趕快離開。<br><br>
                <<link "趕緊離開現場" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("leave")>><</link>> <<garousal>> <<gawareness>>
            <</if>>
        <<elseif _hmEncounter.stage is "watching">>
            <<switch random(0, 19)>>
                <<case 0>>你從貨箱縫隙看見兩道緊密交疊的身影。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>攀著同伴的肩，<<print $NPCList[1].pronouns.he>>則穩穩扶著前者的腰；急促的呼吸與壓低的喘息接連傳來，幾乎聽不清他們說了什麼。<br><br>
                <<case 1>>「噓……」有人試圖提醒同伴，話卻被短促的吸氣聲打斷。兩人仍緊貼在一起，交錯的手臂映在帆布上，你只能看見輪廓，卻很清楚這不是普通的擁抱。<br><br>
                <<case 2>>市場外側傳來叫賣聲，貨箱後卻是另一番動靜。兩人始終沒有分開，壓抑的喘息偶爾蓋過低語；<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>抓緊同伴肩頭，<<print $NPCList[1].pronouns.he>>低聲提醒別讓人聽見。<br><br>
                <<case 3>>一輛推車經過，你立刻縮回陰影。貨箱另一側的呼吸聲短暫放輕，車輪遠去後，斷續的低語與細微衣料聲又接連響起；兩道身影仍交疊在原處。<br><br>
                <<case 4>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>手肘不慎輕碰木箱，發出短促的「咚」。兩人同時一頓，屏息聽了幾秒，確認無人靠近後才放鬆；隨後又傳來幾聲壓低的喘息。貨物依然穩穩放著。<br><br>
                <<case 5>>你調整視線，看見<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>將手臂環在同伴背後，<<print $NPCList[1].pronouns.he>>緊握同伴的肩。兩道身影幾乎完全重合，只剩斷斷續續的呼吸聲穿過貨箱間的空隙。<br><br>
                <<case 6>>帆布後的影子緊密重疊，偶爾隨著細微動作輕輕變化。有人發出一聲來不及壓低的驚呼，隨即小聲提醒同伴；你聽見<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>急促地應了一聲。<br><br>
                <<case 7>>你原以為有人在低聲交談，仔細聽才發現話語總被急促的換氣聲截斷。兩人始終貼在一起，手掌停在彼此的腰背與肩頭，絲毫沒察覺你的目光。<br><br>
                <<case 8>>市場通道忽然傳來腳步聲。你往後縮了一點，兩人也短暫收住聲音；腳步遠去後，貨箱後又響起短促的喘息，交疊的影子依舊沒有分開。<br><br>
                <<case 9>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>似乎想說些什麼，卻只吐出幾個斷續的字。<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>低聲回應，伸手扶住前者的背；你透過縫隙看見兩人靠得極近，衣袖偶爾擦過旁邊的帆布。<br><br>
                <<case 10>>你看見<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>抓著同伴的上臂，<<print $NPCList[1].pronouns.he>>穩住對方肩頭。兩道輪廓幾乎合在一起，急促的呼吸聲在狹小的空間裡格外清晰，外頭的市場卻照樣熱鬧。<br><br>
                <<case 11>>「小聲……」提醒才說到一半，便被一聲短促的喘息打斷。兩人沒有離開藏身處，只有交錯的影子與細碎的衣料聲，讓你知道貨箱後的私密活動仍在繼續。<br><br>                <<case 12>>你從木箱邊緣悄悄望去。<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手掌順著<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的肩背緩緩移動；後者抓緊前者的手臂，微微仰起泛紅的臉。<br><br>
                <<case 13>>貨箱遮住了大半畫面，你只能看見兩人的上半身緊密交疊。有人低聲說了句「等等」，<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>立刻停住，耐心等到對方重新靠近。<br><br>
                <<case 14>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>用指尖輕輕碰過<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的臉頰，手掌隨後停在頸側。對方握住那隻手，急促地吸了一口氣，低聲回應。<br><br>
                <<case 15>>兩人似乎正互相爭著說些什麼，最後只剩斷斷續續的低語。你注意到<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>始終扶著對方的腰，<<print $NPCList[1].pronouns.he>>的手則緊抓著對方肩頭。<br><br>
                <<case 16>>你看到<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>伸手將同伴帶近，<<print $NPCList[1].pronouns.he>>順勢環住前者的背。衣料發出細微的摩擦聲，兩道影子在貨箱上合成一團。<br><br>
                <<case 17>><span class="blue"><<print $NPCList[0].fullDescription_CN>></span>似乎有些害羞，將臉偏向一旁。<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>沒有追問，只是輕輕握住同伴的手；片刻後，先前害羞的那位自己重新靠了過去。<br><br>
                <<case 18>>一陣腳步聲經過通道，你縮回陰影裡。再望出去時，兩人仍維持原本的距離，<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手停在<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>的背上，兩人始終專注於彼此。<br><br>
                <<case 19>>你只能看見<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>的手從對方肩頭滑向腰側，以及<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>突然抓緊同伴衣袖的反應。低低的喘息聲從貨箱後傳來，很快消失在市場的嘈雜裡。<br><br>
<</switch>>
            <<link "繼續看下去" "HonestMarkets Encounter Result">><<run setup.HonestMarkets.resolveMarketEncounter("watch_continue")>><</link>><br>
            <<if $exhibitionism gte 35>>
                <<link "躲起來邊看邊自慰" "HonestMarkets Hidden Couple Masturbation">><<run setup.HonestMarkets.resolveMarketEncounter("masturbate")>><</link>>
            <</if>>
        <</if>>
    <</if>>
<</widget>>


<<widget "HonestMarketsEncounterHiddenCoupleResult">>
    <<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
    <<if _hmEncounter and _hmEncounter.id is "hidden_couple">>
        <<switch _hmEncounter.result>>
            <<case "ignored">>
                <<switch _hmEncounter.sceneVariant>>
                    <<case 0>><<if random(0,1) is 0>>你決定不去追究貨箱後的秘密。走出幾步後，那些壓低的聲音便逐漸被市場的人聲蓋過。<<else>>你看了眼安穩堆放的貨箱，決定不去打探別人的秘密。你轉身走回熱鬧的攤位間，身後的細碎聲響很快被叫賣聲蓋過。
                    <</if>>
                    <<case 1>>你假裝沒聽見那聲「小聲一點」，繼續沿著攤位走去。至於貨箱後面究竟在忙什麼，還是留給當事人自己知道吧。
                    <<case 2>>你最後看了一眼那排貨箱，決定不去確認聲音的來源。市場裡還有不少商品等著你看。
                    <<case 3>>既然裡面的人還有心情拌嘴，你也就不打算過問。你轉身離開，把那陣細碎的聲響留在身後。
                <</switch>>
            <<case "embarrassed">>
                <<switch _hmEncounter.watchVariant>>
                    <<case 0>><<if random(0,1) is 0>>你匆忙收回視線，臉頰有些發燙。貨箱後仍傳來含糊的低語，但你已經快步回到市場通道。<<else>>你猛地收回視線，沿原路退回人群。直到走出好一段距離，臉上的熱度才稍稍消退；剛才那幅景象卻仍在腦海裡揮之不去。
                    <</if>>
                    <<case 1>>你生怕踩出聲音，連腳步都放得格外輕。重新聽見攤販的叫賣聲時，你才發現自己一直屏著呼吸。
                    <<case 2>>你尷尬地別開眼睛，悄悄退到貨箱另一側。明明沒有人發現你，你卻總覺得自己才是做了虧心事的那個。
                <</switch>>
            <<case "left_quietly">>
                <<switch _hmEncounter.watchVariant>>
                    <<case 0>><<if random(0,1) is 0>>你小心退離貨箱，沒有碰到任何東西。兩人始終沒有察覺你曾經站在那裡，市場的喧鬧很快吞沒了身後的聲音。<<else>>你決定不打擾他們，沿著來時的路輕輕退開。身後的親暱低語仍未停止，那兩人始終沒有發現有人曾靠近。
                    <</if>>
                    <<case 1>>你收回目光，特地繞開會發出聲響的空箱，悄悄返回攤位之間。身後偶爾還有衣袖擦過紙箱的細響；角落裡的秘密就留在角落裡。
                    <<case 2>>你沒有再多看，放輕腳步退回市場的人群。那兩人仍忙著彼此的私事，遠處的叫賣聲正好掩蓋了你離開的動靜。
                <</switch>>
            <<case "watched">>
                <<switch _hmEncounter.watchVariant>>
                    <<case 0>>你留在貨箱旁的陰影裡，隔著縫隙悄悄觀察。外頭的叫賣聲此起彼落，兩人卻仍擁在一起。有人扶著貨箱邊緣，有人抓住同伴的衣袖；幾聲短促的喘息混著衣料的沙沙聲，偶爾才停下來壓低聲音說幾句話。<br><br>
                    <<case 1>>你在不容易被看見的地方停下，透過箱子間的空隙望去。兩人仍緊緊依偎，不時交換親吻；其中一人試著挪動腳步，鞋底輕擦地面，另一人順手扶住同伴的手臂。低低的喘息和衣料摩擦聲斷斷續續，誰也沒有注意到這裡多了一名旁觀者。<br><br>
                    <<case 2>>你屏住呼吸，躲在貨箱轉角。兩人時而小聲打趣，時而緊緊相擁；衣袖輕輕擦過木箱，發出一聲細小的「喀」響，另一人則低聲提醒小心。兩人屏息聽了片刻，確定外面沒動靜後又靠近彼此；市場的喧鬧替這個角落提供了最好的掩護。<br><br>
                <</switch>>
                <<if setup.HonestMarkets.rollChance(35)>><<switch random(0, 1)>><<case 0>>過了一段時間，貨箱後的聲音終於逐漸平息。兩人相視一笑，稍稍整理儀容，確認通道沒有人注意後，才一前一後離開。<br><br><<case 1>>你看著兩人終於拉開距離，低聲交換幾句話。等他們走出貨堆陰影，你才悄悄從藏身處退開。<br><br><</switch>><</if>>
                <<if $NPCList and $NPCList[0] and $NPCList[1] and $NPCList[0].pronoun is "m" and $NPCList[1].pronoun is "m">>
                    <<switch (_hmEncounter.coupleDynamic + (setup.HonestMarkets.rollChance(20) ? 3 : 0))>>
                        <<case 0>>過了好一會兒，<<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>才終於捨得分開。<<print $NPCList[0].pronouns.he>>站直身子，另一人替他仔細理好衣領。他們又交換一個吻，才開始檢查有沒有遺落東西。
                        <<case 1>>直到角落裡的動靜漸漸平息，<span class="blue"><<print $NPCList[0].fullDescription_CN>></span>才終於堅持要整理儀容，同伴則笑著幫忙。他們低聲爭論誰的頭髮比較亂，最後一同笑了出來。
                        <<case 2>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>終於停下親熱，又為藏身處的選擇互相埋怨了幾句，卻一邊抱怨一邊替彼此整理衣服，誰也沒有真的生氣。
                                            <<case 3>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>交換了一個心照不宣的眼神，其中一人輕拍同伴的肩，兩人便沿著不同方向走回人群。
                    <</switch>><br><br>
                <<elseif $NPCList and $NPCList[0] and $NPCList[1] and $NPCList[0].pronoun is "f" and $NPCList[1].pronoun is "f">>
                    <<switch (_hmEncounter.coupleDynamic + (setup.HonestMarkets.rollChance(20) ? 3 : 0))>>
                        <<case 0>>過了好一陣子，<<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>才終於稍稍分開，細心替彼此理好頭髮與衣襟。她們又依依不捨地擁抱片刻，才準備離開。
                        <<case 1>>等兩人終於停下親熱，先前擔心聲音太大的<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span>再度提醒同伴別笑得那麼響，自己卻也笑個不停。兩人整理好衣服後，仍牽著手不肯鬆開。
                        <<case 2>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>終於捨得分開，一面整理衣襟，一面繼續打趣剛才的事。直到確認彼此的衣著都恢復整齊，她們才終於停止說笑。
                                            <<case 3>><<print $NPCList[0].pronouns.he>>和<span class="blue"><<print $NPCList[1].fullDescription_CN>></span>低聲笑了起來，其中一位替同伴撥開擋住視線的髮絲，隨後一起離開貨堆。
                    <</switch>><br><br>
                <<else>>
                    <<switch (_hmEncounter.coupleDynamic + (setup.HonestMarkets.rollChance(20) ? 3 : 0))>>
                        <<case 0>>等兩人終於停下親熱，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>才把<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>歪掉的衣領整理妥當，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span>也替他拍平皺起的衣服。兩人相視一笑，這才準備回到市場。
                        <<case 1>>直到兩人終於分開，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span>才仔細聽了聽外面的腳步聲，確認附近沒人後，示意<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span></span>整理衣服。兩人彼此檢查儀容，終於放心地點了點頭。
                        <<case 2>>等兩人終於停下親熱，<span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>才把散落的衣物收拾好，<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>則幫他整理歪掉的衣襟。兩人又互相取笑幾句，才終於安靜下來。
                                            <<case 3>><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[0].fullDescription_CN : $NPCList[1].fullDescription_CN)>></span>低聲問了句什麼，<span class="blue"><span class="blue"><<print ($NPCList[0].pronoun === "m" ? $NPCList[1].fullDescription_CN : $NPCList[0].fullDescription_CN)>></span></span>點點頭，兩人確認周圍安全後才回到市場通道。
                    <</switch>><br><br>
                <</if>>
                兩人確認附近沒有人後，一前一後離開貨箱後方。你等他們走遠，才從藏身處出來。
            <<case "startled">>
                <<switch _hmEncounter.startleVariant>>
                    <<case 0>>你故意在貨箱外清了清喉嚨。兩人同時僵住，其中一人慌忙後退，腳下卻被衣物絆了一下，跌坐在地。另一人趕緊扶起同伴；他們匆匆撿好東西，沿另一側的空隙逃進人群。
                    <<case 1>>你突然出聲問了一句「有人在嗎？」貨箱後頓時一陣慌亂。兩人急忙分開，其中一人還差點撞上旁邊的箱子。另一人連忙拉住同伴，兩人胡亂整理好衣服，便從另一側溜走了。
                    <<case 2>>你用鞋尖輕輕碰了一下外側的木箱。裡面立刻傳出一聲驚呼，接著是慌張的低語。兩人以為有人來查貨，連忙拾起自己的東西，連看都不敢往你這邊看，就從另一頭逃開。
                <</switch>><br><br>
                你看著重新安靜下來的角落，忍不住笑出聲；這下也沒什麼好看的了。
            <<case "unfazed">>
                <<switch _hmEncounter.startleVariant>>
                    <<case 0>>你故意清了清喉嚨。兩人終於停下親熱，朝聲音的方向看過來。其中一人竟笑著問：「站在那裡做什麼？想幫我們看風嗎？」你原本想嚇人的念頭頓時落空，只得尷尬地轉身離開。
                    <<case 1>>你突然問了一聲「有人在嗎？」兩人這才暫時分開，卻沒有慌張，其中一人反而從貨箱後探頭，笑著回答：「有啊，你找哪位？」你一時不知道怎麼接話，只好假裝走錯地方，匆匆退開。
                    <<case 2>>你輕輕碰響外側的木箱，想看兩人手忙腳亂。沒想到兩人只是暫時停下，其中一人看向你，笑著說：「箱子可別碰倒了，我們還得借它擋一會兒呢。」你反倒被說得臉上一熱，趕緊離開。
                <</switch>><br><br>
                你走回市場的人群，身後仍隱約傳來兩人的笑聲。
        <</switch>><br><br>
    <</if>>
<</widget>>


:: HonestMarkets Hidden Couple Masturbation []
<<set _hmEncounter to setup.HonestMarkets.getMarketEncounter()>>
<<if _hmEncounter and _hmEncounter.id is "hidden_couple" and _hmEncounter.stage is "masturbating">>
    <<effects>>
    <<if $masturbationstart is 1>>
        <<set $masturbationstart to 0>>
        <<set $masturbationstat += 1>>
        <<masturbationstart>>
    <</if>>
    
    /% 特殊插曲共用八回合冷卻；每回合各有 2% 機率，避免打斷原版戰鬥。 %/
    <<if typeof _hmEncounter.incidentTurn !== "number">><<set _hmEncounter.incidentTurn to 0>><</if>>
    <<if typeof _hmEncounter.incidentCooldown !== "number">><<set _hmEncounter.incidentCooldown to 0>><</if>>
    <<set _hmEncounter.incidentTurn += 1>>
    <<set _hmIncidentType to 0>>
    <<if _hmEncounter.incidentCooldown gt 0>>
        <<set _hmEncounter.incidentCooldown -= 1>>
    <<else>>
        <<set _hmIncidentRoll to setup.HonestMarkets.rollRng()>>
        <<if _hmIncidentRoll gt 98>>
            <<set _hmIncidentType to 1>>
        <<elseif _hmIncidentRoll gt 96>>
            <<set _hmIncidentType to 2>>
        <</if>>
    <</if>>
    <<if _hmIncidentType gt 0>>
        <<set _hmIncidentVariant to random(0, 12)>>
        <<if _hmIncidentType is 1 and _hmIncidentVariant is _hmEncounter.lastPasserIncident>>
            <<set _hmIncidentVariant to (_hmIncidentVariant + random(1, 12)) % 13>>
        <<elseif _hmIncidentType is 2 and _hmIncidentVariant is _hmEncounter.lastNearIncident>>
            <<set _hmIncidentVariant to (_hmIncidentVariant + random(1, 12)) % 13>>
        <</if>>
        <<set _hmEncounter.incidentCooldown to 8>>
        <<if _hmIncidentType is 1>>
            <<set _hmEncounter.lastPasserIncident to _hmIncidentVariant>>
            <<switch _hmIncidentVariant>>
            <<case 0>>一名路人聽見貨箱後的低語，好奇地探頭，隨即臉紅得像熟透的番茄，匆忙轉身。你藏在更深的陰影裡，連對方的目光都沒有碰上。<br><br>
            <<case 1>>有人撥開外側帆布，瞥見兩道緊靠的身影後，立即把布簾放回原位，假裝只是路過。你屏住呼吸，幸好他完全沒有注意到你。<br><br>
            <<case 2>>一名顧客正想繞過貨架，卻忽然停步，咳嗽一聲後改走另一條路。你從縫隙望去，才發現他剛好撞見貨箱後的兩人，卻沒看見你。<br><br>
            <<case 3>>一個搬運工探頭確認箱子是否擋路，卻突然僵住。他把手上的貨單舉到眼前，倒退兩步離開。你藏在另一側，沒有被發現。<br><br>
